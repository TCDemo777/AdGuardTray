<Window x:Class="RouterPilot.Views.BackupRestorePreviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Restore RouterPilot Backup"
        Width="520" SizeToContent="Height" MaxHeight="680"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource Brush.WindowBackground}"
        Foreground="{DynamicResource Brush.TextPrimary}">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <TextBlock Style="{StaticResource Text.PageTitle}" Text="Restore backup" />
        <TextBlock Grid.Row="1" Margin="0,8,0,18" Style="{StaticResource Text.Secondary}" TextWrapping="Wrap"
                   Text="Choose the validated data to restore. RouterPilot creates a pre-restore backup before changing any files." />
        <Border Grid.Row="2" Padding="14" Margin="0,0,0,16" CornerRadius="8"
                Background="{DynamicResource Brush.SurfaceMuted}">
            <StackPanel>
                <TextBlock Text="{Binding BackupVersion, StringFormat=Backup version: {0}}" />
                <TextBlock Margin="0,4,0,0" Style="{StaticResource Text.Secondary}"
                           Text="{Binding CreatedDisplay, StringFormat=Created: {0}}" />
                <TextBlock Margin="0,4,0,0" Style="{StaticResource Text.Secondary}"
                           Text="{Binding BackupFileName, StringFormat=File: {0}}" />
                <TextBlock Margin="0,4,0,0" Style="{StaticResource Text.Secondary}"
                           Text="{Binding FormatVersion, StringFormat=Format: v{0}}" />
                <TextBlock Margin="0,8,0,0" FontSize="12" Foreground="{DynamicResource Brush.Success}"
                           Text="Validated: manifest and included-file hashes match." />
            </StackPanel>
        </Border>
        <StackPanel Grid.Row="3">
            <TextBlock Margin="0,0,0,10" Style="{StaticResource Text.SectionTitle}" Text="Restore items" />
            <ItemsControl ItemsSource="{Binding Items}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <CheckBox Margin="0,0,0,10" IsChecked="{Binding IsSelected}" Content="{Binding DisplayName}" />
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
        <StackPanel Grid.Row="4" Margin="0,18,0,0" HorizontalAlignment="Right" Orientation="Horizontal">
            <Button Width="92" Height="34" Margin="0,0,10,0" IsCancel="True"
                    Style="{DynamicResource Button.Secondary}" Content="Cancel" />
            <Button Width="92" Height="34" IsDefault="True" Click="Restore_Click"
                    Style="{DynamicResource Button.Primary}" Content="Restore" />
        </StackPanel>
    </Grid>
</Window>
