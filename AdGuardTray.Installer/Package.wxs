<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <Package
    Id="TCDemo777.AdGuardTray"
    Name="RouterPilot"
    Manufacturer="Tristan Caldwell"
    Version="1.5.1"
    Scope="perMachine"
    Compressed="yes">

    <MajorUpgrade
      DowngradeErrorMessage="A newer version of RouterPilot is already installed." />

    <MediaTemplate EmbedCab="yes" />

    <Feature Id="Main"
             Title="RouterPilot"
             Level="1">
      <ComponentGroupRef Id="ApplicationComponents" />
    </Feature>
  </Package>
</Wix>
