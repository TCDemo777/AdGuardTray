<Project Sdk="WixToolset.Sdk/7.0.0">
  <PropertyGroup>
<SuppressValidation>true</SuppressValidation>
    <OutputType>Package</OutputType>
    <Platform>x64</Platform>
    <AcceptEula>wix7</AcceptEula>
    <OutputName>AdGuardTray-1.3.0-x64</OutputName>
  </PropertyGroup>

  <ItemGroup>
    <BindPath Include="$(MSBuildThisFileDirectory)..\publish\win-x64"
              BindName="publish" />
  </ItemGroup>
</Project>
