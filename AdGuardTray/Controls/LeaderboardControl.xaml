<UserControl
    x:Class="AdGuardTray.Controls.LeaderboardControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    x:Name="Root"
    MinWidth="300">

    <Border Style="{StaticResource Card}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="16" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock
                        Style="{StaticResource Text.SectionTitle}"
                        Text="{Binding Title, ElementName=Root}" />

                    <TextBlock
                        Margin="0,4,0,0"
                        Style="{StaticResource Text.Muted}"
                        Text="{Binding Subtitle, ElementName=Root}"
                        Visibility="{Binding SubtitleVisibility, ElementName=Root}" />
                </StackPanel>

                <TextBlock
                    Grid.Column="1"
                    Margin="16,2,0,0"
                    VerticalAlignment="Top"
                    Style="{StaticResource Text.Muted}"
                    Text="{Binding HeaderText, ElementName=Root}"
                    Visibility="{Binding HeaderVisibility, ElementName=Root}" />
            </Grid>

            <Grid Grid.Row="2">
                <ItemsControl ItemsSource="{Binding Items, ElementName=Root}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,0,0,15">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="34" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <Border
                                    Grid.Column="0"
                                    Width="28"
                                    Height="28"
                                    VerticalAlignment="Top"
                                    Background="{StaticResource Brush.SurfaceMuted}"
                                    BorderBrush="{StaticResource Brush.Border}"
                                    BorderThickness="1"
                                    CornerRadius="14">
                                    <TextBlock
                                        Style="{StaticResource Leaderboard.Rank}"
                                        Text="{Binding Rank}" />
                                </Border>

                                <Grid Grid.Column="1" Margin="8,0,16,0">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="8" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <TextBlock
                                        Grid.Row="0"
                                        Style="{StaticResource Leaderboard.Label}"
                                        Text="{Binding Label}"
                                        ToolTip="{Binding ToolTip}" />

                                    <ProgressBar
                                        Grid.Row="2"
                                        Style="{StaticResource Leaderboard.Track}"
                                        Foreground="{Binding AccentBrush, ElementName=Root}"
                                        Value="{Binding Percentage}" />
                                </Grid>

                                <TextBlock
                                    Grid.Column="2"
                                    MinWidth="54"
                                    Style="{StaticResource Leaderboard.Value}"
                                    Text="{Binding DisplayValue}" />
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <StackPanel
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Visibility="{Binding EmptyVisibility, ElementName=Root}">
                    <TextBlock
                        HorizontalAlignment="Center"
                        FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                        FontSize="28"
                        Foreground="{StaticResource Brush.TextMuted}"
                        Text="&#xE946;" />
                    <TextBlock
                        Margin="0,10,0,0"
                        HorizontalAlignment="Center"
                        Style="{StaticResource Text.Secondary}"
                        Text="{Binding EmptyText, ElementName=Root}" />
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</UserControl>
