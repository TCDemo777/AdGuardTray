<UserControl
    x:Class="AdGuardTray.Controls.StatisticCard"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    x:Name="Root"
    MinWidth="190"
    MinHeight="132">

    <Border Style="{StaticResource Card}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock
                    Grid.Column="0"
                    Style="{StaticResource Text.CardCaption}"
                    Text="{Binding Title, ElementName=Root}" />

                <Border
                    Grid.Column="1"
                    Width="38"
                    Height="38"
                    Margin="12,0,0,0"
                    Background="{Binding IconBackground, ElementName=Root}"
                    CornerRadius="10"
                    Visibility="{Binding IconVisibility, ElementName=Root}">
                    <TextBlock
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                        FontSize="18"
                        Foreground="{Binding AccentBrush, ElementName=Root}"
                        Text="{Binding IconGlyph, ElementName=Root}" />
                </Border>
            </Grid>

            <StackPanel
                Grid.Row="1"
                Margin="0,14,0,10"
                VerticalAlignment="Center">
                <TextBlock
                    Style="{StaticResource Text.CardValue}"
                    Text="{Binding Value, ElementName=Root}"
                    ToolTip="{Binding Value, ElementName=Root}" />

                <TextBlock
                    Margin="0,5,0,0"
                    Style="{StaticResource Text.Secondary}"
                    Text="{Binding Subtitle, ElementName=Root}"
                    TextTrimming="CharacterEllipsis"
                    Visibility="{Binding SubtitleVisibility, ElementName=Root}" />
            </StackPanel>

            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border
                    Grid.Column="0"
                    Padding="8,3"
                    Background="{Binding BadgeBackground, ElementName=Root}"
                    CornerRadius="10"
                    Visibility="{Binding BadgeVisibility, ElementName=Root}">
                    <TextBlock
                        FontFamily="Segoe UI Variable Text, Segoe UI"
                        FontSize="11"
                        FontWeight="SemiBold"
                        Foreground="{Binding BadgeForeground, ElementName=Root}"
                        Text="{Binding BadgeText, ElementName=Root}" />
                </Border>

                <TextBlock
                    Grid.Column="1"
                    Margin="10,0,0,0"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center"
                    Style="{StaticResource Text.Muted}"
                    Text="{Binding FooterText, ElementName=Root}"
                    TextTrimming="CharacterEllipsis"
                    Visibility="{Binding FooterVisibility, ElementName=Root}" />
            </Grid>
        </Grid>
    </Border>
</UserControl>
