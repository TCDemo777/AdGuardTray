<UserControl x:Class="AdGuardTray.Views.LogsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="14"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="12"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <DockPanel>
            <StackPanel>
                <TextBlock FontSize="24" FontWeight="Bold" Text="Logs"/>
                <TextBlock Margin="0,5,0,0"
                           FontSize="14"
                           Foreground="#667085"
                           Text="Live AdGuard Home query activity and domain intelligence"/>
            </StackPanel>
            <StackPanel DockPanel.Dock="Right" HorizontalAlignment="Right">
                <Border Padding="10,5"
                        HorizontalAlignment="Right"
                        Background="#F6F8FA"
                        CornerRadius="12">
                    <TextBlock FontWeight="SemiBold"
                               Foreground="{Binding LiveStatusColour}"
                               Text="{Binding LiveStatusText}"/>
                </Border>
                <TextBlock Margin="0,5,0,0"
                           HorizontalAlignment="Right"
                           Foreground="#667085"
                           Text="{Binding LastUpdatedText}"/>
                <TextBlock Margin="0,3,0,0"
                           HorizontalAlignment="Right"
                           FontSize="12"
                           Foreground="#667085"
                           Text="{Binding SelectedRefreshInterval,
                                          StringFormat=Automatic check every {0}s}"/>
            </StackPanel>
        </DockPanel>

        <Border Grid.Row="2"
                Padding="14"
                Background="White"
                CornerRadius="10"
                BorderBrush="#DDE3EA"
                BorderThickness="1">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="10"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="100"/>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="105"/>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="110"/>
                    </Grid.ColumnDefinitions>
                    <TextBox Height="36"
                             Padding="10,6"
                             Text="{Binding SearchText,
                                            UpdateSourceTrigger=PropertyChanged}"
                             ToolTip="Search client, domain, or status"/>
                    <Button Grid.Column="2"
                            Height="36"
                            Command="{Binding TogglePauseCommand}"
                            Content="{Binding PauseButtonText}"/>
                    <Button Grid.Column="4"
                            Height="36"
                            Command="{Binding ExportCsvCommand}"
                            Content="Export CSV"/>
                    <Button Grid.Column="6"
                            Height="36"
                            Command="{Binding ExportJsonCommand}"
                            Content="Export JSON"/>
                </Grid>

                <StackPanel Grid.Row="2" Orientation="Horizontal">
                    <CheckBox Margin="0,0,18,0"
                              VerticalAlignment="Center"
                              FontWeight="SemiBold"
                              IsChecked="{Binding ShowBlocked}"
                              Content="Blocked"/>
                    <CheckBox Margin="0,0,24,0"
                              VerticalAlignment="Center"
                              FontWeight="SemiBold"
                              IsChecked="{Binding ShowAllowed}"
                              Content="Allowed"/>
                    <TextBlock Margin="0,0,8,0"
                               VerticalAlignment="Center"
                               Foreground="#667085"
                               Text="Refresh interval"/>
                    <ComboBox Width="80"
                              Height="32"
                              ItemsSource="{Binding RefreshIntervals}"
                              SelectedItem="{Binding SelectedRefreshInterval}"/>
                    <TextBlock Margin="7,0,0,0"
                               VerticalAlignment="Center"
                               Foreground="#667085"
                               Text="seconds"/>
                    <Button Margin="18,0,0,0"
                            MinWidth="100"
                            Height="32"
                            Command="{Binding LoadLogsCommand}"
                            Content="Refresh now"/>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2.15*"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="0.85*"/>
            </Grid.ColumnDefinitions>

            <Border Padding="10"
                    Background="White"
                    CornerRadius="10"
                    BorderBrush="#DDE3EA"
                    BorderThickness="1">
                <DataGrid AutoGenerateColumns="False"
                          CanUserAddRows="False"
                          CanUserDeleteRows="False"
                          CanUserResizeRows="False"
                          IsReadOnly="True"
                          HeadersVisibility="Column"
                          GridLinesVisibility="None"
                          RowHeight="42"
                          AlternatingRowBackground="#F8FAFC"
                          ItemsSource="{Binding Entries}"
                          SelectedItem="{Binding SelectedEntry}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Width="145"
                                            Header="Time"
                                            Binding="{Binding Time}"/>
                        <DataGridTextColumn Width="160"
                                            Header="Client"
                                            Binding="{Binding Client}"/>
                        <DataGridTextColumn Width="*"
                                            Header="Domain"
                                            Binding="{Binding Domain}"/>
                        <DataGridTemplateColumn Width="105"
                                                Header="Result">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Border Padding="9,4"
                                            HorizontalAlignment="Left"
                                            CornerRadius="10">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background"
                                                        Value="#E8F5E9"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsBlocked}"
                                                                 Value="True">
                                                        <Setter Property="Background"
                                                                Value="#FDECEC"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <TextBlock FontWeight="SemiBold"
                                                   Text="{Binding Status}">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground"
                                                            Value="#16803C"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsBlocked}"
                                                                     Value="True">
                                                            <Setter Property="Foreground"
                                                                    Value="#C62828"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Border>

            <Border Grid.Column="2"
                    Padding="16"
                    Background="White"
                    CornerRadius="10"
                    BorderBrush="#DDE3EA"
                    BorderThickness="1">
                <Grid>
                    <Grid.Style>
                        <Style TargetType="Grid">
                            <Setter Property="Visibility" Value="Visible"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding SelectedDomainInsight}"
                                             Value="{x:Null}">
                                    <Setter Property="Visibility"
                                            Value="Collapsed"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Grid.Style>

                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="12"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <StackPanel>
                        <TextBlock FontSize="18"
                                   FontWeight="Bold"
                                   Text="Domain details"/>
                        <TextBlock Margin="0,6,0,0"
                                   FontSize="15"
                                   FontWeight="SemiBold"
                                   TextWrapping="Wrap"
                                   Text="{Binding SelectedDomainInsight.Domain}"/>
                    </StackPanel>

                    <ScrollViewer Grid.Row="2"
                                  VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <UniformGrid Columns="2">
                                <Border Margin="0,0,6,8"
                                        Padding="12"
                                        Background="#F8FAFC"
                                        CornerRadius="8">
                                    <StackPanel>
                                        <TextBlock Foreground="#667085"
                                                   Text="Queries"/>
                                        <TextBlock Margin="0,4,0,0"
                                                   FontSize="18"
                                                   FontWeight="Bold"
                                                   Text="{Binding SelectedDomainInsight.TotalQueries}"/>
                                    </StackPanel>
                                </Border>
                                <Border Margin="6,0,0,8"
                                        Padding="12"
                                        Background="#FDECEC"
                                        CornerRadius="8">
                                    <StackPanel>
                                        <TextBlock Foreground="#667085"
                                                   Text="Blocked"/>
                                        <TextBlock Margin="0,4,0,0"
                                                   FontSize="18"
                                                   FontWeight="Bold"
                                                   Foreground="#C62828"
                                                   Text="{Binding SelectedDomainInsight.BlockedQueries}"/>
                                    </StackPanel>
                                </Border>
                            </UniformGrid>

                            <TextBlock Margin="0,7,0,2"
                                       Foreground="#667085"
                                       Text="Block rate"/>
                            <TextBlock FontWeight="SemiBold"
                                       Text="{Binding SelectedDomainInsight.BlockRate,
                                                      StringFormat={}{0:F1}%}"/>

                            <TextBlock Margin="0,12,0,2"
                                       Foreground="#667085"
                                       Text="Result"/>
                            <TextBlock FontWeight="SemiBold"
                                       Text="{Binding SelectedDomainInsight.ResultSummary}"/>

                            <TextBlock Margin="0,12,0,2"
                                       Foreground="#667085"
                                       Text="First seen"/>
                            <TextBlock FontWeight="SemiBold"
                                       TextWrapping="Wrap"
                                       Text="{Binding SelectedDomainInsight.FirstSeen}"/>

                            <TextBlock Margin="0,12,0,2"
                                       Foreground="#667085"
                                       Text="Last seen"/>
                            <TextBlock FontWeight="SemiBold"
                                       TextWrapping="Wrap"
                                       Text="{Binding SelectedDomainInsight.LastSeen}"/>

                            <TextBlock Margin="0,12,0,2"
                                       Foreground="#667085"
                                       Text="Clients"/>
                            <TextBlock FontWeight="SemiBold"
                                       TextWrapping="Wrap"
                                       Text="{Binding SelectedDomainInsight.ClientSummary}"/>
                        </StackPanel>
                    </ScrollViewer>

                    <Button Grid.Row="3"
                            Margin="0,12,0,0"
                            HorizontalAlignment="Left"
                            Command="{Binding ClearSelectionCommand}"
                            Content="Close details"/>
                </Grid>
            </Border>
        </Grid>

        <TextBlock Grid.Row="5"
                   Margin="2,9,0,0"
                   Foreground="#667085"
                   Text="{Binding StatusMessage}"/>
    </Grid>
</UserControl>
