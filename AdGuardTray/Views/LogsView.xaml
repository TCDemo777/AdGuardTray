<UserControl x:Class="AdGuardTray.Views.LogsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <Style x:Key="LogGridHeader" TargetType="DataGridColumnHeader">
            <Setter Property="Height" Value="38"/>
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="Background" Value="#F8FAFC"/>
            <Setter Property="Foreground" Value="#475467"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="BorderBrush" Value="#E4E7EC"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
        </Style>

        <Style x:Key="LogGridRow" TargetType="DataGridRow">
            <Setter Property="MinHeight" Value="42"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#EEF1F4"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Style.Triggers>
                <Trigger Property="AlternationIndex" Value="1">
                    <Setter Property="Background" Value="#FBFCFD"/>
                </Trigger>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#F2F6FF"/>
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#EAF2FF"/>
                    <Setter Property="Foreground" Value="#101828"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="LogGridCell" TargetType="DataGridCell">
            <Setter Property="Padding" Value="12,7"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="14"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock FontSize="24"
                       FontWeight="Bold"
                       Text="Logs"/>
            <TextBlock Margin="0,5,0,0"
                       FontSize="14"
                       Foreground="#667085"
                       Text="Live AdGuard Home DNS requests, clients and filtering outcomes"/>
        </StackPanel>

        <Border Grid.Row="2"
                Padding="18"
                Background="White"
                BorderBrush="#DDE3EA"
                BorderThickness="1"
                CornerRadius="12">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="12"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="12"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Border Height="38"
                            Padding="11,0"
                            Background="#F8FAFC"
                            BorderBrush="#D0D5DD"
                            BorderThickness="1"
                            CornerRadius="8">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="8"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock VerticalAlignment="Center"
                                       FontSize="15"
                                       Foreground="#667085"
                                       Text="⌕"/>
                            <TextBox Grid.Column="2"
                                     VerticalContentAlignment="Center"
                                     Background="Transparent"
                                     BorderThickness="0"
                                     Text="{Binding SearchText,
                                                    UpdateSourceTrigger=PropertyChanged}"
                                     ToolTip="Search by client, domain or status"/>
                        </Grid>
                    </Border>

                    <Button Grid.Column="2"
                            MinWidth="112"
                            Height="38"
                            Padding="16,5"
                            Command="{Binding TogglePauseCommand}"
                            Content="{Binding PauseButtonText}"/>
                </Grid>

                <Border Grid.Row="2"
                        BorderBrush="#E4E7EC"
                        BorderThickness="1"
                        CornerRadius="9"
                        ClipToBounds="True">
                    <DataGrid AutoGenerateColumns="False"
                              AlternationCount="2"
                              CanUserAddRows="False"
                              CanUserDeleteRows="False"
                              ColumnHeaderStyle="{StaticResource LogGridHeader}"
                              RowStyle="{StaticResource LogGridRow}"
                              CellStyle="{StaticResource LogGridCell}"
                              GridLinesVisibility="None"
                              HeadersVisibility="Column"
                              IsReadOnly="True"
                              ItemsSource="{Binding Entries}"
                              SelectionMode="Single"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                        <DataGrid.Columns>
                            <DataGridTextColumn Width="155"
                                                Binding="{Binding Time}"
                                                Header="TIME"/>
                            <DataGridTextColumn Width="190"
                                                Binding="{Binding Client}"
                                                Header="CLIENT"/>
                            <DataGridTextColumn Width="*"
                                                Binding="{Binding Domain}"
                                                Header="DOMAIN"/>
                            <DataGridTemplateColumn Width="118"
                                                    Header="STATUS">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border Padding="9,4"
                                                HorizontalAlignment="Left"
                                                CornerRadius="10">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background"
                                                            Value="#ECFDF3"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsBlocked}"
                                                                     Value="True">
                                                            <Setter Property="Background"
                                                                    Value="#FDECEC"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <TextBlock FontSize="11"
                                                       FontWeight="SemiBold"
                                                       Text="{Binding Status}">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground"
                                                                Value="#16803C"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsBlocked}"
                                                                         Value="True">
                                                                <Setter Property="Foreground"
                                                                        Value="#C62828"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Border>

                <DockPanel Grid.Row="4">
                    <Border DockPanel.Dock="Right"
                            Padding="9,4"
                            Background="#F2F4F7"
                            CornerRadius="10">
                        <TextBlock FontSize="11"
                                   FontWeight="SemiBold"
                                   Foreground="#475467"
                                   Text="LIVE QUERY LOG"/>
                    </Border>
                    <TextBlock VerticalAlignment="Center"
                               FontSize="13"
                               Foreground="#667085"
                               Text="{Binding StatusMessage}"/>
                </DockPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
