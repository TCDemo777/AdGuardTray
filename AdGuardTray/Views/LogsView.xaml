<UserControl x:Class="AdGuardTray.Views.LogsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="14"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="12"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock FontSize="24" FontWeight="Bold" Text="Logs"/>
            <TextBlock Margin="0,5,0,0" FontSize="14" Foreground="#667085"
                       Text="Live AdGuard Home query activity"/>
        </StackPanel>

        <Border Grid.Row="2" Padding="14" Background="White" CornerRadius="10"
                BorderBrush="#DDE3EA" BorderThickness="1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBox Height="36" Padding="10,6"
                         Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                         ToolTip="Search client, domain, or status"/>
                <Button Grid.Column="1" MinWidth="100" Margin="10,0,0,0"
                        Command="{Binding TogglePauseCommand}" Content="{Binding PauseButtonText}"/>
                <Button Grid.Column="2" MinWidth="105" Margin="10,0,0,0"
                        Command="{Binding ExportCsvCommand}" Content="Export CSV"/>
                <Button Grid.Column="3" MinWidth="110" Margin="10,0,0,0"
                        Command="{Binding ExportJsonCommand}" Content="Export JSON"/>
            </Grid>
        </Border>

        <Border Grid.Row="4" Padding="10" Background="White" CornerRadius="10"
                BorderBrush="#DDE3EA" BorderThickness="1">
            <DataGrid AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False"
                      CanUserResizeRows="False" IsReadOnly="True" HeadersVisibility="Column"
                      GridLinesVisibility="None" RowHeight="42" AlternatingRowBackground="#F8FAFC"
                      ItemsSource="{Binding Entries}" SelectedItem="{Binding SelectedEntry}">
                <DataGrid.Columns>
                    <DataGridTextColumn Width="155" Header="Time" Binding="{Binding Time}"/>
                    <DataGridTextColumn Width="180" Header="Client" Binding="{Binding Client}"/>
                    <DataGridTextColumn Width="*" Header="Domain" Binding="{Binding Domain}"/>
                    <DataGridTemplateColumn Width="110" Header="Result">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Border Padding="9,4" HorizontalAlignment="Left" CornerRadius="10"
                                        Background="#E8F5E9">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="#E8F5E9"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsBlocked}" Value="True">
                                                    <Setter Property="Background" Value="#FDECEC"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <TextBlock FontWeight="SemiBold" Foreground="#16803C"
                                               Text="{Binding Status}">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="#16803C"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsBlocked}" Value="True">
                                                        <Setter Property="Foreground" Value="#C62828"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Border>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <TextBlock Grid.Row="5" Margin="2,9,0,0" Foreground="#667085"
                   Text="{Binding StatusMessage}"/>
    </Grid>
</UserControl>