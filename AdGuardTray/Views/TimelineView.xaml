<UserControl x:Class="AdGuardTray.Views.TimelineView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{DynamicResource Brush.WindowBackground}"
             Foreground="{DynamicResource Brush.TextPrimary}">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="16"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="220"/>
                <ColumnDefinition Width="10"/>
                <ColumnDefinition Width="130"/>
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Style="{DynamicResource Text.PageTitle}" Text="Network Timeline"/>
                <TextBlock Margin="0,5,0,0" Style="{DynamicResource Text.Secondary}"
                           Text="Significant device, router, AdGuard and insight events."/>
            </StackPanel>
            <TextBox Grid.Column="1" Height="38" Padding="10,7"
                     VerticalContentAlignment="Center"
                     Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"/>
            <ComboBox Grid.Column="3" Height="38"
                      ItemsSource="{Binding Filters}"
                      SelectedItem="{Binding SelectedFilter}"/>
        </Grid>

        <Grid Grid.Row="2">
            <ListBox ItemsSource="{Binding Events}"
                     BorderThickness="0"
                     Background="Transparent"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     VirtualizingPanel.IsVirtualizing="True"
                     VirtualizingPanel.VirtualizationMode="Recycling">
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                        <Setter Property="Padding" Value="0"/>
                        <Setter Property="Margin" Value="0,0,0,10"/>
                        <Setter Property="Background" Value="Transparent"/>
                        <Setter Property="BorderThickness" Value="0"/>
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{DynamicResource Card.Compact}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="42"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Border Width="32" Height="32" CornerRadius="16"
                                        Background="{DynamicResource Brush.PrimarySubtle}"
                                        VerticalAlignment="Top">
                                    <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center"
                                               FontWeight="Bold" Foreground="{DynamicResource Brush.Primary}"
                                               Text="{Binding Icon}"/>
                                </Border>
                                <StackPanel Grid.Column="1">
                                    <TextBlock FontSize="15" FontWeight="SemiBold" Text="{Binding Title}"/>
                                    <TextBlock Margin="0,5,0,0" Style="{DynamicResource Text.Body}"
                                               TextWrapping="Wrap" Text="{Binding Description}"/>
                                    <StackPanel Margin="0,8,0,0" Orientation="Horizontal">
                                        <TextBlock Style="{DynamicResource Text.Muted}" Text="{Binding Category}"/>
                                        <TextBlock Margin="8,0" Style="{DynamicResource Text.Muted}" Text="•"/>
                                        <TextBlock Style="{DynamicResource Text.Muted}" Text="{Binding Severity}"/>
                                    </StackPanel>
                                </StackPanel>
                                <TextBlock Grid.Column="2" Margin="18,0,0,0"
                                           Style="{DynamicResource Text.Muted}" Text="{Binding TimeDisplay}"/>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Grid>

        <Grid Grid.Row="3" Margin="0,8,0,0">
            <TextBlock VerticalAlignment="Center" Style="{DynamicResource Text.Muted}"
                       Text="{Binding StatusMessage}"/>
            <Button HorizontalAlignment="Right" MinWidth="120"
                    Style="{DynamicResource Button.Secondary}"
                    Command="{Binding LoadMoreCommand}" Content="Load more"/>
        </Grid>
    </Grid>
</UserControl>
