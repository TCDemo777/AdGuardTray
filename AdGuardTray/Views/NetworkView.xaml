<UserControl x:Class="AdGuardTray.Views.NetworkView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{DynamicResource Brush.WindowBackground}">
    <UserControl.Resources>
        <Style x:Key="Network.Label"
               TargetType="TextBlock">
            <Setter Property="Margin" Value="0,10,0,2"/>
            <Setter Property="FontFamily" Value="Segoe UI Variable Text, Segoe UI"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource Brush.TextMuted}"/>
        </Style>

        <Style x:Key="Network.Value"
               TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe UI Variable Text, Segoe UI"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource Brush.TextPrimary}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
        </Style>

        <Style x:Key="Network.HealthBadge"
               TargetType="Border">
            <Setter Property="Padding" Value="10,4"/>
            <Setter Property="Background" Value="{DynamicResource Brush.SurfaceMuted}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="HorizontalAlignment" Value="Right"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style x:Key="Network.ProgressBar"
               TargetType="ProgressBar">
            <Setter Property="Height" Value="8"/>
            <Setter Property="Minimum" Value="0"/>
            <Setter Property="Maximum" Value="100"/>
            <Setter Property="Background" Value="{DynamicResource Brush.SurfaceMuted}"/>
            <Setter Property="Foreground" Value="{DynamicResource Brush.Primary}"/>
        </Style>

        <Style x:Key="Network.MetricLabel"
               TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="{DynamicResource Brush.TextMuted}"/>
        </Style>
    </UserControl.Resources>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="18"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid>
            <StackPanel>
                <TextBlock Style="{DynamicResource Text.PageTitle}"
                           Text="Network"/>
                <TextBlock Margin="0,5,0,0"
                           Style="{DynamicResource Text.Secondary}"
                           Text="WAN connectivity, DNS configuration, router information and system resources."/>
            </StackPanel>
        </Grid>

        <ScrollViewer Grid.Row="2"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <StackPanel>

                <!-- Top summary -->
                <Grid Margin="0,0,0,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Style="{DynamicResource Card.Compact}">
                        <StackPanel>
                            <TextBlock Style="{DynamicResource Text.CardCaption}"
                                       Text="INTERNET"/>
                            <TextBlock Margin="0,8,0,0"
                                       FontSize="21"
                                       FontWeight="SemiBold"
                                       Foreground="{Binding InternetStatusColour}"
                                       Text="{Binding InternetStatusText}"/>
                            <TextBlock Margin="0,5,0,0"
                                       Style="{DynamicResource Text.Muted}"
                                       Text="{Binding WanIp}"/>
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="2" Style="{DynamicResource Card.Compact}">
                        <StackPanel>
                            <TextBlock Style="{DynamicResource Text.CardCaption}"
                                       Text="LATENCY"/>
                            <TextBlock Margin="0,8,0,0"
                                       FontSize="21"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource Brush.TextPrimary}"
                                       Text="{Binding Latency}"/>
                            <TextBlock Margin="0,5,0,0"
                                       Style="{DynamicResource Text.Muted}"
                                       Text="Gateway response"/>
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="4" Style="{DynamicResource Card.Compact}">
                        <StackPanel>
                            <TextBlock Style="{DynamicResource Text.CardCaption}"
                                       Text="DNS SERVICE"/>
                            <TextBlock Margin="0,8,0,0"
                                       FontSize="21"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource Brush.TextPrimary}"
                                       Text="{Binding AdGuardService}"/>
                            <TextBlock Margin="0,5,0,0"
                                       Style="{DynamicResource Text.Muted}"
                                       Text="{Binding AdGuardVersion}"/>
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="6" Style="{DynamicResource Card.Compact}">
                        <StackPanel>
                            <TextBlock Style="{DynamicResource Text.CardCaption}"
                                       Text="ROUTER"/>
                            <TextBlock Margin="0,8,0,0"
                                       MaxHeight="42"
                                       FontSize="16"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource Brush.TextPrimary}"
                                       TextWrapping="Wrap"
                                       TextTrimming="CharacterEllipsis"
                                       ToolTip="{Binding RouterModel}"
                                       Text="{Binding RouterModel}"/>
                            <TextBlock Margin="0,5,0,0"
                                       Style="{DynamicResource Text.Muted}"
                                       Text="{Binding Hostname}"/>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- Wi-Fi dashboard and maintenance -->
                <Grid Margin="0,0,0,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="1.15*"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Style="{DynamicResource Card}">
                        <StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Style="{DynamicResource Text.SectionTitle}" Text="2.4 GHz Wi-Fi"/>
                                <Border Grid.Column="1" Style="{StaticResource Network.HealthBadge}">
                                    <TextBlock FontSize="11" FontWeight="SemiBold"
                                               Foreground="{DynamicResource Brush.Success}"
                                               Text="{Binding Wifi24Status}"/>
                                </Border>
                            </Grid>
                            <TextBlock Margin="0,14,0,0" Style="{StaticResource Network.Value}" Text="{Binding Wifi24Ssid}"/>
                            <TextBlock Margin="0,7,0,0" Style="{DynamicResource Text.Muted}" Text="{Binding Wifi24Channel}"/>
                            <TextBlock Margin="0,4,0,0" Style="{DynamicResource Text.Muted}" Text="{Binding Wifi24Clients}"/>
                            <Separator Margin="0,12,0,8" Opacity="0.35"/>
                            <TextBlock Style="{DynamicResource Text.Muted}" Text="{Binding Wifi24Security}"/>
                            <TextBlock Margin="0,4,0,0" Style="{DynamicResource Text.Muted}"
                                       TextWrapping="Wrap" Text="{Binding Wifi24Details}"/>
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="2" Style="{DynamicResource Card}">
                        <StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Style="{DynamicResource Text.SectionTitle}" Text="5 GHz Wi-Fi"/>
                                <Border Grid.Column="1" Style="{StaticResource Network.HealthBadge}">
                                    <TextBlock FontSize="11" FontWeight="SemiBold"
                                               Foreground="{DynamicResource Brush.Success}"
                                               Text="{Binding Wifi5Status}"/>
                                </Border>
                            </Grid>
                            <TextBlock Margin="0,14,0,0" Style="{StaticResource Network.Value}" Text="{Binding Wifi5Ssid}"/>
                            <TextBlock Margin="0,7,0,0" Style="{DynamicResource Text.Muted}" Text="{Binding Wifi5Channel}"/>
                            <TextBlock Margin="0,4,0,0" Style="{DynamicResource Text.Muted}" Text="{Binding Wifi5Clients}"/>
                            <Separator Margin="0,12,0,8" Opacity="0.35"/>
                            <TextBlock Style="{DynamicResource Text.Muted}" Text="{Binding Wifi5Security}"/>
                            <TextBlock Margin="0,4,0,0" Style="{DynamicResource Text.Muted}"
                                       TextWrapping="Wrap" Text="{Binding Wifi5Details}"/>
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="4" Style="{DynamicResource Card}">
                        <StackPanel>
                            <TextBlock Style="{DynamicResource Text.SectionTitle}" Text="Quick maintenance"/>
                            <TextBlock Margin="0,5,0,14" Style="{DynamicResource Text.Secondary}"
                                       Text="Safely restart wireless services or reconnect the internet uplink."/>
                            <WrapPanel>
                                <Button MinWidth="132" Margin="0,0,8,8" Padding="16,9"
                                        Click="RestartWifi_Click" Content="Restart Wi-Fi"/>
                                <Button MinWidth="132" Margin="0,0,0,8" Padding="16,9"
                                        Click="ReconnectWan_Click" Content="Reconnect WAN"/>
                            </WrapPanel>
                            <TextBlock x:Name="MaintenanceStatusText" Margin="0,8,0,0"
                                       Style="{DynamicResource Text.Muted}" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- Network information -->
                <Grid Margin="0,0,0,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Style="{DynamicResource Card}">
                        <StackPanel>
                            <TextBlock Style="{DynamicResource Text.SectionTitle}"
                                       Text="Internet"/>
                            <TextBlock Margin="0,5,0,6"
                                       Style="{DynamicResource Text.Secondary}"
                                       Text="WAN connection and upstream gateway."/>

                            <TextBlock Style="{StaticResource Network.Label}"
                                       Text="WAN ADDRESS"/>
                            <TextBlock Style="{StaticResource Network.Value}"
                                       Text="{Binding WanIp}"/>

                            <TextBlock Style="{StaticResource Network.Label}"
                                       Text="GATEWAY"/>
                            <TextBlock Style="{StaticResource Network.Value}"
                                       Text="{Binding Gateway}"/>

                            <TextBlock Style="{StaticResource Network.Label}"
                                       Text="LATENCY"/>
                            <TextBlock Style="{StaticResource Network.Value}"
                                       Text="{Binding Latency}"/>
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="2" Style="{DynamicResource Card}">
                        <StackPanel>
                            <TextBlock Style="{DynamicResource Text.SectionTitle}"
                                       Text="DNS"/>
                            <TextBlock Margin="0,5,0,6"
                                       Style="{DynamicResource Text.Secondary}"
                                       Text="Upstream and advertised resolver details."/>

                            <TextBlock Style="{StaticResource Network.Label}"
                                       Text="EXTERNAL DNS"/>
                            <TextBlock Style="{StaticResource Network.Value}"
                                       Text="{Binding ExternalDns}"/>

                            <TextBlock Style="{StaticResource Network.Label}"
                                       Text="ADVERTISED DNS"/>
                            <TextBlock Style="{StaticResource Network.Value}"
                                       Text="{Binding AdvertisedDns}"/>

                            <TextBlock Style="{StaticResource Network.Label}"
                                       Text="ADGUARD SERVICE"/>
                            <TextBlock Style="{StaticResource Network.Value}"
                                       Text="{Binding AdGuardService}"/>

                            <TextBlock Style="{StaticResource Network.Label}"
                                       Text="VERSION"/>
                            <TextBlock Style="{StaticResource Network.Value}"
                                       Text="{Binding AdGuardVersion}"/>
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="4" Style="{DynamicResource Card}">
                        <StackPanel>
                            <TextBlock Style="{DynamicResource Text.SectionTitle}"
                                       Text="Router"/>
                            <TextBlock Margin="0,5,0,6"
                                       Style="{DynamicResource Text.Secondary}"
                                       Text="Router identity and runtime information."/>

                            <TextBlock Style="{StaticResource Network.Label}"
                                       Text="MODEL"/>
                            <TextBlock Style="{StaticResource Network.Value}"
                                       Text="{Binding RouterModel}"/>

                            <TextBlock Style="{StaticResource Network.Label}"
                                       Text="HOSTNAME"/>
                            <TextBlock Style="{StaticResource Network.Value}"
                                       Text="{Binding Hostname}"/>

                            <TextBlock Style="{StaticResource Network.Label}"
                                       Text="FIRMWARE"/>
                            <TextBlock Style="{StaticResource Network.Value}"
                                       Text="{Binding FirmwareVersion}"/>

                            <TextBlock Style="{StaticResource Network.Label}"
                                       Text="UPTIME"/>
                            <TextBlock Style="{StaticResource Network.Value}"
                                       Text="{Binding Uptime}"/>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- Resource health -->
                <Border Margin="0,0,0,8" Style="{DynamicResource Card}">
                    <StackPanel>
                        <TextBlock Style="{DynamicResource Text.SectionTitle}"
                                   Text="Resource health"/>
                        <TextBlock Margin="0,5,0,18"
                                   Style="{DynamicResource Text.Secondary}"
                                   Text="Current CPU, memory and storage utilisation reported by the router."/>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="18"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="18"/>
                                <ColumnDefinition Width="1.2*"/>
                            </Grid.ColumnDefinitions>

                            <!-- CPU -->
                            <Grid Grid.Column="0">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock VerticalAlignment="Center"
                                               Style="{DynamicResource Text.SectionTitle}"
                                               Text="CPU"/>
                                    <Border Grid.Column="1"
                                            Style="{StaticResource Network.HealthBadge}">
                                        <TextBlock FontSize="11"
                                                   FontWeight="SemiBold"
                                                   Foreground="{Binding CpuHealthColour}"
                                                   Text="{Binding CpuHealthText}"/>
                                    </Border>
                                </Grid>

                                <ProgressBar Grid.Row="1"
                                             Margin="0,13,0,7"
                                             Style="{StaticResource Network.ProgressBar}"
                                             Value="{Binding CpuPercentage}"/>

                                <TextBlock Grid.Row="2"
                                           FontSize="17"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource Brush.TextPrimary}"
                                           Text="{Binding CpuUsage}"/>
                            </Grid>

                            <!-- Memory -->
                            <Grid Grid.Column="2">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock VerticalAlignment="Center"
                                               Style="{DynamicResource Text.SectionTitle}"
                                               Text="Memory"/>
                                    <Border Grid.Column="1"
                                            Style="{StaticResource Network.HealthBadge}">
                                        <TextBlock FontSize="11"
                                                   FontWeight="SemiBold"
                                                   Foreground="{Binding MemoryHealthColour}"
                                                   Text="{Binding MemoryHealthText}"/>
                                    </Border>
                                </Grid>

                                <ProgressBar Grid.Row="1"
                                             Margin="0,13,0,7"
                                             Style="{StaticResource Network.ProgressBar}"
                                             Value="{Binding MemoryPercentage}"/>

                                <TextBlock Grid.Row="2"
                                           FontSize="17"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource Brush.TextPrimary}"
                                           Text="{Binding MemoryUsage}"/>

                                <Grid Grid.Row="3" Margin="0,8,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Style="{StaticResource Network.MetricLabel}"
                                               Text="{Binding MemoryUsed, StringFormat=Used: {0}}"/>
                                    <TextBlock Grid.Column="1"
                                               HorizontalAlignment="Right"
                                               Style="{StaticResource Network.MetricLabel}"
                                               Text="{Binding MemoryCache, StringFormat=Cache: {0}}"/>
                                </Grid>
                            </Grid>

                            <!-- Storage -->
                            <Grid Grid.Column="4">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock VerticalAlignment="Center"
                                               Style="{DynamicResource Text.SectionTitle}"
                                               Text="Storage"/>
                                    <Border Grid.Column="1"
                                            Style="{StaticResource Network.HealthBadge}">
                                        <TextBlock FontSize="11"
                                                   FontWeight="SemiBold"
                                                   Foreground="{Binding StorageHealthColour}"
                                                   Text="{Binding StorageHealthText}"/>
                                    </Border>
                                </Grid>

                                <ProgressBar Grid.Row="1"
                                             Margin="0,13,0,7"
                                             Style="{StaticResource Network.ProgressBar}"
                                             Value="{Binding StoragePercentage}"/>

                                <TextBlock Grid.Row="2"
                                           FontSize="17"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource Brush.TextPrimary}"
                                           Text="{Binding StorageUsage}"/>

                                <Grid Grid.Row="3" Margin="0,8,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Style="{StaticResource Network.MetricLabel}"
                                               Text="{Binding StorageUsed, StringFormat=Used: {0}}"/>
                                    <TextBlock Grid.Column="1"
                                               HorizontalAlignment="Center"
                                               Style="{StaticResource Network.MetricLabel}"
                                               Text="{Binding StorageAvailable, StringFormat=Free: {0}}"/>
                                    <TextBlock Grid.Column="2"
                                               HorizontalAlignment="Right"
                                               Style="{StaticResource Network.MetricLabel}"
                                               Text="{Binding StorageTotal, StringFormat=Total: {0}}"/>
                                </Grid>
                            </Grid>
                        </Grid>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
