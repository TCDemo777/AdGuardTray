<UserControl x:Class="AdGuardTray.Views.NetworkView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Padding" Value="14"/><Setter Property="Background" Value="White"/><Setter Property="CornerRadius" Value="10"/><Setter Property="BorderBrush" Value="#DDE3EA"/><Setter Property="BorderThickness" Value="1"/>
        </Style>
        <Style x:Key="Label" TargetType="TextBlock"><Setter Property="Foreground" Value="#667085"/><Setter Property="FontSize" Value="12"/><Setter Property="Margin" Value="0,7,0,1"/></Style>
        <Style x:Key="Value" TargetType="TextBlock"><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="FontSize" Value="13"/><Setter Property="TextWrapping" Value="Wrap"/><Setter Property="TextTrimming" Value="CharacterEllipsis"/></Style>
        <Style x:Key="HealthBadge" TargetType="Border"><Setter Property="Padding" Value="8,3"/><Setter Property="Background" Value="#F2F4F7"/><Setter Property="CornerRadius" Value="10"/><Setter Property="HorizontalAlignment" Value="Right"/><Setter Property="VerticalAlignment" Value="Center"/></Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="12"/><RowDefinition Height="*"/><RowDefinition Height="12"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <DockPanel>
            <StackPanel><TextBlock FontSize="24" FontWeight="Bold" Text="Network"/><TextBlock Margin="0,4,0,0" FontSize="14" Foreground="#667085" Text="WAN, DNS, router and resource health"/></StackPanel>
            <Border DockPanel.Dock="Right" Padding="10,5" VerticalAlignment="Center" Background="#F6F8FA" CornerRadius="12"><TextBlock FontWeight="SemiBold" Foreground="{Binding InternetStatusColour}" Text="{Binding InternetStatusText}"/></Border>
        </DockPanel>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="10"/><ColumnDefinition Width="*"/><ColumnDefinition Width="10"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <Border Style="{StaticResource Card}"><StackPanel><TextBlock FontSize="17" FontWeight="Bold" Text="Internet"/><TextBlock Style="{StaticResource Label}" Text="WAN address"/><TextBlock Style="{StaticResource Value}" Text="{Binding WanIp}"/><TextBlock Style="{StaticResource Label}" Text="Gateway"/><TextBlock Style="{StaticResource Value}" Text="{Binding Gateway}"/><TextBlock Style="{StaticResource Label}" Text="Latency"/><TextBlock Style="{StaticResource Value}" Text="{Binding Latency}"/></StackPanel></Border>
            <Border Grid.Column="2" Style="{StaticResource Card}"><StackPanel><TextBlock FontSize="17" FontWeight="Bold" Text="DNS"/><TextBlock Style="{StaticResource Label}" Text="External DNS"/><TextBlock Style="{StaticResource Value}" Text="{Binding ExternalDns}"/><TextBlock Style="{StaticResource Label}" Text="Advertised DNS"/><TextBlock Style="{StaticResource Value}" Text="{Binding AdvertisedDns}"/><TextBlock Style="{StaticResource Label}" Text="AdGuard service"/><TextBlock Style="{StaticResource Value}" Text="{Binding AdGuardService}"/><TextBlock Style="{StaticResource Label}" Text="AdGuard version"/><TextBlock Style="{StaticResource Value}" Text="{Binding AdGuardVersion}"/></StackPanel></Border>
            <Border Grid.Column="4" Style="{StaticResource Card}"><StackPanel><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock FontSize="17" FontWeight="Bold" Text="Router"/><Border Grid.Column="1" Style="{StaticResource HealthBadge}"><TextBlock FontSize="11" FontWeight="SemiBold" Foreground="{Binding RouterStatusColour}" Text="{Binding RouterStatusText}"/></Border></Grid><TextBlock Style="{StaticResource Label}" Text="Model"/><TextBlock Style="{StaticResource Value}" Text="{Binding RouterModel}"/><TextBlock Style="{StaticResource Label}" Text="Hostname"/><TextBlock Style="{StaticResource Value}" Text="{Binding Hostname}"/><TextBlock Style="{StaticResource Label}" Text="Firmware"/><TextBlock Style="{StaticResource Value}" Text="{Binding FirmwareVersion}"/><TextBlock Style="{StaticResource Label}" Text="Uptime"/><TextBlock Style="{StaticResource Value}" Text="{Binding Uptime}"/></StackPanel></Border>
        </Grid>

        <Border Grid.Row="4" Style="{StaticResource Card}">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="18"/><ColumnDefinition Width="*"/><ColumnDefinition Width="18"/><ColumnDefinition Width="1.25*"/></Grid.ColumnDefinitions>
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock FontSize="16" FontWeight="Bold" VerticalAlignment="Center" Text="CPU"/><Border Grid.Column="1" Style="{StaticResource HealthBadge}"><TextBlock FontSize="11" FontWeight="SemiBold" Foreground="{Binding CpuHealthColour}" Text="{Binding CpuHealthText}"/></Border></Grid>
                    <ProgressBar Grid.Row="1" Height="10" Margin="0,9,0,5" Minimum="0" Maximum="100" Value="{Binding CpuPercentage}"/>
                    <TextBlock Grid.Row="2" FontSize="15" FontWeight="SemiBold" Text="{Binding CpuUsage}"/>
                </Grid>
                <Grid Grid.Column="2">
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock FontSize="16" FontWeight="Bold" VerticalAlignment="Center" Text="Memory"/><Border Grid.Column="1" Style="{StaticResource HealthBadge}"><TextBlock FontSize="11" FontWeight="SemiBold" Foreground="{Binding MemoryHealthColour}" Text="{Binding MemoryHealthText}"/></Border></Grid>
                    <ProgressBar Grid.Row="1" Height="10" Margin="0,9,0,5" Minimum="0" Maximum="100" Value="{Binding MemoryPercentage}"/>
                    <TextBlock Grid.Row="2" FontSize="15" FontWeight="SemiBold" Text="{Binding MemoryUsage}"/>
                </Grid>
                <Grid Grid.Column="4">
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock FontSize="16" FontWeight="Bold" VerticalAlignment="Center" Text="Storage"/><Border Grid.Column="1" Style="{StaticResource HealthBadge}"><TextBlock FontSize="11" FontWeight="SemiBold" Foreground="{Binding StorageHealthColour}" Text="{Binding StorageHealthText}"/></Border></Grid>
                    <ProgressBar Grid.Row="1" Height="10" Margin="0,9,0,5" Minimum="0" Maximum="100" Value="{Binding StoragePercentage}"/>
                    <TextBlock Grid.Row="2" FontSize="15" FontWeight="SemiBold" Text="{Binding StorageUsage}"/>
                    <Grid Grid.Row="3" Margin="0,7,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock FontSize="12" Foreground="#667085" Text="{Binding StorageUsed, StringFormat=Used: {0}}"/><TextBlock Grid.Column="1" HorizontalAlignment="Center" FontSize="12" Foreground="#667085" Text="{Binding StorageAvailable, StringFormat=Free: {0}}"/><TextBlock Grid.Column="2" HorizontalAlignment="Right" FontSize="12" Foreground="#667085" Text="{Binding StorageTotal, StringFormat=Total: {0}}"/></Grid>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</UserControl>
