<UserControl x:Class="AdGuardTray.Views.NetworkView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Padding" Value="14"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="BorderBrush" Value="#DDE3EA"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>
        <Style x:Key="Label" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#667085"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Margin" Value="0,7,0,1"/>
        </Style>
        <Style x:Key="Value" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="12"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="12"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <DockPanel>
            <StackPanel>
                <TextBlock FontSize="24" FontWeight="Bold" Text="Network"/>
                <TextBlock Margin="0,4,0,0"
                           FontSize="14"
                           Foreground="#667085"
                           Text="WAN, DNS, router and resource health"/>
            </StackPanel>
            <Border DockPanel.Dock="Right"
                    Padding="10,5"
                    VerticalAlignment="Center"
                    Background="#F6F8FA"
                    CornerRadius="12">
                <TextBlock FontWeight="SemiBold"
                           Foreground="{Binding InternetStatusColour}"
                           Text="{Binding InternetStatusText}"/>
            </Border>
        </DockPanel>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="10"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="10"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Style="{StaticResource Card}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBlock FontSize="17" FontWeight="Bold" Text="Internet"/>
                    <Grid Grid.Row="1" Margin="0,5,0,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <StackPanel>
                            <TextBlock Style="{StaticResource Label}" Text="WAN address"/>
                            <TextBlock Style="{StaticResource Value}" Text="{Binding WanIp}"/>
                        </StackPanel>
                        <StackPanel Grid.Row="1">
                            <TextBlock Style="{StaticResource Label}" Text="Gateway"/>
                            <TextBlock Style="{StaticResource Value}" Text="{Binding Gateway}"/>
                        </StackPanel>
                        <StackPanel Grid.Row="2">
                            <TextBlock Style="{StaticResource Label}" Text="Latency"/>
                            <TextBlock Style="{StaticResource Value}" Text="{Binding Latency}"/>
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>

            <Border Grid.Column="2" Style="{StaticResource Card}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBlock FontSize="17" FontWeight="Bold" Text="DNS"/>
                    <UniformGrid Grid.Row="1" Margin="0,5,0,0" Rows="4">
                        <StackPanel>
                            <TextBlock Style="{StaticResource Label}" Text="External DNS"/>
                            <TextBlock Style="{StaticResource Value}" Text="{Binding ExternalDns}"/>
                        </StackPanel>
                        <StackPanel>
                            <TextBlock Style="{StaticResource Label}" Text="Advertised DNS"/>
                            <TextBlock Style="{StaticResource Value}" Text="{Binding AdvertisedDns}"/>
                        </StackPanel>
                        <StackPanel>
                            <TextBlock Style="{StaticResource Label}" Text="AdGuard service"/>
                            <TextBlock Style="{StaticResource Value}" Text="{Binding AdGuardService}"/>
                        </StackPanel>
                        <StackPanel>
                            <TextBlock Style="{StaticResource Label}" Text="AdGuard version"/>
                            <TextBlock Style="{StaticResource Value}" Text="{Binding AdGuardVersion}"/>
                        </StackPanel>
                    </UniformGrid>
                </Grid>
            </Border>

            <Border Grid.Column="4" Style="{StaticResource Card}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <DockPanel>
                        <TextBlock FontSize="17" FontWeight="Bold" Text="Router"/>
                        <TextBlock DockPanel.Dock="Right"
                                   HorizontalAlignment="Right"
                                   FontWeight="SemiBold"
                                   Foreground="{Binding RouterStatusColour}"
                                   Text="{Binding RouterStatusText}"/>
                    </DockPanel>
                    <UniformGrid Grid.Row="1" Margin="0,5,0,0" Rows="4">
                        <StackPanel>
                            <TextBlock Style="{StaticResource Label}" Text="Model"/>
                            <TextBlock Style="{StaticResource Value}" Text="{Binding RouterModel}"/>
                        </StackPanel>
                        <StackPanel>
                            <TextBlock Style="{StaticResource Label}" Text="Hostname"/>
                            <TextBlock Style="{StaticResource Value}" Text="{Binding Hostname}"/>
                        </StackPanel>
                        <StackPanel>
                            <TextBlock Style="{StaticResource Label}" Text="Firmware"/>
                            <TextBlock Style="{StaticResource Value}" Text="{Binding FirmwareVersion}"/>
                        </StackPanel>
                        <StackPanel>
                            <TextBlock Style="{StaticResource Label}" Text="Uptime"/>
                            <TextBlock Style="{StaticResource Value}" Text="{Binding Uptime}"/>
                        </StackPanel>
                    </UniformGrid>
                </Grid>
            </Border>
        </Grid>

        <Border Grid.Row="4" Style="{StaticResource Card}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="18"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="18"/>
                    <ColumnDefinition Width="1.25*"/>
                </Grid.ColumnDefinitions>

                <StackPanel>
                    <DockPanel>
                        <TextBlock FontSize="16" FontWeight="Bold" Text="CPU"/>
                        <TextBlock DockPanel.Dock="Right"
                                   FontWeight="SemiBold"
                                   Foreground="{Binding CpuHealthColour}"
                                   Text="{Binding CpuHealthText}"/>
                    </DockPanel>
                    <ProgressBar Height="12" Margin="0,9,0,5"
                                 Minimum="0" Maximum="100"
                                 Value="{Binding CpuPercentage}"/>
                    <TextBlock FontSize="15"
                               FontWeight="SemiBold"
                               Text="{Binding CpuUsage}"/>
                </StackPanel>

                <StackPanel Grid.Column="2">
                    <DockPanel>
                        <TextBlock FontSize="16" FontWeight="Bold" Text="Memory"/>
                        <TextBlock DockPanel.Dock="Right"
                                   FontWeight="SemiBold"
                                   Foreground="{Binding MemoryHealthColour}"
                                   Text="{Binding MemoryHealthText}"/>
                    </DockPanel>
                    <ProgressBar Height="12" Margin="0,9,0,5"
                                 Minimum="0" Maximum="100"
                                 Value="{Binding MemoryPercentage}"/>
                    <TextBlock FontSize="15"
                               FontWeight="SemiBold"
                               Text="{Binding MemoryUsage}"/>
                </StackPanel>

                <StackPanel Grid.Column="4">
                    <DockPanel>
                        <TextBlock FontSize="16" FontWeight="Bold" Text="Storage"/>
                        <TextBlock DockPanel.Dock="Right"
                                   FontWeight="SemiBold"
                                   Foreground="{Binding StorageHealthColour}"
                                   Text="{Binding StorageHealthText}"/>
                    </DockPanel>
                    <ProgressBar Height="12" Margin="0,9,0,5"
                                 Minimum="0" Maximum="100"
                                 Value="{Binding StoragePercentage}"/>
                    <TextBlock FontSize="15"
                               FontWeight="SemiBold"
                               Text="{Binding StorageUsage}"/>
                    <UniformGrid Margin="0,7,0,0" Columns="3">
                        <TextBlock FontSize="12" Text="{Binding StorageUsed, StringFormat=Used: {0}}"/>
                        <TextBlock FontSize="12" Text="{Binding StorageAvailable, StringFormat=Free: {0}}"/>
                        <TextBlock FontSize="12" Text="{Binding StorageTotal, StringFormat=Total: {0}}"/>
                    </UniformGrid>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
