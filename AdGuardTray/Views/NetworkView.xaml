<UserControl x:Class="AdGuardTray.Views.NetworkView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Margin" Value="6"/>
            <Setter Property="Padding" Value="18"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="BorderBrush" Value="#DDE3EA"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>
        <Style x:Key="Label" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#667085"/>
            <Setter Property="Margin" Value="0,10,0,2"/>
        </Style>
        <Style x:Key="Value" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
    </UserControl.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="14"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock FontSize="24" FontWeight="Bold" Text="Network"/>
            <TextBlock Margin="0,5,0,0" FontSize="14" Foreground="#667085"
                       Text="WAN, gateway, DNS and router health"/>
        </StackPanel>

        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <UniformGrid Columns="3">
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock FontSize="18" FontWeight="Bold" Text="Internet"/>
                            <Border Margin="0,10,0,4" Padding="10,5" HorizontalAlignment="Left"
                                    Background="#F6F8FA" CornerRadius="12">
                                <TextBlock FontWeight="SemiBold" Foreground="{Binding InternetStatusColour}"
                                           Text="{Binding InternetStatusText}"/>
                            </Border>
                            <TextBlock Style="{StaticResource Label}" Text="WAN address"/>
                            <TextBlock Style="{StaticResource Value}" Text="{Binding WanIp}"/>
                            <TextBlock Style="{StaticResource Label}" Text="Gateway"/>
                            <TextBlock Style="{StaticResource Value}" Text="{Binding Gateway}"/>
                            <TextBlock Style="{StaticResource Label}" Text="Latency"/>
                            <TextBlock Style="{StaticResource Value}" Text="{Binding Latency}"/>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock FontSize="18" FontWeight="Bold" Text="DNS"/>
                            <TextBlock Style="{StaticResource Label}" Text="External DNS"/>
                            <TextBlock Style="{StaticResource Value}" Text="{Binding ExternalDns}"/>
                            <TextBlock Style="{StaticResource Label}" Text="Advertised DNS"/>
                            <TextBlock Style="{StaticResource Value}" Text="{Binding AdvertisedDns}"/>
                            <TextBlock Style="{StaticResource Label}" Text="AdGuard service"/>
                            <TextBlock Style="{StaticResource Value}" Text="{Binding AdGuardService}"/>
                            <TextBlock Style="{StaticResource Label}" Text="AdGuard version"/>
                            <TextBlock Style="{StaticResource Value}" Text="{Binding AdGuardVersion}"/>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock FontSize="18" FontWeight="Bold" Text="Router"/>
                            <Border Margin="0,10,0,4" Padding="10,5" HorizontalAlignment="Left"
                                    Background="#F6F8FA" CornerRadius="12">
                                <TextBlock FontWeight="SemiBold" Foreground="{Binding RouterStatusColour}"
                                           Text="{Binding RouterStatusText}"/>
                            </Border>
                            <TextBlock Style="{StaticResource Label}" Text="Model"/>
                            <TextBlock Style="{StaticResource Value}" Text="{Binding RouterModel}"/>
                            <TextBlock Style="{StaticResource Label}" Text="Hostname"/>
                            <TextBlock Style="{StaticResource Value}" Text="{Binding Hostname}"/>
                            <TextBlock Style="{StaticResource Label}" Text="Firmware"/>
                            <TextBlock Style="{StaticResource Value}" Text="{Binding FirmwareVersion}"/>
                            <TextBlock Style="{StaticResource Label}" Text="Uptime"/>
                            <TextBlock Style="{StaticResource Value}" Text="{Binding Uptime}"/>
                        </StackPanel>
                    </Border>
                </UniformGrid>

                <Border Style="{StaticResource Card}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="18"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="18"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <DockPanel>
                                <TextBlock FontSize="17" FontWeight="Bold" Text="CPU"/>
                                <TextBlock DockPanel.Dock="Right"
                                           FontWeight="SemiBold"
                                           Foreground="{Binding CpuHealthColour}"
                                           Text="{Binding CpuHealthText}"/>
                            </DockPanel>
                            <ProgressBar Height="16" Margin="0,12,0,6" Minimum="0" Maximum="100"
                                         Value="{Binding CpuPercentage}"/>
                            <TextBlock FontWeight="SemiBold" Text="{Binding CpuUsage}"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <DockPanel>
                                <TextBlock FontSize="17" FontWeight="Bold" Text="Memory"/>
                                <TextBlock DockPanel.Dock="Right"
                                           FontWeight="SemiBold"
                                           Foreground="{Binding MemoryHealthColour}"
                                           Text="{Binding MemoryHealthText}"/>
                            </DockPanel>
                            <ProgressBar Height="16" Margin="0,12,0,6" Minimum="0" Maximum="100"
                                         Value="{Binding MemoryPercentage}"/>
                            <TextBlock FontWeight="SemiBold" Text="{Binding MemoryUsage}"/>
                        </StackPanel>
                        <StackPanel Grid.Column="4">
                            <DockPanel>
                                <TextBlock FontSize="17" FontWeight="Bold" Text="Storage"/>
                                <TextBlock DockPanel.Dock="Right"
                                           FontWeight="SemiBold"
                                           Foreground="{Binding StorageHealthColour}"
                                           Text="{Binding StorageHealthText}"/>
                            </DockPanel>
                            <ProgressBar Height="16" Margin="0,12,0,6"
                                         Minimum="0" Maximum="100"
                                         Value="{Binding StoragePercentage}"/>
                            <TextBlock FontSize="17" FontWeight="Bold"
                                       Text="{Binding StorageUsage}"/>
                            <UniformGrid Margin="0,9,0,0" Columns="3">
                                <StackPanel>
                                    <TextBlock Foreground="#667085" Text="Used"/>
                                    <TextBlock FontWeight="SemiBold" Text="{Binding StorageUsed}"/>
                                </StackPanel>
                                <StackPanel>
                                    <TextBlock Foreground="#667085" Text="Available"/>
                                    <TextBlock FontWeight="SemiBold" Text="{Binding StorageAvailable}"/>
                                </StackPanel>
                                <StackPanel>
                                    <TextBlock Foreground="#667085" Text="Total"/>
                                    <TextBlock FontWeight="SemiBold" Text="{Binding StorageTotal}"/>
                                </StackPanel>
                            </UniformGrid>
                        </StackPanel>
                    </Grid>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>