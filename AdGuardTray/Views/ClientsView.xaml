<UserControl x:Class="AdGuardTray.Views.ClientsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="15"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="15"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Title -->

        <StackPanel>

            <TextBlock
                FontSize="24"
                FontWeight="Bold"
                Text="Clients"/>

            <TextBlock
                Margin="0,5,0,0"
                FontSize="14"
                Foreground="#666666"
                Text="Connected DNS clients"/>

        </StackPanel>

        <!-- Toolbar -->

        <DockPanel
            Grid.Row="2"
            LastChildFill="False">

            <TextBox
                Width="250"
                Height="32"
                Margin="0,0,10,0"
                VerticalContentAlignment="Center"
                Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" />

            <Button
                Width="100"
                Height="32"
                Content="Refresh"/>

        </DockPanel>

        <!-- Client Grid -->

        <DataGrid
            Grid.Row="4"
            AutoGenerateColumns="False"
            CanUserAddRows="False"
            CanUserDeleteRows="False"
            CanUserResizeRows="False"
            IsReadOnly="True"
            SelectionMode="Single"
            AlternatingRowBackground="#F8F8F8"
            HeadersVisibility="Column"
            GridLinesVisibility="Horizontal"
            ItemsSource="{Binding Clients}"
            SelectedItem="{Binding SelectedClient}">

            <DataGrid.Columns>

                <DataGridTextColumn
                    Header="Name"
                    Width="2*"
                    Binding="{Binding Name}" />

                <DataGridTextColumn
                    Header="IP Address"
                    Width="140"
                    Binding="{Binding IpAddress}" />

                <DataGridTextColumn
                    Header="MAC Address"
                    Width="160"
                    Binding="{Binding MacAddress}" />

                <DataGridTextColumn
                    Header="Queries"
                    Width="100"
                    Binding="{Binding TotalQueries}" />

                <DataGridTextColumn
                    Header="Blocked"
                    Width="100"
                    Binding="{Binding BlockedQueries}" />

                <DataGridTextColumn
                    Header="Block %"
                    Width="90"
                    Binding="{Binding BlockRate, StringFormat={}{0:F1}%}" />

                <DataGridTextColumn
                    Header="Last Seen"
                    Width="140"
                    Binding="{Binding LastSeen}" />

            </DataGrid.Columns>

        </DataGrid>

        <!-- Status -->

        <StatusBar Grid.Row="5">

            <StatusBarItem>

                <TextBlock
                    Text="{Binding StatusMessage}"/>

            </StatusBarItem>

        </StatusBar>

    </Grid>

</UserControl>