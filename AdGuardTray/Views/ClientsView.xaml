<UserControl x:Class="AdGuardTray.Views.ClientsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{DynamicResource Brush.WindowBackground}"
    Foreground="{DynamicResource Brush.TextPrimary}">
    <Grid Background="{DynamicResource Brush.WindowBackground}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="14"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="12"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock FontSize="24" FontWeight="Bold" Text="Clients"/>
            <TextBlock Margin="0,5,0,0" FontSize="14" Foreground="{DynamicResource Brush.TextSecondary}"
                       Text="Connected devices, identity and DNS activity"/>
        </StackPanel>

        <Border Grid.Row="2" Padding="14" Background="{DynamicResource Brush.Surface}" CornerRadius="10"
                BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="170"/>
                    <ColumnDefinition Width="10"/>
                    <ColumnDefinition Width="115"/>
                    <ColumnDefinition Width="14"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="14"/>
                    <ColumnDefinition Width="100"/>
                    <ColumnDefinition Width="10"/>
                    <ColumnDefinition Width="120"/>
                </Grid.ColumnDefinitions>

                <TextBox Height="36"
                         VerticalContentAlignment="Center"
                         Text="{Binding SearchText,
                                        UpdateSourceTrigger=PropertyChanged}"
                         ToolTip="Search name, address, manufacturer, device type or health"/>

                <ComboBox x:Name="SortOptionComboBox"
                          Grid.Column="2"
                          Height="36"
                          VerticalContentAlignment="Center"
                          ItemsSource="{Binding SortOptions}"
                          SelectedItem="{Binding SelectedSortOption,
                                                 Mode=OneWay}"
                          SelectionChanged="SortOptionComboBox_SelectionChanged"/>

                <Button Grid.Column="4"
                        Height="36"
                        Command="{Binding ToggleSortDirectionCommand}"
                        Content="{Binding SortDirectionText}"/>

                <CheckBox Grid.Column="6"
                          VerticalAlignment="Center"
                          FontWeight="SemiBold"
                          IsChecked="{Binding ShowFavoritesOnly}"
                          Content="Favourites only"/>

                <Button Grid.Column="8"
                        Height="36"
                        Command="{Binding LoadClientsCommand}"
                        Content="Refresh"/>

                <Button Grid.Column="10"
                        Height="36"
                        Click="ViewDetailsButton_Click"
                        Content="View Details"/>
            </Grid>
        </Border>

        <Border Grid.Row="4" Padding="10" Background="{DynamicResource Brush.SurfaceMuted}" CornerRadius="10"
                BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1">
            <ListBox x:Name="ClientsGrid"
                     ItemsSource="{Binding Clients}"
                     SelectedItem="{Binding SelectedClient}"
                     BorderThickness="0"
                     Background="Transparent"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     ScrollViewer.VerticalScrollBarVisibility="Auto"
                     MouseDoubleClick="ClientsGrid_MouseDoubleClick">
                <ListBox.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Columns="3"/>
                    </ItemsPanelTemplate>
                </ListBox.ItemsPanel>

                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Margin" Value="6"/>
                        <Setter Property="Padding" Value="0"/>
                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                        <Setter Property="VerticalContentAlignment" Value="Stretch"/>
                    </Style>
                </ListBox.ItemContainerStyle>

                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Border MinHeight="205"
                                Padding="15"
                                Background="{DynamicResource Brush.Surface}"
                                CornerRadius="10"
                                BorderBrush="{DynamicResource Brush.Border}"
                                BorderThickness="1">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="9"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="10"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="12"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="44"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <Border Width="38"
                                            Height="38"
                                            Background="{DynamicResource Brush.PrimarySubtle}"
                                            CornerRadius="19">
                                        <TextBlock HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"
                                                   FontFamily="Segoe UI Emoji"
                                                   FontSize="18"
                                                   Text="{Binding DeviceIcon}"/>
                                    </Border>

                                    <StackPanel Grid.Column="1">
                                        <TextBlock FontSize="16"
                                                   FontWeight="Bold"
                                                   TextTrimming="CharacterEllipsis"
                                                   Text="{Binding Name}"/>
                                        <TextBlock Margin="0,3,0,0"
                                                   Foreground="{DynamicResource Brush.TextSecondary}"
                                                   Text="{Binding IpAddress}"/>
                                    </StackPanel>

                                    <Button Grid.Column="2"
                                            Width="34"
                                            Height="32"
                                            Padding="0"
                                            FontSize="19"
                                            Foreground="{DynamicResource Brush.Warning}"
                                            ToolTip="{Binding FavoriteToolTip}"
                                            Tag="{Binding}"
                                            Click="FavoriteButton_Click"
                                            Content="{Binding FavoriteGlyph}"/>
                                </Grid>

                                <Grid Grid.Row="2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock FontWeight="SemiBold"
                                                   TextTrimming="CharacterEllipsis"
                                                   Text="{Binding DeviceType}"/>
                                        <TextBlock Margin="0,3,0,0"
                                                   Foreground="{DynamicResource Brush.TextSecondary}"
                                                   TextTrimming="CharacterEllipsis"
                                                   Text="{Binding Manufacturer}"/>
                                    </StackPanel>

                                    <Border Grid.Column="1"
                                            Margin="8,0,0,0"
                                            Padding="9,4"
                                            VerticalAlignment="Top"
                                            Background="{DynamicResource Brush.SurfaceMuted}"
                                            CornerRadius="10">
                                        <TextBlock FontWeight="SemiBold"
                                                   Foreground="{Binding HealthColour}"
                                                   Text="{Binding HealthText}"/>
                                    </Border>
                                </Grid>

                                <StackPanel Grid.Row="4">
                                    <TextBlock Foreground="{DynamicResource Brush.TextSecondary}"
                                               TextTrimming="CharacterEllipsis"
                                               Text="{Binding MacAddress}"/>
                                    <TextBlock Margin="0,4,0,0"
                                               Foreground="{DynamicResource Brush.TextSecondary}"
                                               TextTrimming="CharacterEllipsis"
                                               ToolTip="{Binding ActivityAvailabilityToolTip}"
                                               Text="{Binding LastSeenDisplay,
                                                              StringFormat=Last seen: {0}}"/>
                                </StackPanel>

                                <Grid Grid.Row="6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <StackPanel>
                                        <TextBlock FontSize="17"
                                                   FontWeight="Bold"
                                                   Text="{Binding TotalQueries}"/>
                                        <TextBlock FontSize="11"
                                                   Foreground="{DynamicResource Brush.TextSecondary}"
                                                   Text="Queries"/>
                                    </StackPanel>

                                    <StackPanel Grid.Column="1">
                                        <TextBlock FontSize="17"
                                                   FontWeight="Bold"
                                                   Foreground="{DynamicResource Brush.Danger}"
                                                   ToolTip="{Binding ActivityAvailabilityToolTip}"
                                                   Text="{Binding BlockedQueriesDisplay}"/>
                                        <TextBlock FontSize="11"
                                                   Foreground="{DynamicResource Brush.TextSecondary}"
                                                   Text="Blocked"/>
                                    </StackPanel>

                                    <StackPanel Grid.Column="2">
                                        <TextBlock FontSize="17"
                                                   FontWeight="Bold"
                                                   ToolTip="{Binding ActivityAvailabilityToolTip}"
                                                   Text="{Binding BlockRateDisplay}"/>
                                        <TextBlock FontSize="11"
                                                   Foreground="{DynamicResource Brush.TextSecondary}"
                                                   Text="Block rate"/>
                                    </StackPanel>
                                </Grid>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Border>

        <TextBlock Grid.Row="5"
                   Margin="2,9,0,0"
                   Foreground="{DynamicResource Brush.TextSecondary}"
                   Text="{Binding StatusMessage}"/>
    </Grid>
</UserControl>
