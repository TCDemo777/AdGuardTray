<UserControl x:Class="AdGuardTray.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="20"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Page heading -->

        <StackPanel Grid.Row="0">

            <TextBlock
                FontSize="24"
                FontWeight="Bold"
                Text="Settings"/>

            <TextBlock
                Margin="0,5,0,0"
                FontSize="14"
                Foreground="#666666"
                Text="Application, router and AdGuard Home configuration"/>

        </StackPanel>

        <!-- Placeholder content -->

        <Border
            Grid.Row="2"
            Padding="30"
            Background="White"
            BorderBrush="#DDDDDD"
            BorderThickness="1"
            CornerRadius="10">

            <StackPanel
                HorizontalAlignment="Center"
                VerticalAlignment="Center">

                <TextBlock
                    HorizontalAlignment="Center"
                    FontSize="22"
                    FontWeight="SemiBold"
                    Text="Settings"/>

                <TextBlock
                    Margin="0,10,0,0"
                    HorizontalAlignment="Center"
                    FontSize="15"
                    Foreground="Gray"
                    TextAlignment="Center"
                    Text="Application and router configuration options will appear here."/>

            </StackPanel>

        </Border>

    </Grid>

</UserControl>