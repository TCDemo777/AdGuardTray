<UserControl x:Class="AdGuardTray.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="20"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="15"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <TextBlock FontSize="24"
                       FontWeight="Bold"
                       Text="Settings"/>

            <TextBlock Margin="0,5,0,0"
                       FontSize="14"
                       Foreground="#666666"
                       Text="Application, router and AdGuard Home configuration"/>
        </StackPanel>

        <Border Grid.Row="2"
                Background="White"
                BorderBrush="#DDDDDD"
                BorderThickness="1"
                CornerRadius="10">
            <TabControl Margin="12">
                <TabItem Header="App Settings">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="22"
                                    MaxWidth="650"
                                    HorizontalAlignment="Left">
                            <TextBlock FontSize="18"
                                       FontWeight="SemiBold"
                                       Text="Application"/>

                            <TextBlock Margin="0,6,0,20"
                                       Foreground="#666666"
                                       Text="Control startup and dashboard refresh behaviour."/>

                            <CheckBox Margin="0,0,0,18"
                                      Content="Start AdGuardTray with Windows"
                                      IsChecked="{Binding StartWithWindows}"/>

                            <TextBlock FontWeight="SemiBold"
                                       Text="Dashboard refresh interval"/>

                            <StackPanel Margin="0,8,0,0"
                                        Orientation="Horizontal">
                                <TextBox Width="120"
                                         Height="32"
                                         VerticalContentAlignment="Center"
                                         Text="{Binding RefreshIntervalSeconds,
                                                        UpdateSourceTrigger=PropertyChanged}"/>

                                <TextBlock Margin="10,0,0,0"
                                           VerticalAlignment="Center"
                                           Foreground="#666666"
                                           Text="seconds (5–3,600)"/>
                            </StackPanel>

                            <Border Margin="0,24,0,0"
                                    Padding="14"
                                    Background="#F5F7F9"
                                    CornerRadius="8">
                                <TextBlock Foreground="#555555"
                                           TextWrapping="Wrap"
                                           Text="The startup preference is saved here. Windows startup registration will be connected when the tray startup feature is implemented."/>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <TabItem Header="Router Settings">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="22"
                                    MaxWidth="650"
                                    HorizontalAlignment="Left">
                            <TextBlock FontSize="18"
                                       FontWeight="SemiBold"
                                       Text="Router connection"/>

                            <TextBlock Margin="0,6,0,20"
                                       Foreground="#666666"
                                       Text="SSH credentials used to connect to the GL.iNet router."/>

                            <TextBlock FontWeight="SemiBold"
                                       Text="Router IP address or hostname"/>

                            <TextBox Height="34"
                                     Margin="0,8,0,18"
                                     VerticalContentAlignment="Center"
                                     Text="{Binding RouterIp,
                                                    UpdateSourceTrigger=PropertyChanged}"/>

                            <TextBlock FontWeight="SemiBold"
                                       Text="SSH username"/>

                            <TextBox Height="34"
                                     Margin="0,8,0,18"
                                     VerticalContentAlignment="Center"
                                     Text="{Binding Username,
                                                    UpdateSourceTrigger=PropertyChanged}"/>

                            <TextBlock FontWeight="SemiBold"
                                       Text="SSH password"/>

                            <Grid Margin="0,8,0,10">
                                <PasswordBox x:Name="PasswordInput"
                                             Height="36"
                                             VerticalContentAlignment="Center"
                                             PasswordChanged="PasswordInput_PasswordChanged"/>
                                <TextBox x:Name="PasswordTextInput"
                                         Height="36"
                                         Visibility="Collapsed"
                                         VerticalContentAlignment="Center"
                                         Text="{Binding Password, UpdateSourceTrigger=PropertyChanged}"/>
                            </Grid>

                            <CheckBox x:Name="ShowPasswordCheckBox"
                                      Margin="0,0,0,10"
                                      Content="Show password"
                                      Checked="ShowPasswordCheckBox_Changed"
                                      Unchecked="ShowPasswordCheckBox_Changed"/>

                            <CheckBox Content="Remember password securely for this Windows user"
                                      IsChecked="{Binding RememberPassword}"/>

                            <Border Margin="0,24,0,0"
                                    Padding="14"
                                    Background="#F5F7F9"
                                    CornerRadius="8">
                                <TextBlock Foreground="#555555"
                                           TextWrapping="Wrap"
                                           Text="Saved passwords are protected with Windows Data Protection and can only be decrypted by the current Windows user."/>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <TabItem Header="AdGuard Settings">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="22"
                                    MaxWidth="650"
                                    HorizontalAlignment="Left">
                            <TextBlock FontSize="18"
                                       FontWeight="SemiBold"
                                       Text="AdGuard Home"/>

                            <TextBlock Margin="0,6,0,20"
                                       Foreground="#666666"
                                       TextWrapping="Wrap"
                                       Text="AdGuardTray currently reaches AdGuard Home through the configured router connection."/>

                            <TextBlock FontWeight="SemiBold"
                                       Text="Default protection pause"/>

                            <StackPanel Margin="0,8,0,0"
                                        Orientation="Horizontal">
                                <TextBox Width="120"
                                         Height="32"
                                         VerticalContentAlignment="Center"
                                         Text="{Binding DefaultPauseMinutes,
                                                        UpdateSourceTrigger=PropertyChanged}"/>

                                <TextBlock Margin="10,0,0,0"
                                           VerticalAlignment="Center"
                                           Foreground="#666666"
                                           Text="minutes (1–1,440)"/>
                            </StackPanel>

                            <Border Margin="0,24,0,0"
                                    Padding="14"
                                    Background="#F5F7F9"
                                    CornerRadius="8">
                                <StackPanel>
                                    <TextBlock FontWeight="SemiBold"
                                               Text="Coming next"/>

                                    <TextBlock Margin="0,6,0,0"
                                               Foreground="#555555"
                                               TextWrapping="Wrap"
                                               Text="Protection controls, blocked services, DNS rules, live logs and dashboard refresh all use the settings stored here."/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>
            </TabControl>
        </Border>

        <Grid Grid.Row="4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0"
                       VerticalAlignment="Center"
                       Foreground="#666666"
                       Text="{Binding StatusMessage}"/>

            <StackPanel Grid.Column="1"
                        Orientation="Horizontal">
                <Button Width="100"
                        Height="34"
                        Margin="0,0,10,0"
                        Command="{Binding ReloadCommand}"
                        Content="Reload"/>

                <Button Width="120"
                        Height="34"
                        Command="{Binding SaveCommand}"
                        Content="Save Settings"/>
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
