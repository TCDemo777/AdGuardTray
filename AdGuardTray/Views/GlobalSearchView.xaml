<UserControl x:Class="AdGuardTray.Views.GlobalSearchView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="14"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="12"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock FontSize="24"
                       FontWeight="Bold"
                       Text="Global Search"/>
            <TextBlock Margin="0,5,0,0"
                       FontSize="14"
                       Foreground="#667085"
                       Text="Search clients and recent DNS activity from one place"/>
        </StackPanel>

        <Border Grid.Row="2"
                Padding="14"
                Background="White"
                CornerRadius="10"
                BorderBrush="#DDE3EA"
                BorderThickness="1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="130"/>
                </Grid.ColumnDefinitions>
                <TextBox Height="38"
                         VerticalContentAlignment="Center"
                         Text="{Binding SearchText,
                                        UpdateSourceTrigger=PropertyChanged}"
                         ToolTip="Search by client, IP, MAC address or domain"/>
                <Button Grid.Column="2"
                        Height="38"
                        Command="{Binding RefreshIndexCommand}"
                        Content="Refresh index"/>
            </Grid>
        </Border>

        <Border Grid.Row="4"
                Padding="10"
                Background="#F8FAFC"
                CornerRadius="10"
                BorderBrush="#DDE3EA"
                BorderThickness="1">
            <ListBox ItemsSource="{Binding Results}"
                     BorderThickness="0"
                     Background="Transparent"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Margin" Value="4"/>
                        <Setter Property="Padding" Value="0"/>
                        <Setter Property="HorizontalContentAlignment"
                                Value="Stretch"/>
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Border Padding="14"
                                Background="White"
                                CornerRadius="9"
                                BorderBrush="#DDE3EA"
                                BorderThickness="1">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel>
                                    <TextBlock FontSize="16"
                                               FontWeight="Bold"
                                               TextWrapping="Wrap"
                                               Text="{Binding Title}"/>
                                    <TextBlock Margin="0,4,0,0"
                                               Foreground="#667085"
                                               TextWrapping="Wrap"
                                               Text="{Binding Subtitle}"/>
                                    <TextBlock Margin="0,5,0,0"
                                               Foreground="#667085"
                                               TextWrapping="Wrap"
                                               Text="{Binding Detail}"/>
                                </StackPanel>

                                <Border Grid.Column="1"
                                        Margin="12,0,0,0"
                                        Padding="10,5"
                                        VerticalAlignment="Top"
                                        Background="#F6F8FA"
                                        CornerRadius="11">
                                    <TextBlock FontWeight="SemiBold"
                                               Foreground="{Binding BadgeColour}"
                                               Text="{Binding BadgeText}"/>
                                </Border>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Border>

        <TextBlock Grid.Row="5"
                   Margin="2,9,0,0"
                   Foreground="#667085"
                   Text="{Binding StatusMessage}"/>
    </Grid>
</UserControl>
