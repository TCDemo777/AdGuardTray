<Window x:Class="AdGuardTray.Views.ClientDetailsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Client Details"
        Width="1100"
        Height="760"
        MinWidth="900"
        MinHeight="620"
        Background="#F6F8FA"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="14"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="14"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <DockPanel>
            <StackPanel>
                <TextBlock FontSize="25" FontWeight="Bold"
                           Text="{Binding ClientName}"/>
                <TextBlock Margin="0,5,0,0" Foreground="#667085"
                           Text="Live DNS activity and client statistics"/>
            </StackPanel>
            <StackPanel DockPanel.Dock="Right"
                        Orientation="Horizontal"
                        HorizontalAlignment="Right">
                <Button MinWidth="100" Height="36" Margin="0,0,10,0"
                        Command="{Binding RefreshCommand}"
                        Content="Refresh"/>
                <Button MinWidth="100" Height="36"
                        Command="{Binding TogglePauseCommand}"
                        Content="{Binding PauseButtonText}"/>
            </StackPanel>
        </DockPanel>

        <UniformGrid Grid.Row="2" Columns="6">
            <Border Margin="0,0,8,0" Padding="14" Background="White"
                    BorderBrush="#DDE3EA" BorderThickness="1" CornerRadius="10">
                <StackPanel>
                    <TextBlock Foreground="#667085" Text="IP Address"/>
                    <TextBlock Margin="0,6,0,0" FontSize="16" FontWeight="SemiBold"
                               TextTrimming="CharacterEllipsis"
                               Text="{Binding IpAddress}"/>
                </StackPanel>
            </Border>
            <Border Margin="0,0,8,0" Padding="14" Background="White"
                    BorderBrush="#DDE3EA" BorderThickness="1" CornerRadius="10">
                <StackPanel>
                    <TextBlock Foreground="#667085" Text="MAC Address"/>
                    <TextBlock Margin="0,6,0,0" FontSize="16" FontWeight="SemiBold"
                               TextTrimming="CharacterEllipsis"
                               Text="{Binding MacAddress}"/>
                </StackPanel>
            </Border>
            <Border Margin="0,0,8,0" Padding="14" Background="White"
                    BorderBrush="#DDE3EA" BorderThickness="1" CornerRadius="10">
                <StackPanel>
                    <TextBlock Foreground="#667085" Text="Queries"/>
                    <TextBlock Margin="0,6,0,0" FontSize="20" FontWeight="Bold"
                               Text="{Binding TotalQueries}"/>
                </StackPanel>
            </Border>
            <Border Margin="0,0,8,0" Padding="14" Background="White"
                    BorderBrush="#DDE3EA" BorderThickness="1" CornerRadius="10">
                <StackPanel>
                    <TextBlock Foreground="#667085" Text="Blocked"/>
                    <TextBlock Margin="0,6,0,0" FontSize="20" FontWeight="Bold"
                               Foreground="#C62828"
                               Text="{Binding BlockedQueries}"/>
                </StackPanel>
            </Border>
            <Border Margin="0,0,8,0" Padding="14" Background="White"
                    BorderBrush="#DDE3EA" BorderThickness="1" CornerRadius="10">
                <StackPanel>
                    <TextBlock Foreground="#667085" Text="Block Rate"/>
                    <TextBlock Margin="0,6,0,0" FontSize="20" FontWeight="Bold"
                               Text="{Binding BlockRate, StringFormat={}{0:F1}%}"/>
                </StackPanel>
            </Border>
            <Border Padding="14" Background="White"
                    BorderBrush="#DDE3EA" BorderThickness="1" CornerRadius="10">
                <StackPanel>
                    <TextBlock Foreground="#667085" Text="Last Seen"/>
                    <TextBlock Margin="0,6,0,0" FontSize="16" FontWeight="SemiBold"
                               TextTrimming="CharacterEllipsis"
                               Text="{Binding LastSeen}"/>
                </StackPanel>
            </Border>
        </UniformGrid>

        <Grid Grid.Row="4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*"/>
                <ColumnDefinition Width="14"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Padding="10" Background="White"
                    BorderBrush="#DDE3EA" BorderThickness="1" CornerRadius="10">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="8"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBlock FontSize="17" FontWeight="Bold"
                               Text="Recent DNS Requests"/>
                    <DataGrid Grid.Row="2"
                              AutoGenerateColumns="False"
                              CanUserAddRows="False"
                              CanUserDeleteRows="False"
                              CanUserResizeRows="False"
                              IsReadOnly="True"
                              HeadersVisibility="Column"
                              GridLinesVisibility="None"
                              RowHeight="42"
                              AlternatingRowBackground="#F8FAFC"
                              ItemsSource="{Binding RecentQueries}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Width="155" Header="Time"
                                                Binding="{Binding Time}"/>
                            <DataGridTextColumn Width="*" Header="Domain"
                                                Binding="{Binding Domain}"/>
                            <DataGridTemplateColumn Width="105" Header="Result">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border Padding="9,4"
                                                HorizontalAlignment="Left"
                                                CornerRadius="10">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background" Value="#E8F5E9"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsBlocked}" Value="True">
                                                            <Setter Property="Background" Value="#FDECEC"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <TextBlock FontWeight="SemiBold"
                                                       Text="{Binding Status}">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="#16803C"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsBlocked}" Value="True">
                                                                <Setter Property="Foreground" Value="#C62828"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>

            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="14"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Border Padding="10" Background="White"
                        BorderBrush="#DDE3EA" BorderThickness="1" CornerRadius="10">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="8"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <TextBlock FontSize="17" FontWeight="Bold"
                                   Text="Top Requested Domains"/>
                        <DataGrid Grid.Row="2"
                                  AutoGenerateColumns="False"
                                  CanUserAddRows="False"
                                  CanUserDeleteRows="False"
                                  IsReadOnly="True"
                                  GridLinesVisibility="None"
                                  RowHeight="36"
                                  AlternatingRowBackground="#F8FAFC"
                                  ItemsSource="{Binding TopDomains}">
                            <DataGrid.Columns>
                                <DataGridTextColumn Width="*" Header="Domain"
                                                    Binding="{Binding Domain}"/>
                                <DataGridTextColumn Width="70" Header="Count"
                                                    Binding="{Binding Count}"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </Border>

                <Border Grid.Row="2" Padding="10" Background="White"
                        BorderBrush="#DDE3EA" BorderThickness="1" CornerRadius="10">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="8"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <TextBlock FontSize="17" FontWeight="Bold"
                                   Text="Top Blocked Domains"/>
                        <DataGrid Grid.Row="2"
                                  AutoGenerateColumns="False"
                                  CanUserAddRows="False"
                                  CanUserDeleteRows="False"
                                  IsReadOnly="True"
                                  GridLinesVisibility="None"
                                  RowHeight="36"
                                  AlternatingRowBackground="#F8FAFC"
                                  ItemsSource="{Binding TopBlockedDomains}">
                            <DataGrid.Columns>
                                <DataGridTextColumn Width="*" Header="Domain"
                                                    Binding="{Binding Domain}"/>
                                <DataGridTextColumn Width="70" Header="Count"
                                                    Binding="{Binding Count}"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </Border>
            </Grid>
        </Grid>

        <TextBlock Grid.Row="5" Margin="2,10,0,0"
                   Foreground="#667085"
                   Text="{Binding StatusMessage}"/>
    </Grid>
</Window>