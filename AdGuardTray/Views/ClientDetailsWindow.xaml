<Window x:Class="AdGuardTray.Views.ClientDetailsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Client Details"
        Width="1050"
        Height="720"
        MinWidth="850"
        MinHeight="600"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="15"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="15"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="12"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0">
            <StackPanel DockPanel.Dock="Left">
                <TextBlock FontSize="24"
                           FontWeight="Bold"
                           Text="{Binding ClientName}"/>
                <TextBlock Margin="0,5,0,0"
                           Foreground="#666666"
                           Text="Live DNS activity and client statistics"/>
            </StackPanel>

            <StackPanel DockPanel.Dock="Right"
                        Orientation="Horizontal"
                        HorizontalAlignment="Right">
                <Button Width="100"
                        Height="32"
                        Margin="0,0,10,0"
                        Command="{Binding RefreshCommand}"
                        Content="Refresh"/>
                <Button Width="100"
                        Height="32"
                        Command="{Binding TogglePauseCommand}"
                        Content="{Binding PauseButtonText}"/>
            </StackPanel>
        </DockPanel>

        <UniformGrid Grid.Row="2" Columns="6">
            <Border Margin="0,0,8,0" Padding="12" BorderBrush="#DDDDDD" BorderThickness="1" CornerRadius="8">
                <StackPanel>
                    <TextBlock Foreground="#666666" Text="IP Address"/>
                    <TextBlock Margin="0,5,0,0" FontWeight="SemiBold" Text="{Binding IpAddress}"/>
                </StackPanel>
            </Border>
            <Border Margin="0,0,8,0" Padding="12" BorderBrush="#DDDDDD" BorderThickness="1" CornerRadius="8">
                <StackPanel>
                    <TextBlock Foreground="#666666" Text="MAC Address"/>
                    <TextBlock Margin="0,5,0,0" FontWeight="SemiBold" Text="{Binding MacAddress}"/>
                </StackPanel>
            </Border>
            <Border Margin="0,0,8,0" Padding="12" BorderBrush="#DDDDDD" BorderThickness="1" CornerRadius="8">
                <StackPanel>
                    <TextBlock Foreground="#666666" Text="Queries"/>
                    <TextBlock Margin="0,5,0,0" FontWeight="SemiBold" Text="{Binding TotalQueries}"/>
                </StackPanel>
            </Border>
            <Border Margin="0,0,8,0" Padding="12" BorderBrush="#DDDDDD" BorderThickness="1" CornerRadius="8">
                <StackPanel>
                    <TextBlock Foreground="#666666" Text="Blocked"/>
                    <TextBlock Margin="0,5,0,0" FontWeight="SemiBold" Text="{Binding BlockedQueries}"/>
                </StackPanel>
            </Border>
            <Border Margin="0,0,8,0" Padding="12" BorderBrush="#DDDDDD" BorderThickness="1" CornerRadius="8">
                <StackPanel>
                    <TextBlock Foreground="#666666" Text="Block Rate"/>
                    <TextBlock Margin="0,5,0,0" FontWeight="SemiBold"
                               Text="{Binding BlockRate, StringFormat={}{0:F1}%}"/>
                </StackPanel>
            </Border>
            <Border Padding="12" BorderBrush="#DDDDDD" BorderThickness="1" CornerRadius="8">
                <StackPanel>
                    <TextBlock Foreground="#666666" Text="Last Seen"/>
                    <TextBlock Margin="0,5,0,0" FontWeight="SemiBold" Text="{Binding LastSeen}"/>
                </StackPanel>
            </Border>
        </UniformGrid>

        <Grid Grid.Row="4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*"/>
                <ColumnDefinition Width="15"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <GroupBox Grid.Column="0" Header="Recent DNS Requests">
                <DataGrid Margin="8"
                          AutoGenerateColumns="False"
                          CanUserAddRows="False"
                          CanUserDeleteRows="False"
                          IsReadOnly="True"
                          ItemsSource="{Binding RecentQueries}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Width="155" Header="Time" Binding="{Binding Time}"/>
                        <DataGridTextColumn Width="*" Header="Domain" Binding="{Binding Domain}"/>
                        <DataGridTemplateColumn Width="90" Header="Status">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock FontWeight="SemiBold" Text="{Binding Status}">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="Green"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsBlocked}" Value="True">
                                                        <Setter Property="Foreground" Value="Red"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </GroupBox>

            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="15"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <GroupBox Header="Top Requested Domains">
                    <DataGrid Margin="8"
                              AutoGenerateColumns="False"
                              CanUserAddRows="False"
                              CanUserDeleteRows="False"
                              IsReadOnly="True"
                              ItemsSource="{Binding TopDomains}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Width="*" Header="Domain" Binding="{Binding Domain}"/>
                            <DataGridTextColumn Width="70" Header="Count" Binding="{Binding Count}"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </GroupBox>

                <GroupBox Grid.Row="2" Header="Top Blocked Domains">
                    <DataGrid Margin="8"
                              AutoGenerateColumns="False"
                              CanUserAddRows="False"
                              CanUserDeleteRows="False"
                              IsReadOnly="True"
                              ItemsSource="{Binding TopBlockedDomains}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Width="*" Header="Domain" Binding="{Binding Domain}"/>
                            <DataGridTextColumn Width="70" Header="Count" Binding="{Binding Count}"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </GroupBox>
            </Grid>
        </Grid>

        <TextBlock Grid.Row="6"
                   Foreground="#666666"
                   Text="{Binding StatusMessage}"/>
    </Grid>
</Window>
