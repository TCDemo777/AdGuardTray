<UserControl x:Class="AdGuardTray.Views.ProtectionView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="16"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <TextBlock FontSize="24"
                       FontWeight="Bold"
                       Text="Protection"/>

            <TextBlock Margin="0,5,0,0"
                       FontSize="14"
                       Foreground="#666666"
                       Text="Manage AdGuard Home filtering and temporary protection pauses"/>
        </StackPanel>

        <ScrollViewer Grid.Row="2"
                      VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <Border Margin="6"
                        Padding="22"
                        Background="White"
                        CornerRadius="10"
                        BorderBrush="#DDDDDD"
                        BorderThickness="1">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="300"/>
                            <ColumnDefinition Width="30"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock FontSize="18"
                                       FontWeight="Bold"
                                       Text="Current status"/>
                            <Separator Margin="0,8"/>
                            <TextBlock FontSize="17"
                                       FontWeight="SemiBold"
                                       Text="{Binding AdGuardProtectionStatusText}"/>
                            <TextBlock Margin="0,10,0,0"
                                       Foreground="#555555"
                                       TextWrapping="Wrap"
                                       Text="{Binding AdGuardProtectionDetail}"/>
                            <TextBlock Margin="0,8,0,0"
                                       FontWeight="SemiBold"
                                       Text="{Binding AdGuardProtectionRemaining}"/>
                            <TextBlock Margin="0,16,0,0"
                                       Foreground="#555555"
                                       TextWrapping="Wrap"
                                       Text="{Binding AdGuardProtectionMessage}"/>
                        </StackPanel>

                        <StackPanel Grid.Column="2">
                            <TextBlock FontSize="18"
                                       FontWeight="Bold"
                                       Text="Protection controls"/>
                            <Separator Margin="0,8"/>

                            <TextBlock Margin="0,4,0,0"
                                       Foreground="#555555"
                                       TextWrapping="Wrap"
                                       Text="Enable protection immediately, disable it indefinitely, or pause it for a fixed period."/>

                            <StackPanel Margin="0,18,0,0"
                                        Orientation="Horizontal">
                                <Button Width="135"
                                        Height="38"
                                        Margin="0,0,10,0"
                                        Content="Enable protection"
                                        IsEnabled="{Binding ProtectionControlsEnabled}"
                                        Click="EnableProtection_Click"/>

                                <Button Width="135"
                                        Height="38"
                                        Content="Disable protection"
                                        IsEnabled="{Binding ProtectionControlsEnabled}"
                                        Click="DisableProtection_Click"/>
                            </StackPanel>

                            <TextBlock Margin="0,24,0,0"
                                       FontWeight="SemiBold"
                                       Text="Quick pause"/>

                            <WrapPanel Margin="0,10,0,0">
                                <Button Width="115"
                                        Height="38"
                                        Margin="0,0,10,10"
                                        Content="30 minutes"
                                        Tag="30"
                                        IsEnabled="{Binding ProtectionControlsEnabled}"
                                        Click="PauseProtection_Click"/>
                                <Button Width="115"
                                        Height="38"
                                        Margin="0,0,10,10"
                                        Content="1 hour"
                                        Tag="60"
                                        IsEnabled="{Binding ProtectionControlsEnabled}"
                                        Click="PauseProtection_Click"/>
                                <Button Width="115"
                                        Height="38"
                                        Margin="0,0,10,10"
                                        Content="4 hours"
                                        Tag="240"
                                        IsEnabled="{Binding ProtectionControlsEnabled}"
                                        Click="PauseProtection_Click"/>
                                <Button Width="135"
                                        Height="38"
                                        Margin="0,0,10,10"
                                        Content="Until tomorrow"
                                        IsEnabled="{Binding ProtectionControlsEnabled}"
                                        Click="PauseUntilTomorrow_Click"/>
                            </WrapPanel>

                            <StackPanel Margin="0,10,0,0"
                                        Orientation="Horizontal">
                                <Button Width="135"
                                        Height="38"
                                        Margin="0,0,10,0"
                                        Content="Resume now"
                                        IsEnabled="{Binding ProtectionControlsEnabled}"
                                        Click="ResumeProtection_Click"/>
                                <Button Width="110"
                                        Height="38"
                                        Content="Refresh status"
                                        IsEnabled="{Binding ProtectionControlsEnabled}"
                                        Click="RefreshProtection_Click"/>
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                </Border>

                <Border Margin="6,14,6,6"
                        Padding="18"
                        Background="#F8FAFC"
                        CornerRadius="10"
                        BorderBrush="#D7DDE5"
                        BorderThickness="1">
                    <StackPanel>
                        <TextBlock FontSize="16"
                                   FontWeight="SemiBold"
                                   Text="More protection settings are coming next"/>
                        <TextBlock Margin="0,7,0,0"
                                   Foreground="#555555"
                                   TextWrapping="Wrap"
                                   Text="This page is now the permanent home for filtering options, Safe Browsing, parental controls, Safe Search and blocked services."/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
