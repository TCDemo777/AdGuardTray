<UserControl x:Class="AdGuardTray.Views.ProtectionView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{DynamicResource Brush.WindowBackground}">
    <UserControl.Resources>
        <Style x:Key="Protection.ActionButton"
               TargetType="Button"
               BasedOn="{StaticResource Button.Secondary}">
            <Setter Property="MinWidth" Value="104"/>
            <Setter Property="Margin" Value="0,0,8,8"/>
            <Setter Property="Padding" Value="14,8"/>
        </Style>

        <Style x:Key="Protection.DangerButton"
               TargetType="Button"
               BasedOn="{StaticResource Button.Secondary}">
            <Setter Property="MinWidth" Value="104"/>
            <Setter Property="Margin" Value="0,0,8,8"/>
            <Setter Property="Padding" Value="14,8"/>
            <Setter Property="Foreground" Value="{DynamicResource Brush.Danger}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Brush.Danger}"/>
        </Style>

        <Style x:Key="Protection.SectionLabel"
               TargetType="TextBlock"
               BasedOn="{StaticResource Text.CardCaption}">
            <Setter Property="Margin" Value="0,0,0,6"/>
        </Style>

        <Style x:Key="Protection.Option"
               TargetType="CheckBox">
            <Setter Property="Margin" Value="0,0,0,10"/>
            <Setter Property="Padding" Value="0,2"/>
            <Setter Property="FontFamily" Value="Segoe UI Variable Text, Segoe UI"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource Brush.TextPrimary}"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <Style x:Key="Protection.Input"
               TargetType="TextBox">
            <Setter Property="Height" Value="36"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="Background" Value="{DynamicResource Brush.Surface}"/>
            <Setter Property="Foreground" Value="{DynamicResource Brush.TextPrimary}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Brush.BorderStrong}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CaretBrush" Value="{DynamicResource Brush.TextPrimary}"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <Style x:Key="Protection.ComboBox"
               TargetType="ComboBox">
            <Setter Property="Height" Value="36"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="Background" Value="{DynamicResource Brush.Surface}"/>
            <Setter Property="Foreground" Value="{DynamicResource Brush.TextPrimary}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Brush.BorderStrong}"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>

        <Style x:Key="Protection.List"
               TargetType="ListBox">
            <Setter Property="Background" Value="{DynamicResource Brush.SurfaceMuted}"/>
            <Setter Property="Foreground" Value="{DynamicResource Brush.TextPrimary}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="4"/>
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
            <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto"/>
        </Style>

        <Style x:Key="Schedule.CompactButton"
               TargetType="Button"
               BasedOn="{StaticResource Button.Secondary}">
            <Setter Property="MinWidth" Value="0"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Margin" Value="6,0,0,0"/>
            <Setter Property="Padding" Value="10,4"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>

        <Style x:Key="Schedule.FieldLabel"
               TargetType="TextBlock"
               BasedOn="{StaticResource Text.CardCaption}">
            <Setter Property="Margin" Value="0,0,0,6"/>
        </Style>

        <Style x:Key="Schedule.Badge" TargetType="Border" BasedOn="{StaticResource Badge}"/>
    </UserControl.Resources>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="18"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Page header -->
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel>
                <TextBlock Style="{DynamicResource Text.PageTitle}"
                           Text="Protection"/>
                <TextBlock Margin="0,5,0,0"
                           Style="{DynamicResource Text.Secondary}"
                           Text="Manage AdGuard Home protection, filtering profiles, services and DNS rules."/>
            </StackPanel>

            <Button Grid.Column="1"
                    MinWidth="112"
                    Height="38"
                    Style="{DynamicResource Button.Secondary}"
                    Content="Refresh all"
                    Command="{Binding RefreshAllCommand}"/>
        </Grid>

        <ScrollViewer Grid.Row="2"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <StackPanel>

                <!-- Summary cards -->
                <Grid Margin="0,0,0,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Style="{DynamicResource Card.Compact}">
                        <StackPanel>
                            <TextBlock Style="{DynamicResource Text.CardCaption}"
                                       Text="PROTECTION"/>
                            <TextBlock Margin="0,8,0,0"
                                       FontSize="22"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource Brush.TextPrimary}"
                                       Text="{Binding StatusText}"/>
                            <TextBlock Margin="0,5,0,0"
                                       Style="{DynamicResource Text.Muted}"
                                       TextTrimming="CharacterEllipsis"
                                       Text="{Binding Remaining}"/>
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="2" Style="{DynamicResource Card.Compact}">
                        <StackPanel>
                            <TextBlock Style="{DynamicResource Text.CardCaption}"
                                       Text="DNS FILTERING"/>
                            <CheckBox Margin="0,12,0,0"
                                      Style="{StaticResource Protection.Option}"
                                      Content="Filtering enabled"
                                      IsEnabled="{Binding ControlsEnabled}"
                                      IsChecked="{Binding FilteringEnabled, Mode=TwoWay}"/>
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="4" Style="{DynamicResource Card.Compact}">
                        <StackPanel>
                            <TextBlock Style="{DynamicResource Text.CardCaption}"
                                       Text="SAFE BROWSING"/>
                            <CheckBox Margin="0,12,0,0"
                                      Style="{StaticResource Protection.Option}"
                                      Content="Protection enabled"
                                      IsEnabled="{Binding ControlsEnabled}"
                                      IsChecked="{Binding SafeBrowsingEnabled, Mode=TwoWay}"/>
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="6" Style="{DynamicResource Card.Compact}">
                        <StackPanel>
                            <TextBlock Style="{DynamicResource Text.CardCaption}"
                                       Text="CURRENT PROFILE"/>
                            <TextBlock Margin="0,8,0,0"
                                       FontSize="22"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource Brush.TextPrimary}"
                                       Text="{Binding ProfileName}"/>
                            <TextBlock Margin="0,5,0,0"
                                       Style="{DynamicResource Text.Muted}"
                                       Text="Protection preset"/>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- Live AdGuard statistics -->
                <Grid Margin="0,0,0,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="1.35*"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Style="{DynamicResource Card.Compact}">
                        <StackPanel>
                            <TextBlock Style="{DynamicResource Text.CardCaption}" Text="DNS QUERIES"/>
                            <TextBlock Margin="0,8,0,0" FontSize="22" FontWeight="SemiBold"
                                       Foreground="{DynamicResource Brush.TextPrimary}"
                                       Text="{Binding TotalQueriesText}"/>
                            <TextBlock Margin="0,5,0,0" Style="{DynamicResource Text.Muted}"
                                       Text="Current AdGuard statistics window"/>
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="2" Style="{DynamicResource Card.Compact}">
                        <StackPanel>
                            <TextBlock Style="{DynamicResource Text.CardCaption}" Text="BLOCKED QUERIES"/>
                            <TextBlock Margin="0,8,0,0" FontSize="22" FontWeight="SemiBold"
                                       Foreground="{DynamicResource Brush.TextPrimary}"
                                       Text="{Binding BlockedQueriesText}"/>
                            <TextBlock Margin="0,5,0,0" Style="{DynamicResource Text.Muted}"
                                       Text="Ads, trackers and threats blocked"/>
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="4" Style="{DynamicResource Card.Compact}">
                        <StackPanel>
                            <TextBlock Style="{DynamicResource Text.CardCaption}" Text="BLOCK RATE"/>
                            <TextBlock Margin="0,8,0,0" FontSize="22" FontWeight="SemiBold"
                                       Foreground="{DynamicResource Brush.TextPrimary}"
                                       Text="{Binding BlockPercentageText}"/>
                            <TextBlock Margin="0,5,0,0" Style="{DynamicResource Text.Muted}"
                                       Text="Percentage of queries blocked"/>
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="6" Style="{DynamicResource Card.Compact}">
                        <StackPanel>
                            <TextBlock Style="{DynamicResource Text.CardCaption}" Text="TOP BLOCKED DOMAIN"/>
                            <TextBlock Margin="0,8,0,0" FontSize="17" FontWeight="SemiBold"
                                       Foreground="{DynamicResource Brush.TextPrimary}"
                                       TextTrimming="CharacterEllipsis"
                                       ToolTip="{Binding TopBlockedDomain}"
                                       Text="{Binding TopBlockedDomain}"/>
                            <TextBlock Margin="0,5,0,0" Style="{DynamicResource Text.Muted}"
                                       Text="Most frequently blocked domain"/>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- Status and options -->
                <Grid Margin="0,0,0,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.15*"/>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Style="{DynamicResource Card}">
                        <StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Style="{DynamicResource Text.SectionTitle}"
                                               Text="Protection status"/>
                                    <TextBlock Margin="0,5,0,0"
                                               Style="{DynamicResource Text.Secondary}"
                                               Text="{Binding StatusDetail}"/>
                                </StackPanel>
                                <Border Grid.Column="1"
                                        Margin="16,0,0,0"
                                        Padding="12,6"
                                        VerticalAlignment="Top"
                                        Background="{DynamicResource Brush.SurfaceMuted}"
                                        BorderBrush="{DynamicResource Brush.Border}"
                                        BorderThickness="1"
                                        CornerRadius="8">
                                    <TextBlock FontWeight="SemiBold"
                                               Foreground="{DynamicResource Brush.TextPrimary}"
                                               Text="{Binding StatusText}"/>
                                </Border>
                            </Grid>

                            <Border Margin="0,18,0,16"
                                    Height="1"
                                    Background="{DynamicResource Brush.Border}"/>

                            <TextBlock Style="{StaticResource Protection.SectionLabel}"
                                       Text="PROTECTION ACTIONS"/>
                            <WrapPanel IsEnabled="{Binding ControlsEnabled}">
                                <Button Style="{DynamicResource Button.Primary}"
                                        MinWidth="104"
                                        Margin="0,0,8,8"
                                        Content="Enable"
                                        Command="{Binding EnableProtectionCommand}"/>
                                <Button Style="{StaticResource Protection.ActionButton}"
                                        Content="Resume"
                                        Command="{Binding ResumeProtectionCommand}"/>
                                <Button Style="{StaticResource Protection.DangerButton}"
                                        Content="Disable"
                                        Command="{Binding DisableProtectionCommand}"/>
                            </WrapPanel>

                            <TextBlock Margin="0,10,0,6"
                                       Style="{StaticResource Protection.SectionLabel}"
                                       Text="PAUSE PRESETS"/>
                            <WrapPanel>
                                <Button Style="{StaticResource Protection.ActionButton}"
                                        Content="30 minutes"
                                        Command="{Binding Pause30Command}"/>
                                <Button Style="{StaticResource Protection.ActionButton}"
                                        Content="1 hour"
                                        Command="{Binding Pause1HourCommand}"/>
                                <Button Style="{StaticResource Protection.ActionButton}"
                                        Content="4 hours"
                                        Command="{Binding Pause4HoursCommand}"/>
                                <Button Style="{StaticResource Protection.ActionButton}"
                                        Content="Until tomorrow"
                                        Command="{Binding PauseUntilTomorrowCommand}"/>
                            </WrapPanel>
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="2" Style="{DynamicResource Card}">
                        <StackPanel>
                            <TextBlock Style="{DynamicResource Text.SectionTitle}"
                                       Text="Protection options"/>
                            <TextBlock Margin="0,5,0,16"
                                       Style="{DynamicResource Text.Secondary}"
                                       Text="Changes are applied immediately to AdGuard Home."/>

                            <CheckBox Style="{StaticResource Protection.Option}"
                                      Content="DNS filtering"
                                      IsEnabled="{Binding ControlsEnabled}"
                                      IsChecked="{Binding FilteringEnabled, Mode=TwoWay}"/>
                            <CheckBox Style="{StaticResource Protection.Option}"
                                      Content="Safe Browsing"
                                      IsEnabled="{Binding ControlsEnabled}"
                                      IsChecked="{Binding SafeBrowsingEnabled, Mode=TwoWay}"/>
                            <CheckBox Style="{StaticResource Protection.Option}"
                                      Content="Safe Search"
                                      IsEnabled="{Binding ControlsEnabled}"
                                      IsChecked="{Binding SafeSearchEnabled, Mode=TwoWay}"/>
                            <CheckBox Style="{StaticResource Protection.Option}"
                                      Content="Parental Control"
                                      IsEnabled="{Binding ControlsEnabled}"
                                      IsChecked="{Binding ParentalEnabled, Mode=TwoWay}"/>
                            <CheckBox Style="{StaticResource Protection.Option}"
                                      Content="Query logging"
                                      IsEnabled="{Binding ControlsEnabled}"
                                      IsChecked="{Binding QueryLogEnabled, Mode=TwoWay}"/>

                            <Border Margin="0,8,0,16"
                                    Height="1"
                                    Background="{DynamicResource Brush.Border}"/>

                            <TextBlock Style="{StaticResource Protection.SectionLabel}"
                                       Text="QUICK PROFILES"/>
                            <UniformGrid Columns="3" Margin="0,0,0,8">
                                <Button Style="{StaticResource Protection.ActionButton}"
                                        Margin="0,0,8,0"
                                        Content="Standard"
                                        Command="{Binding ApplyStandardProfileCommand}"/>
                                <Button Style="{StaticResource Protection.ActionButton}"
                                        Margin="0,0,8,0"
                                        Content="Family"
                                        Command="{Binding ApplyFamilyProfileCommand}"/>
                                <Button Style="{StaticResource Protection.ActionButton}"
                                        Content="Privacy"
                                        Margin="0,0,0,0"
                                        Command="{Binding ApplyPrivacyProfileCommand}"/>
                            </UniformGrid>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- Blocked services -->
                <Border Margin="0,0,0,16" Style="{DynamicResource Card}">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Style="{DynamicResource Text.SectionTitle}"
                                           Text="Blocked services"/>
                                <TextBlock Margin="0,5,0,0"
                                           Style="{DynamicResource Text.Secondary}"
                                           Text="Choose online services to block across the network."/>
                            </StackPanel>
                            <TextBlock Grid.Column="1"
                                       Margin="16,2,0,0"
                                       VerticalAlignment="Top"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource Brush.TextSecondary}"
                                       Text="{Binding BlockedServicesSelectionSummary}"/>
                        </Grid>

                        <Grid Margin="0,18,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="190"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <TextBox Style="{StaticResource Protection.Input}"
                                     Text="{Binding BlockedServicesSearch, UpdateSourceTrigger=PropertyChanged}"
                                     ToolTip="Search services by name, ID or category"/>

                            <ComboBox Grid.Column="2"
                                      Style="{StaticResource Protection.ComboBox}"
                                      ItemsSource="{Binding BlockedServiceCategories}"
                                      SelectedItem="{Binding SelectedBlockedServiceCategory, Mode=TwoWay}"
                                      ToolTip="Filter services by category"/>

                            <CheckBox Grid.Column="3"
                                      Margin="16,0,0,0"
                                      VerticalAlignment="Center"
                                      Style="{StaticResource Protection.Option}"
                                      Content="Blocked only"
                                      IsChecked="{Binding ShowBlockedOnly}"/>
                        </Grid>

                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock VerticalAlignment="Center"
                                       Style="{DynamicResource Text.Secondary}"
                                       Text="{Binding BlockedServicesStatus}"/>

                            <WrapPanel Grid.Column="1" Margin="16,0,0,0">
                                <Button Style="{StaticResource Protection.ActionButton}"
                                        MinWidth="88"
                                        Content="Select all"
                                        Command="{Binding SelectAllServicesCommand}"/>
                                <Button Style="{StaticResource Protection.ActionButton}"
                                        MinWidth="88"
                                        Content="Clear all"
                                        Command="{Binding ClearAllServicesCommand}"/>
                                <Button Style="{DynamicResource Button.Primary}"
                                        MinWidth="120"
                                        Margin="0,0,0,8"
                                        Content="Save changes"
                                        Command="{Binding SaveBlockedServicesCommand}"/>
                            </WrapPanel>
                        </Grid>

                        <Border Height="390"
                                Padding="5"
                                Background="{DynamicResource Brush.SurfaceMuted}"
                                BorderBrush="{DynamicResource Brush.Border}"
                                BorderThickness="1"
                                CornerRadius="10">
                            <ScrollViewer HorizontalScrollBarVisibility="Disabled"
                                          VerticalScrollBarVisibility="Auto"
                                          CanContentScroll="False"
                                          PanningMode="VerticalOnly">
                                <ListBox HorizontalAlignment="Stretch"
                                         ItemsSource="{Binding BlockedServicesView}"
                                         Padding="0"
                                         BorderThickness="0"
                                         Background="Transparent"
                                         HorizontalContentAlignment="Stretch"
                                         ScrollViewer.CanContentScroll="False"
                                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                         ScrollViewer.VerticalScrollBarVisibility="Disabled"
                                         VirtualizingPanel.IsVirtualizing="False">
                                    <ListBox.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <UniformGrid Columns="3"/>
                                        </ItemsPanelTemplate>
                                    </ListBox.ItemsPanel>

                                    <ListBox.ItemContainerStyle>
                                        <Style TargetType="ListBoxItem">
                                            <Setter Property="Height" Value="46"/>
                                            <Setter Property="Padding" Value="0"/>
                                            <Setter Property="Margin" Value="0"/>
                                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                            <Setter Property="VerticalContentAlignment" Value="Stretch"/>
                                            <Setter Property="Focusable" Value="False"/>
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="ListBoxItem">
                                                        <ContentPresenter/>
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                        </Style>
                                    </ListBox.ItemContainerStyle>

                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Border Height="40"
                                                    Margin="3"
                                                    Padding="10,6"
                                                    Background="{DynamicResource Brush.Surface}"
                                                    BorderBrush="{DynamicResource Brush.Border}"
                                                    BorderThickness="1"
                                                    CornerRadius="8">
                                                <CheckBox VerticalAlignment="Center"
                                                          HorizontalAlignment="Stretch"
                                                          HorizontalContentAlignment="Left"
                                                          FontWeight="SemiBold"
                                                          Foreground="{DynamicResource Brush.TextPrimary}"
                                                          Content="{Binding Name}"
                                                          ToolTip="{Binding Name}"
                                                          IsChecked="{Binding IsBlocked, Mode=TwoWay}"
                                                          IsEnabled="{Binding DataContext.ControlsEnabled, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
                                            </Border>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </ScrollViewer>
                        </Border>
                    </StackPanel>
                </Border>

                <!-- AdGuard service schedules -->
                <Border Margin="0,0,0,16" Style="{DynamicResource Card}" DataContext="{Binding Schedules}">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Style="{DynamicResource Text.SectionTitle}" Text="Schedules"/>
                                <TextBlock Margin="0,5,0,0" Style="{DynamicResource Text.Secondary}"
                                           Text="Allow or block AdGuard services automatically at selected local times."/>
                            </StackPanel>
                            <Button Grid.Column="1" MinWidth="132" Height="36" Margin="12,0,0,0"
                                    Style="{DynamicResource Button.Primary}" Content="Add schedule"
                                    Command="{Binding NewScheduleCommand}" Click="AddSchedule_Click"/>
                            <Button Grid.Column="2" MinWidth="196" Height="36" Margin="8,0,0,0"
                                    Style="{DynamicResource Button.Secondary}" Content="Create allowed-time window"
                                    Click="OpenAllowedWindow_Click"/>
                        </Grid>

                        <Border Margin="0,14,0,0" Padding="10,8"
                                Background="{DynamicResource Brush.SurfaceMuted}"
                                BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1" CornerRadius="8">
                            <TextBlock Style="{DynamicResource Text.Muted}"
                                       Text="RouterPilot must be running in the notification area for schedules to run."/>
                        </Border>

                        <ItemsControl Margin="0,14,0,0" ItemsSource="{Binding Schedules}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Margin="0,0,0,10" Padding="14" Background="{DynamicResource Brush.SurfaceMuted}"
                                            BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1" CornerRadius="10">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>

                                            <TextBlock VerticalAlignment="Center" FontSize="15" FontWeight="SemiBold"
                                                       Foreground="{DynamicResource Brush.TextPrimary}" Text="{Binding Name}"/>
                                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                                <CheckBox Margin="0" VerticalAlignment="Center" Style="{StaticResource Protection.Option}"
                                                          Content="Enabled" IsChecked="{Binding IsEnabled, Mode=OneWay}"
                                                          Command="{Binding DataContext.ToggleCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                          CommandParameter="{Binding}"/>
                                                <Button Margin="12,0,0,0" MinWidth="72" Height="32" Padding="12,4"
                                                        Style="{DynamicResource Button.Primary}" Content="Edit"
                                                        Click="EditSchedule_Click"
                                                        Command="{Binding DataContext.EditCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}"/>
                                                <Button Style="{StaticResource Schedule.CompactButton}" Content="Run now"
                                                        ToolTip="Apply this schedule immediately" Click="RunScheduleNow_Click"/>
                                                <Button Style="{StaticResource Schedule.CompactButton}" Content="Duplicate"
                                                        ToolTip="Create a copy of this schedule"
                                                        Command="{Binding DataContext.DuplicateCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}"/>
                                                <Button Style="{StaticResource Schedule.CompactButton}" Foreground="{DynamicResource Brush.Danger}"
                                                        Content="Delete" ToolTip="Delete this schedule" Click="DeleteSchedule_Click"/>
                                            </StackPanel>

                                            <StackPanel Grid.Row="1" Grid.ColumnSpan="2" Margin="0,10,0,0" Orientation="Horizontal">
                                                <Border Style="{StaticResource Schedule.Badge}">
                                                    <TextBlock FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource Brush.TextPrimary}" Text="{Binding Action}"/>
                                                </Border>
                                                <TextBlock Margin="10,0,0,0" VerticalAlignment="Center" Style="{DynamicResource Text.Secondary}"
                                                           Text="{Binding ServiceDisplay}" TextTrimming="CharacterEllipsis"/>
                                            </StackPanel>

                                            <Grid Grid.Row="2" Grid.ColumnSpan="2" Margin="0,10,0,0">
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                                <StackPanel>
                                                    <TextBlock Style="{StaticResource Schedule.FieldLabel}" Text="RECURRENCE"/>
                                                    <TextBlock Style="{DynamicResource Text.Secondary}" Text="{Binding RecurrenceDisplay}"/>
                                                </StackPanel>
                                                <StackPanel Grid.Column="1">
                                                    <TextBlock Style="{StaticResource Schedule.FieldLabel}" Text="NEXT RUN"/>
                                                    <TextBlock Style="{DynamicResource Text.Secondary}" Text="{Binding NextExecutionDisplay}"/>
                                                </StackPanel>
                                                <StackPanel Grid.Column="2">
                                                    <TextBlock Style="{StaticResource Schedule.FieldLabel}" Text="LAST RESULT"/>
                                                    <TextBlock Style="{DynamicResource Text.Secondary}" Text="{Binding LastResultDisplay}" TextTrimming="CharacterEllipsis"/>
                                                </StackPanel>
                                            </Grid>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <Expander x:Name="ScheduleEditor" Margin="0,8,0,0" Header="Schedule editor">
                            <Grid Margin="0,12,0,0">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/><RowDefinition Height="14"/>
                                    <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="18"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Style="{StaticResource Schedule.FieldLabel}" Text="SCHEDULE NAME"/>
                                    <TextBox Style="{StaticResource Protection.Input}" Text="{Binding EditorName, UpdateSourceTrigger=PropertyChanged}"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Style="{StaticResource Schedule.FieldLabel}" Text="ACTION"/>
                                    <ComboBox Style="{StaticResource Protection.ComboBox}" ItemsSource="{Binding Actions}" SelectedItem="{Binding EditorAction}"/>
                                </StackPanel>
                                <StackPanel Grid.Row="2">
                                    <TextBlock Style="{StaticResource Schedule.FieldLabel}" Text="SERVICES"/>
                                    <Border Padding="10" Background="{DynamicResource Brush.SurfaceMuted}" CornerRadius="8">
                                        <ItemsControl ItemsSource="{Binding AvailableServices}" MaxHeight="150">
                                            <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate><DataTemplate><CheckBox Margin="0,0,16,8" Style="{StaticResource Protection.Option}" Content="{Binding Name}" IsChecked="{Binding IsSelected}"/></DataTemplate></ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </Border>
                                </StackPanel>
                                <StackPanel Grid.Row="2" Grid.Column="2">
                                    <TextBlock Style="{StaticResource Schedule.FieldLabel}" Text="TIMING AND RECURRENCE"/>
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="110"/><ColumnDefinition Width="10"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                        <TextBox Style="{StaticResource Protection.Input}" Text="{Binding EditorTime}" ToolTip="Local time (HH:mm)"/>
                                        <ComboBox Grid.Column="2" Style="{StaticResource Protection.ComboBox}" ItemsSource="{Binding Recurrences}" SelectedItem="{Binding EditorRecurrence}"/>
                                    </Grid>
                                    <WrapPanel Margin="0,10,0,0">
                                        <CheckBox Style="{StaticResource Protection.Option}" Margin="0,0,10,8" Content="Mon" IsChecked="{Binding Monday}"/>
                                        <CheckBox Style="{StaticResource Protection.Option}" Margin="0,0,10,8" Content="Tue" IsChecked="{Binding Tuesday}"/>
                                        <CheckBox Style="{StaticResource Protection.Option}" Margin="0,0,10,8" Content="Wed" IsChecked="{Binding Wednesday}"/>
                                        <CheckBox Style="{StaticResource Protection.Option}" Margin="0,0,10,8" Content="Thu" IsChecked="{Binding Thursday}"/>
                                        <CheckBox Style="{StaticResource Protection.Option}" Margin="0,0,10,8" Content="Fri" IsChecked="{Binding Friday}"/>
                                        <CheckBox Style="{StaticResource Protection.Option}" Margin="0,0,10,8" Content="Sat" IsChecked="{Binding Saturday}"/>
                                        <CheckBox Style="{StaticResource Protection.Option}" Margin="0,0,10,8" Content="Sun" IsChecked="{Binding Sunday}"/>
                                    </WrapPanel>
                                    <DatePicker Width="180" HorizontalAlignment="Left" SelectedDate="{Binding EditorOneTimeDate}" ToolTip="Date for a one-time schedule"/>
                                </StackPanel>
                                <TextBlock Grid.Row="3" Grid.ColumnSpan="3" Margin="0,10,0,8"
                                           Foreground="{DynamicResource Brush.Warning}" Text="{Binding Status}"/>
                                <StackPanel Grid.Row="4" Grid.ColumnSpan="3" HorizontalAlignment="Right" Orientation="Horizontal">
                                    <Button MinWidth="90" Height="36" Margin="0,0,8,0" Style="{DynamicResource Button.Secondary}"
                                            Content="Cancel" Command="{Binding NewScheduleCommand}" Click="CancelSchedule_Click"/>
                                    <Button MinWidth="120" Height="36" Style="{DynamicResource Button.Primary}" Content="Save schedule" Command="{Binding SaveCommand}"/>
                                </StackPanel>
                            </Grid>
                        </Expander>

                        <Expander x:Name="AllowedWindowEditor" Margin="0,10,0,0" Header="Allowed-time window">
                            <StackPanel Margin="0,12,0,0">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="14"/><ColumnDefinition Width="110"/><ColumnDefinition Width="14"/><ColumnDefinition Width="110"/><ColumnDefinition Width="14"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Style="{StaticResource Schedule.FieldLabel}" Text="SERVICE"/>
                                    <ComboBox Style="{StaticResource Protection.ComboBox}" ItemsSource="{Binding AvailableServices}" DisplayMemberPath="Name" SelectedItem="{Binding WindowService}"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Style="{StaticResource Schedule.FieldLabel}" Text="ALLOW AT"/>
                                    <TextBox Style="{StaticResource Protection.Input}" Text="{Binding WindowAllowTime}" ToolTip="HH:mm"/>
                                </StackPanel>
                                <StackPanel Grid.Column="4">
                                    <TextBlock Style="{StaticResource Schedule.FieldLabel}" Text="BLOCK AGAIN"/>
                                    <TextBox Style="{StaticResource Protection.Input}" Text="{Binding WindowBlockTime}" ToolTip="HH:mm"/>
                                </StackPanel>
                                <Button Grid.Column="6" MinWidth="128" Height="36" VerticalAlignment="Bottom"
                                        Style="{DynamicResource Button.Primary}" Content="Create window" Command="{Binding CreateWindowCommand}"/>
                            </Grid>
                            <StackPanel Margin="0,10,0,0">
                                <TextBlock Style="{StaticResource Schedule.FieldLabel}" Text="DAYS"/>
                                <WrapPanel>
                                    <CheckBox Style="{StaticResource Protection.Option}" Margin="0,0,10,0" Content="Mon" IsChecked="{Binding Monday}"/>
                                    <CheckBox Style="{StaticResource Protection.Option}" Margin="0,0,10,0" Content="Tue" IsChecked="{Binding Tuesday}"/>
                                    <CheckBox Style="{StaticResource Protection.Option}" Margin="0,0,10,0" Content="Wed" IsChecked="{Binding Wednesday}"/>
                                    <CheckBox Style="{StaticResource Protection.Option}" Margin="0,0,10,0" Content="Thu" IsChecked="{Binding Thursday}"/>
                                    <CheckBox Style="{StaticResource Protection.Option}" Margin="0,0,10,0" Content="Fri" IsChecked="{Binding Friday}"/>
                                    <CheckBox Style="{StaticResource Protection.Option}" Margin="0,0,10,0" Content="Sat" IsChecked="{Binding Saturday}"/>
                                    <CheckBox Style="{StaticResource Protection.Option}" Margin="0" Content="Sun" IsChecked="{Binding Sunday}"/>
                                </WrapPanel>
                            </StackPanel>
                            </StackPanel>
                        </Expander>
                    </StackPanel>
                </Border>

                <!-- Recent DNS activity -->
                <Border Margin="0,0,0,16" Style="{DynamicResource Card}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Style="{DynamicResource Text.SectionTitle}" Text="Recent DNS activity"/>
                                <TextBlock Margin="0,5,0,0" Style="{DynamicResource Text.Secondary}"
                                           Text="Search the latest allowed and blocked requests handled by AdGuard Home."/>
                            </StackPanel>
                            <Button Grid.Column="1" MinWidth="96" Height="36"
                                    Style="{DynamicResource Button.Secondary}"
                                    Content="Refresh" Command="{Binding RefreshQueryLogCommand}"/>
                        </Grid>

                        <Grid Grid.Row="1" Margin="0,16,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox Height="36" Padding="10,6"
                                     Style="{StaticResource Protection.Input}"
                                     Text="{Binding QueryLogSearch, UpdateSourceTrigger=PropertyChanged}"
                                     ToolTip="Search by domain, client, address or status"/>
                            <CheckBox Grid.Column="1" Margin="16,0,0,0" VerticalAlignment="Center"
                                      Style="{StaticResource Protection.Option}"
                                      Content="Blocked only"
                                      IsChecked="{Binding ShowBlockedQueriesOnly}"/>
                        </Grid>

                        <StackPanel Grid.Row="2">
                            <TextBlock Margin="0,0,0,8" Style="{DynamicResource Text.Muted}"
                                       Text="{Binding QueryLogStatus}"/>
                            <DataGrid Height="300" ItemsSource="{Binding QueryLogView}"
                                      AutoGenerateColumns="False" IsReadOnly="True"
                                      CanUserAddRows="False" CanUserDeleteRows="False"
                                      HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                                      Background="{DynamicResource Brush.SurfaceMuted}"
                                      Foreground="{DynamicResource Brush.TextPrimary}"
                                      BorderBrush="{DynamicResource Brush.Border}"
                                      HorizontalGridLinesBrush="{DynamicResource Brush.Border}"
                                      RowBackground="{DynamicResource Brush.Surface}"
                                      AlternatingRowBackground="{DynamicResource Brush.SurfaceMuted}">
                                <DataGrid.RowStyle>
                                    <Style TargetType="DataGridRow">
                                        <Setter Property="Foreground" Value="{DynamicResource Brush.TextPrimary}"/>
                                        <Setter Property="ToolTip" Value="{Binding ClientAddress}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsBlocked}" Value="True">
                                                <Setter Property="Foreground" Value="{DynamicResource Brush.Danger}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </DataGrid.RowStyle>
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="TIME" Binding="{Binding Time}" Width="120"/>
                                    <DataGridTextColumn Header="CLIENT" Binding="{Binding Client}" Width="190"/>
                                    <DataGridTextColumn Header="DOMAIN" Binding="{Binding Domain}" Width="*"/>
                                    <DataGridTextColumn Header="STATUS" Binding="{Binding Status}" Width="105"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Rules and rewrites -->
                <Grid Margin="0,0,0,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Style="{DynamicResource Card}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <StackPanel>
                                <TextBlock Style="{DynamicResource Text.SectionTitle}"
                                           Text="Allow and block rules"/>
                                <TextBlock Margin="0,5,0,0"
                                           Style="{DynamicResource Text.Secondary}"
                                           Text="Enter a domain without a protocol or path."/>
                            </StackPanel>

                            <Grid Grid.Row="1" Margin="0,16,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <TextBox Style="{StaticResource Protection.Input}"
                                         Text="{Binding NewRuleDomain, UpdateSourceTrigger=PropertyChanged}"/>
                                <Button Grid.Column="1"
                                        Width="84"
                                        Margin="8,0,0,0"
                                        Style="{DynamicResource Button.Secondary}"
                                        Content="Block"
                                        Command="{Binding AddDenyRuleCommand}"/>
                                <Button Grid.Column="2"
                                        Width="84"
                                        Margin="8,0,0,0"
                                        Style="{DynamicResource Button.Secondary}"
                                        Content="Allow"
                                        Command="{Binding AddAllowRuleCommand}"/>
                            </Grid>

                            <ListBox Grid.Row="2"
                                     Height="205"
                                     Style="{StaticResource Protection.List}"
                                     ItemsSource="{Binding FilteringRules}"
                                     SelectedItem="{Binding SelectedRule}"
                                     DisplayMemberPath="Display"/>

                            <Button Grid.Row="3"
                                    Margin="0,12,0,0"
                                    MinWidth="136"
                                    HorizontalAlignment="Left"
                                    Style="{StaticResource Protection.DangerButton}"
                                    Content="Delete selected"
                                    Command="{Binding DeleteRuleCommand}"/>
                        </Grid>
                    </Border>

                    <Border Grid.Column="2" Style="{DynamicResource Card}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <StackPanel>
                                <TextBlock Style="{DynamicResource Text.SectionTitle}"
                                           Text="DNS rewrites"/>
                                <TextBlock Margin="0,5,0,0"
                                           Style="{DynamicResource Text.Secondary}"
                                           Text="Return a custom IP address or domain for a DNS name."/>
                            </StackPanel>

                            <Grid Grid.Row="1" Margin="0,16,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="10"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel>
                                    <TextBlock Style="{StaticResource Protection.SectionLabel}"
                                               Text="DOMAIN"/>
                                    <TextBox Style="{StaticResource Protection.Input}"
                                             Text="{Binding NewRewriteDomain, UpdateSourceTrigger=PropertyChanged}"/>
                                </StackPanel>

                                <StackPanel Grid.Column="2">
                                    <TextBlock Style="{StaticResource Protection.SectionLabel}"
                                               Text="ANSWER"/>
                                    <TextBox Style="{StaticResource Protection.Input}"
                                             Text="{Binding NewRewriteAnswer, UpdateSourceTrigger=PropertyChanged}"/>
                                </StackPanel>
                            </Grid>

                            <Button Grid.Row="2"
                                    MinWidth="108"
                                    Margin="0,0,0,12"
                                    HorizontalAlignment="Left"
                                    Style="{DynamicResource Button.Primary}"
                                    Content="Add rewrite"
                                    Command="{Binding AddRewriteCommand}"/>

                            <ListBox Grid.Row="3"
                                     Height="205"
                                     Style="{StaticResource Protection.List}"
                                     ItemsSource="{Binding DnsRewrites}"
                                     SelectedItem="{Binding SelectedRewrite}"
                                     DisplayMemberPath="Display"/>

                            <Button Grid.Row="4"
                                    Margin="0,12,0,0"
                                    MinWidth="136"
                                    HorizontalAlignment="Left"
                                    Style="{StaticResource Protection.DangerButton}"
                                    Content="Delete selected"
                                    Command="{Binding DeleteRewriteCommand}"/>
                        </Grid>
                    </Border>
                </Grid>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
