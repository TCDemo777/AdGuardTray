<Window x:Class="AdGuardTray.Views.DashboardWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="GL.iNet Dashboard"
        Height="650"
        Width="950"
        WindowStartupLocation="CenterScreen"
        Background="#F5F5F5">

    <Grid Margin="25">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0">

            <TextBlock
                Text="GL.iNet Dashboard"
                FontSize="30"
                FontWeight="Bold"/>

            <TextBlock
                Text="AdGuardTray Router Manager"
                FontSize="14"
                Foreground="Gray"
                Margin="0,5,0,20"/>

        </StackPanel>

        <!-- Main Cards -->
        <Grid Grid.Row="1">

            <Grid.ColumnDefinitions>
                <ColumnDefinition/>
                <ColumnDefinition/>
            </Grid.ColumnDefinitions>

            <!-- Router Card -->
            <Border
                Grid.Column="0"
                Background="White"
                CornerRadius="15"
                Padding="25"
                Margin="10">

                <StackPanel>

                    <TextBlock
                        Text="Router"
                        FontSize="22"
                        FontWeight="Bold"
                        Margin="0,0,0,20"/>

                    <TextBlock
                        Text="IP Address"
                        FontWeight="Bold"/>

                    <TextBlock
                        Text="{Binding RouterModel}"
                        Margin="0,0,0,15"/>

                    <TextBlock
                        Text="Connection"
                        FontWeight="Bold"/>

                    <TextBlock
                        Text="{Binding FirmwareVersion}"
                        Margin="0,0,0,15"/>

                    <TextBlock
                        Text="Last Refresh"
                        FontWeight="Bold"/>

                    <TextBlock
                        Text="{Binding Uptime}"/>

                </StackPanel>

            </Border>

            <!-- AdGuard Card -->
            <Border
                Grid.Column="1"
                Background="White"
                CornerRadius="15"
                Padding="25"
                Margin="10">

                <StackPanel>

                    <TextBlock
                        Text="AdGuard Home"
                        FontSize="22"
                        FontWeight="Bold"
                        Margin="0,0,0,20"/>

                    <TextBlock
                        Text="Running"
                        FontWeight="Bold"/>

                    <TextBlock
                        Text="{Binding AdGuardRunning}"
                        Margin="0,0,0,15"/>

                    <TextBlock
                        Text="Version"
                        FontWeight="Bold"/>

                    <TextBlock
                        Text="{Binding AdGuardVersion}"/>

                </StackPanel>

            </Border>

        </Grid>

        <!-- Bottom Buttons -->
        <StackPanel
            Grid.Row="2"
            Orientation="Horizontal"
            HorizontalAlignment="Center"
            Margin="0,20,0,0">

            <Button
                Content="Refresh"
                Width="120"
                Height="40"
                Margin="10"
                Click="Refresh_Click"/>

            <Button
                Content="Settings"
                Width="120"
                Height="40"
                Margin="10"
                Click="Settings_Click"/>

        </StackPanel>

    </Grid>

</Window>