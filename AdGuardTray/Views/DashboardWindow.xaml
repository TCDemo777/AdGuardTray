<Window x:Class="AdGuardTray.Views.DashboardWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:lvc="clr-namespace:LiveChartsCore.SkiaSharpView.WPF;assembly=LiveChartsCore.SkiaSharpView.WPF"
        Title="GL.iNet Router Manager"
        Width="1000"
        Height="700"
        WindowStartupLocation="CenterScreen"
        Background="#F3F5F7">

    <ScrollViewer
        VerticalScrollBarVisibility="Auto"
        HorizontalScrollBarVisibility="Disabled">

        <Grid Margin="20">

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="20"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="25"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="35"/>
            </Grid.RowDefinitions>

            <!-- Header -->

            <Grid Grid.Row="0">

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">

                    <TextBlock
                        FontSize="28"
                        FontWeight="Bold"
                        Text="GL.iNet Router Manager"/>

                    <TextBlock
                        Margin="0,8,0,0"
                        FontSize="16"
                        FontWeight="SemiBold"
                        Text="{Binding RouterStatusText}"/>

                </StackPanel>

                <StackPanel
                    Grid.Column="1"
                    Orientation="Horizontal"
                    VerticalAlignment="Center">

                    <Button
                        x:Name="RefreshButton"
                        Width="120"
                        Height="35"
                        Margin="5"
                        Content="Refresh"
                        Click="Refresh_Click"/>

                    <Button
                        x:Name="SettingsButton"
                        Width="120"
                        Height="35"
                        Margin="5"
                        Content="Settings"
                        Click="Settings_Click"/>

                </StackPanel>

            </Grid>

            <!-- Cards -->

            <UniformGrid
                Grid.Row="2"
                Columns="3">

                <!-- Router -->

                <Border
                    Margin="8"
                    Padding="15"
                    Background="White"
                    CornerRadius="10"
                    BorderBrush="#DDDDDD"
                    BorderThickness="1">

                    <StackPanel>

                        <TextBlock
                            FontSize="18"
                            FontWeight="Bold"
                            Text="Router"/>

                        <Separator Margin="0,8"/>

                        <TextBlock
                            FontWeight="SemiBold"
                            Text="{Binding RouterStatusText}"/>

                        <TextBlock
                            Margin="0,10,0,0"
                            Text="Model"/>

                        <TextBlock
                            FontWeight="SemiBold"
                            Text="{Binding RouterModel}"/>

                        <TextBlock
                            Margin="0,8,0,0"
                            Text="Firmware"/>

                        <TextBlock
                            FontWeight="SemiBold"
                            Text="{Binding FirmwareVersion}"/>

                        <TextBlock
                            Margin="0,8,0,0"
                            Text="Hostname"/>

                        <TextBlock
                            FontWeight="SemiBold"
                            Text="{Binding Hostname}"/>

                        <TextBlock
                            Margin="0,8,0,0"
                            Text="Since Boot"/>

                        <TextBlock
                            FontWeight="SemiBold"
                            Text="{Binding Uptime}"/>

                        <TextBlock
                            Margin="0,8,0,0"
                            Text="CPU Usage"/>

                        <ProgressBar
                            Height="14"
                            Margin="0,5,0,0"
                            Minimum="0"
                            Maximum="100"
                            Value="{Binding CpuPercentage}"/>

                        <TextBlock
                            Margin="0,3,0,0"
                            FontWeight="SemiBold"
                            Text="{Binding CpuUsage}"/>

                        <TextBlock
                            Margin="0,12,0,0"
                            Text="Memory Usage"/>

                        <ProgressBar
                            Height="14"
                            Margin="0,5,0,0"
                            Minimum="0"
                            Maximum="100"
                            Value="{Binding MemoryPercentage}"/>

                        <TextBlock
                            Margin="0,3,0,0"
                            FontWeight="SemiBold"
                            Text="{Binding MemoryUsage}"/>

                    </StackPanel>

                </Border>

                <!-- AdGuard -->

                <Border
                    Margin="8"
                    Padding="15"
                    Background="White"
                    CornerRadius="10"
                    BorderBrush="#DDDDDD"
                    BorderThickness="1">

                    <StackPanel>

                        <TextBlock
                            FontSize="18"
                            FontWeight="Bold"
                            Text="AdGuard Home"/>

                        <Separator Margin="0,8"/>

                        <TextBlock
                            FontWeight="SemiBold"
                            Text="{Binding AdGuardStatusText}"/>

                        <TextBlock
                            Margin="0,10,0,0"
                            Text="Version"/>

                        <TextBlock
                            FontWeight="SemiBold"
                            Text="{Binding AdGuardVersion}"/>

                        <TextBlock
                            Margin="0,8,0,0"
                            Text="Service"/>

                        <TextBlock
                            FontWeight="SemiBold"
                            Text="{Binding AdGuardService}"/>

                        <TextBlock
                            Margin="0,8,0,0"
                            Text="Process"/>

                        <TextBlock
                            FontWeight="SemiBold"
                            Text="{Binding AdGuardProcess}"/>

                        <TextBlock
                            Margin="0,8,0,0"
                            Text="Queries Today"/>

                        <TextBlock
                            FontWeight="SemiBold"
                            Text="{Binding AdGuardQueries}"/>

                        <TextBlock
                            Margin="0,8,0,0"
                            Text="Blocked"/>

                        <TextBlock
                            FontWeight="SemiBold"
                            Text="{Binding AdGuardBlocked}"/>

                        <TextBlock
                            Margin="0,8,0,0"
                            Text="Block Rate"/>

                        <TextBlock
                            FontWeight="SemiBold"
                            Text="{Binding AdGuardBlockRate}"/>

                    </StackPanel>

                </Border>

                <!-- Internet -->

                <Border
                    Margin="8"
                    Padding="15"
                    Background="White"
                    CornerRadius="10"
                    BorderBrush="#DDDDDD"
                    BorderThickness="1">

                    <StackPanel>

                        <TextBlock
                            FontSize="18"
                            FontWeight="Bold"
                            Text="Internet"/>

                        <Separator Margin="0,8"/>

                        <TextBlock
                            FontWeight="SemiBold"
                            Text="{Binding InternetStatusText}"/>

                        <TextBlock
                            Margin="0,10,0,0"
                            Text="WAN IP"/>

                        <TextBlock
                            FontWeight="SemiBold"
                            Text="{Binding WanIp}"/>

                        <TextBlock
                            Margin="0,8,0,0"
                            Text="Gateway"/>

                        <TextBlock
                            FontWeight="SemiBold"
                            Text="{Binding Gateway}"/>

                        <TextBlock
                            Margin="0,8,0,0"
                            Text="External DNS"/>

                        <TextBlock
                            FontWeight="SemiBold"
                            Text="{Binding ExternalDns}"/>

                        <TextBlock
                            Margin="0,8,0,0"
                            Text="Advertised DNS"/>

                        <TextBlock
                            FontWeight="SemiBold"
                            Text="{Binding AdvertisedDns}"/>

                        <TextBlock
                            Margin="0,8,0,0"
                            Text="Latency"/>

                        <TextBlock
                            FontWeight="SemiBold"
                            Text="{Binding Latency}"/>

                    </StackPanel>

                </Border>

            </UniformGrid>

            <!-- DNS Query History -->

            <Border
                Grid.Row="4"
                Margin="8"
                Padding="15"
                Background="White"
                CornerRadius="10"
                BorderBrush="#DDDDDD"
                BorderThickness="1">

                <Grid>

                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="240"/>
                    </Grid.RowDefinitions>

                    <TextBlock
                        Grid.Row="0"
                        Margin="0,0,0,12"
                        FontSize="18"
                        FontWeight="Bold"
                        Text="DNS Query History"/>

                    <lvc:CartesianChart
                        Grid.Row="1"
                        Series="{Binding QueryHistorySeries}"/>

                </Grid>

            </Border>

            <!-- Status -->

            <StatusBar Grid.Row="5">

                <StatusBarItem>

                    <TextBlock
                        Text="{Binding StatusMessage}"/>

                </StatusBarItem>

                <Separator/>

                <StatusBarItem>

                    <TextBlock
                        Text="{Binding LastRefresh}"/>

                </StatusBarItem>

            </StatusBar>

        </Grid>

    </ScrollViewer>

</Window>