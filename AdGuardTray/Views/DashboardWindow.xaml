<Window x:Class="AdGuardTray.Views.DashboardWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:lvc="clr-namespace:LiveChartsCore.SkiaSharpView.WPF;assembly=LiveChartsCore.SkiaSharpView.WPF"
        Title="GL.iNet Router Manager"
        Width="1100"
        Height="720"
        MinWidth="900"
        MinHeight="600"
        WindowStartupLocation="CenterScreen"
        Background="#F3F5F7">

    <Grid>

        <Grid.RowDefinitions>
            <RowDefinition Height="72"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="35"/>
        </Grid.RowDefinitions>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="190"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Header -->

        <Border
            Grid.Row="0"
            Grid.Column="0"
            Grid.ColumnSpan="2"
            Background="White"
            BorderBrush="#DDDDDD"
            BorderThickness="0,0,0,1">

            <Grid Margin="20,0">

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel
                    Grid.Column="0"
                    VerticalAlignment="Center">

                    <TextBlock
                        FontSize="24"
                        FontWeight="Bold"
                        Text="GL.iNet Router Manager"/>

                    <TextBlock
                        Margin="0,4,0,0"
                        FontSize="14"
                        FontWeight="SemiBold"
                        Foreground="#555555"
                        Text="{Binding RouterStatusText}"/>

                </StackPanel>

                <StackPanel
                    Grid.Column="1"
                    Orientation="Horizontal"
                    VerticalAlignment="Center">

                    <Button
                        x:Name="RefreshButton"
                        Width="110"
                        Height="36"
                        Margin="5,0"
                        Content="Refresh"
                        Click="Refresh_Click"/>

                    <Button
                        x:Name="SettingsButton"
                        Width="110"
                        Height="36"
                        Margin="5,0"
                        Content="Settings"
                        Click="Settings_Click"/>

                </StackPanel>

            </Grid>

        </Border>

        <!-- Navigation -->

        <Border
            Grid.Row="1"
            Grid.Column="0"
            Background="#20262E"
            BorderBrush="#15191E"
            BorderThickness="0,0,1,0">

            <Grid>

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <TextBlock
                    Grid.Row="0"
                    Margin="20,22,20,14"
                    FontSize="12"
                    FontWeight="SemiBold"
                    Foreground="#AAB2BC"
                    Text="NAVIGATION"/>

                <StackPanel Grid.Row="1">

                    <Button
                        Height="48"
                        Margin="10,2"
                        HorizontalContentAlignment="Left"
                        Padding="16,0"
                        Background="#35404D"
                        Foreground="White"
                        BorderThickness="0"
                        Content="Overview"/>

                    <Button
                        Height="48"
                        Margin="10,2"
                        HorizontalContentAlignment="Left"
                        Padding="16,0"
                        Background="Transparent"
                        Foreground="#D7DCE2"
                        BorderThickness="0"
                        Content="Analytics"/>

                    <Button
                        Height="48"
                        Margin="10,2"
                        HorizontalContentAlignment="Left"
                        Padding="16,0"
                        Background="Transparent"
                        Foreground="#D7DCE2"
                        BorderThickness="0"
                        Content="Network"/>

                    <Button
                        Height="48"
                        Margin="10,2"
                        HorizontalContentAlignment="Left"
                        Padding="16,0"
                        Background="Transparent"
                        Foreground="#D7DCE2"
                        BorderThickness="0"
                        Content="Clients"/>

                    <Button
                        Height="48"
                        Margin="10,2"
                        HorizontalContentAlignment="Left"
                        Padding="16,0"
                        Background="Transparent"
                        Foreground="#D7DCE2"
                        BorderThickness="0"
                        Content="Logs"/>

                    <Button
                        Height="48"
                        Margin="10,2"
                        HorizontalContentAlignment="Left"
                        Padding="16,0"
                        Background="Transparent"
                        Foreground="#D7DCE2"
                        BorderThickness="0"
                        Content="Settings"/>

                </StackPanel>

            </Grid>

        </Border>

        <!-- Main overview content -->

        <Grid
            Grid.Row="1"
            Grid.Column="1"
            Margin="20">

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="16"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0">

                <TextBlock
                    FontSize="24"
                    FontWeight="Bold"
                    Text="Overview"/>

                <TextBlock
                    Margin="0,5,0,0"
                    FontSize="14"
                    Foreground="#666666"
                    Text="Current router, AdGuard Home and internet status"/>

            </StackPanel>

            <!-- Cards -->

            <UniformGrid
                Grid.Row="2"
                Columns="3">

                <!-- Router -->

                <Border
                    Margin="6"
                    Padding="16"
                    Background="White"
                    CornerRadius="10"
                    BorderBrush="#DDDDDD"
                    BorderThickness="1">

                    <StackPanel>

                        <TextBlock
                            FontSize="18"
                            FontWeight="Bold"
                            Text="Router"/>

                        <Separator Margin="0,8"/>

                        <TextBlock
                            FontWeight="SemiBold"
                            Text="{Binding RouterStatusText}"/>

                        <TextBlock
                            Margin="0,10,0,0"
                            Text="Model"/>

                        <TextBlock
                            FontWeight="SemiBold"
                            Text="{Binding RouterModel}"/>

                        <TextBlock
                            Margin="0,8,0,0"
                            Text="Firmware"/>

                        <TextBlock
                            FontWeight="SemiBold"
                            Text="{Binding FirmwareVersion}"/>

                        <TextBlock
                            Margin="0,8,0,0"
                            Text="Hostname"/>

                        <TextBlock
                            FontWeight="SemiBold"
                            Text="{Binding Hostname}"/>

                        <TextBlock
                            Margin="0,8,0,0"
                            Text="Since Boot"/>

                        <TextBlock
                            FontWeight="SemiBold"
                            Text="{Binding Uptime}"/>

                        <TextBlock
                            Margin="0,8,0,0"
                            Text="CPU Usage"/>

                        <ProgressBar
                            Height="14"
                            Margin="0,5,0,0"
                            Minimum="0"
                            Maximum="100"
                            Value="{Binding CpuPercentage}"/>

                        <TextBlock
                            Margin="0,3,0,0"
                            FontWeight="SemiBold"
                            Text="{Binding CpuUsage}"/>

                        <TextBlock
                            Margin="0,12,0,0"
                            Text="Memory Usage"/>

                        <ProgressBar
                            Height="14"
                            Margin="0,5,0,0"
                            Minimum="0"
                            Maximum="100"
                            Value="{Binding MemoryPercentage}"/>

                        <TextBlock
                            Margin="0,3,0,0"
                            FontWeight="SemiBold"
                            Text="{Binding MemoryUsage}"/>

                    </StackPanel>

                </Border>

                <!-- AdGuard -->

                <Border
                    Margin="6"
                    Padding="16"
                    Background="White"
                    CornerRadius="10"
                    BorderBrush="#DDDDDD"
                    BorderThickness="1">

                    <StackPanel>

                        <TextBlock
                            FontSize="18"
                            FontWeight="Bold"
                            Text="AdGuard Home"/>

                        <Separator Margin="0,8"/>

                        <TextBlock
                            FontWeight="SemiBold"
                            Text="{Binding AdGuardStatusText}"/>

                        <TextBlock
                            Margin="0,10,0,0"
                            Text="Version"/>

                        <TextBlock
                            FontWeight="SemiBold"
                            Text="{Binding AdGuardVersion}"/>

                        <TextBlock
                            Margin="0,8,0,0"
                            Text="Service"/>

                        <TextBlock
                            FontWeight="SemiBold"
                            Text="{Binding AdGuardService}"/>

                        <TextBlock
                            Margin="0,8,0,0"
                            Text="Process"/>

                        <TextBlock
                            FontWeight="SemiBold"
                            Text="{Binding AdGuardProcess}"/>

                        <TextBlock
                            Margin="0,8,0,0"
                            Text="Queries Today"/>

                        <TextBlock
                            FontWeight="SemiBold"
                            Text="{Binding AdGuardQueries}"/>

                        <TextBlock
                            Margin="0,8,0,0"
                            Text="Blocked"/>

                        <TextBlock
                            FontWeight="SemiBold"
                            Text="{Binding AdGuardBlocked}"/>

                        <TextBlock
                            Margin="0,8,0,0"
                            Text="Block Rate"/>

                        <TextBlock
                            FontWeight="SemiBold"
                            Text="{Binding AdGuardBlockRate}"/>

                    </StackPanel>

                </Border>

                <!-- Internet -->

                <Border
                    Margin="6"
                    Padding="16"
                    Background="White"
                    CornerRadius="10"
                    BorderBrush="#DDDDDD"
                    BorderThickness="1">

                    <StackPanel>

                        <TextBlock
                            FontSize="18"
                            FontWeight="Bold"
                            Text="Internet"/>

                        <Separator Margin="0,8"/>

                        <TextBlock
                            FontWeight="SemiBold"
                            Text="{Binding InternetStatusText}"/>

                        <TextBlock
                            Margin="0,10,0,0"
                            Text="WAN IP"/>

                        <TextBlock
                            FontWeight="SemiBold"
                            Text="{Binding WanIp}"/>

                        <TextBlock
                            Margin="0,8,0,0"
                            Text="Gateway"/>

                        <TextBlock
                            FontWeight="SemiBold"
                            Text="{Binding Gateway}"/>

                        <TextBlock
                            Margin="0,8,0,0"
                            Text="External DNS"/>

                        <TextBlock
                            FontWeight="SemiBold"
                            Text="{Binding ExternalDns}"/>

                        <TextBlock
                            Margin="0,8,0,0"
                            Text="Advertised DNS"/>

                        <TextBlock
                            FontWeight="SemiBold"
                            Text="{Binding AdvertisedDns}"/>

                        <TextBlock
                            Margin="0,8,0,0"
                            Text="Latency"/>

                        <TextBlock
                            FontWeight="SemiBold"
                            Text="{Binding Latency}"/>

                    </StackPanel>

                </Border>

            </UniformGrid>

        </Grid>

        <!-- Status bar -->

        <StatusBar
            Grid.Row="2"
            Grid.Column="0"
            Grid.ColumnSpan="2">

            <StatusBarItem>

                <TextBlock
                    Text="{Binding StatusMessage}"/>

            </StatusBarItem>

            <Separator/>

            <StatusBarItem>

                <TextBlock
                    Text="{Binding LastRefresh}"/>

            </StatusBarItem>

        </StatusBar>

    </Grid>

</Window>