<Window x:Class="AdGuardTray.Views.DashboardWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:AdGuardTray.Views"
        Title="AdGuardTray"
        Width="1100"
        Height="720"
        MinWidth="900"
        MinHeight="600"
        WindowStartupLocation="CenterScreen"
        Background="#F3F5F7">
    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Height" Value="38"/><Setter Property="Padding" Value="16,0"/>
            <Setter Property="Background" Value="#EEF3F8"/><Setter Property="Foreground" Value="#172033"/>
            <Setter Property="BorderBrush" Value="#CBD5E1"/><Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style TargetType="TextBox"><Setter Property="MinHeight" Value="36"/><Setter Property="Padding" Value="9,6"/><Setter Property="BorderBrush" Value="#CBD5E1"/></Style>
        <Style TargetType="ComboBox"><Setter Property="MinHeight" Value="36"/><Setter Property="Padding" Value="8,4"/></Style>
    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="72"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="35"/>
        </Grid.RowDefinitions>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="190"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Row="0"
                Grid.Column="0"
                Grid.ColumnSpan="2"
                Background="White"
                BorderBrush="#DDDDDD"
                BorderThickness="0,0,0,1">
            <Grid Margin="20,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0"
                            VerticalAlignment="Center">
                    <TextBlock FontSize="24"
                               FontWeight="Bold"
                               Text="AdGuardTray"/>
                </StackPanel>

                <Button x:Name="RefreshButton"
                        Grid.Column="1"
                        Width="110"
                        Height="36"
                        VerticalAlignment="Center"
                        Content="Refresh"
                        Click="Refresh_Click"/>
            </Grid>
        </Border>

        <Border Grid.Row="1"
                Grid.Column="0"
                Background="#20262E"
                BorderBrush="#15191E"
                BorderThickness="0,0,1,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0"
                           Margin="20,22,20,14"
                           FontSize="12"
                           FontWeight="SemiBold"
                           Foreground="#AAB2BC"
                           Text="NAVIGATION"/>

                <StackPanel Grid.Row="1">
                    <Button x:Name="OverviewButton"
                            Height="48"
                            Margin="10,2"
                            Padding="16,0"
                            HorizontalContentAlignment="Left"
                            Background="#35404D"
                            Foreground="White"
                            BorderThickness="0"
                            Content="Overview"
                            Click="Overview_Click"/>

                    <Button x:Name="ProtectionButton"
                            Height="48"
                            Margin="10,2"
                            Padding="16,0"
                            HorizontalContentAlignment="Left"
                            Background="Transparent"
                            Foreground="#D7DCE2"
                            BorderThickness="0"
                            Content="Protection"
                            Click="Protection_Click"/>

                    <Button x:Name="AnalyticsButton"
                            Height="48"
                            Margin="10,2"
                            Padding="16,0"
                            HorizontalContentAlignment="Left"
                            Background="Transparent"
                            Foreground="#D7DCE2"
                            BorderThickness="0"
                            Content="Analytics"
                            Click="Analytics_Click"/>

                    <Button x:Name="NetworkButton"
                            Height="48"
                            Margin="10,2"
                            Padding="16,0"
                            HorizontalContentAlignment="Left"
                            Background="Transparent"
                            Foreground="#D7DCE2"
                            BorderThickness="0"
                            Content="Network"
                            Click="Network_Click"/>

                    <Button x:Name="ClientsButton"
                            Height="48"
                            Margin="10,2"
                            Padding="16,0"
                            HorizontalContentAlignment="Left"
                            Background="Transparent"
                            Foreground="#D7DCE2"
                            BorderThickness="0"
                            Content="Clients"
                            Click="Clients_Click"/>

                    <Button x:Name="LogsButton"
                            Height="48"
                            Margin="10,2"
                            Padding="16,0"
                            HorizontalContentAlignment="Left"
                            Background="Transparent"
                            Foreground="#D7DCE2"
                            BorderThickness="0"
                            Content="Logs"
                            Click="Logs_Click"/>

                    <Button x:Name="NavigationSettingsButton"
                            Height="48"
                            Margin="10,2"
                            Padding="16,0"
                            HorizontalContentAlignment="Left"
                            Background="Transparent"
                            Foreground="#D7DCE2"
                            BorderThickness="0"
                            Content="Settings"
                            Click="NavigationSettings_Click"/>

                    <Button x:Name="AboutButton"
                            Height="48"
                            Margin="10,2"
                            Padding="16,0"
                            HorizontalContentAlignment="Left"
                            Background="Transparent"
                            Foreground="#D7DCE2"
                            BorderThickness="0"
                            Content="About"
                            Click="About_Click"/>
                </StackPanel>
                <Border Grid.Row="2" Margin="10,8,10,12" Padding="10" Background="#192027" CornerRadius="8">
                    <StackPanel>
                        <TextBlock Foreground="#D7DCE2"
                                   FontSize="12"
                                   FontWeight="SemiBold"
                                   Text="AdGuardTray"/>
                        <TextBlock Margin="0,3,0,0"
                                   Foreground="#8F9AA6"
                                   FontSize="10.5"
                                   LineHeight="14"
                                   TextWrapping="Wrap"
                                   Text="Router and DNS management"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <ContentControl x:Name="PageContent"
                        Grid.Row="1"
                        Grid.Column="1"
                        Margin="20">
            <views:OverviewView/>
        </ContentControl>

        <StatusBar Grid.Row="2"
                   Grid.Column="0"
                   Grid.ColumnSpan="2">
            <StatusBarItem>
                <TextBlock FontWeight="SemiBold" Foreground="{Binding OverallStatusColour}" Text="{Binding StatusMessage}"/>
            </StatusBarItem>

            <Separator/>

            <StatusBarItem>
                <TextBlock Text="{Binding LastRefresh}"/>
            </StatusBarItem>
        </StatusBar>
    </Grid>
</Window>
