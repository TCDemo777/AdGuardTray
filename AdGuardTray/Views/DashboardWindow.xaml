<Window x:Class="AdGuardTray.Views.DashboardWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="GL.iNet Desktop Manager"
        Height="650"
        Width="950"
        WindowStartupLocation="CenterScreen"
        Background="#F3F5F7">

    <Grid Margin="25">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->

        <StackPanel Grid.Row="0">

            <TextBlock
                Text="GL.iNet Desktop Manager"
                FontSize="30"
                FontWeight="Bold"/>

            <TextBlock
                Text="Router Dashboard"
                Foreground="Gray"
                Margin="0,5,0,20"/>

        </StackPanel>

        <!-- Main Cards -->

        <Grid Grid.Row="1">

            <Grid.ColumnDefinitions>
                <ColumnDefinition/>
                <ColumnDefinition/>
            </Grid.ColumnDefinitions>

            <!-- ===================== -->
            <!-- Router Card -->
            <!-- ===================== -->

            <Border
                Grid.Column="0"
                Background="White"
                CornerRadius="12"
                Margin="10"
                Padding="20">

                <StackPanel>

                    <TextBlock
                        Text="Router"
                        FontWeight="Bold"
                        FontSize="24"/>

                    <StackPanel
                        Orientation="Horizontal"
                        Margin="0,20,0,15">

                        <Ellipse
                            Width="14"
                            Height="14"
                            Margin="0,4,8,0"
                            Fill="{Binding RouterStatusBrush}"/>

                        <TextBlock
                            FontSize="18"
                            FontWeight="SemiBold"
                            Text="{Binding RouterStatusText}"/>

                    </StackPanel>

                    <Separator Margin="0,5"/>

                    <TextBlock
                        Text="Router"/>

                    <TextBlock
                        Text="{Binding RouterModel}"
                        FontWeight="Bold"
                        FontSize="16"
                        Margin="0,2,0,10"/>

                    <TextBlock
                        Text="Firmware"/>

                    <TextBlock
                        Text="{Binding FirmwareVersion}"
                        FontWeight="Bold"
                        Margin="0,2,0,10"/>

                    <TextBlock
                        Text="Last Refresh"/>

                    <TextBlock
                        Text="{Binding Uptime}"
                        FontWeight="Bold"
                        Margin="0,2,0,10"/>

                    <TextBlock
                        Text="Memory"/>

                    <TextBlock
                        Text="{Binding MemoryUsage}"
                        FontWeight="Bold"
                        Margin="0,2,0,10"/>

                    <TextBlock
                        Text="Storage"/>

                    <TextBlock
                        Text="{Binding StorageUsage}"
                        FontWeight="Bold"/>

                </StackPanel>

            </Border>

            <!-- ===================== -->
            <!-- AdGuard Card -->
            <!-- ===================== -->

            <Border
                Grid.Column="1"
                Background="White"
                CornerRadius="12"
                Margin="10"
                Padding="20">

                <StackPanel>

                    <TextBlock
                        Text="AdGuard Home"
                        FontWeight="Bold"
                        FontSize="24"/>

                    <StackPanel
                        Orientation="Horizontal"
                        Margin="0,20,0,15">

                        <Ellipse
                            Width="14"
                            Height="14"
                            Margin="0,4,8,0"
                            Fill="{Binding AdGuardStatusBrush}"/>

                        <TextBlock
                            FontSize="18"
                            FontWeight="SemiBold"
                            Text="{Binding AdGuardStatusText}"/>

                    </StackPanel>

                    <Separator Margin="0,5"/>

                    <TextBlock
                        Text="Version"/>

                    <TextBlock
                        Text="{Binding AdGuardVersion}"
                        FontWeight="Bold"
                        FontSize="16"
                        Margin="0,2,0,10"/>

                    <TextBlock
                        Text="Process"/>

                    <TextBlock
                        Text="{Binding AdGuardProcess}"
                        FontWeight="Bold"
                        Margin="0,2,0,10"/>

                    <TextBlock
                        Text="Service"/>

                    <TextBlock
                        Text="{Binding AdGuardService}"
                        FontWeight="Bold"/>

                </StackPanel>

            </Border>

        </Grid>

        <!-- Bottom Buttons -->

        <StackPanel
            Grid.Row="2"
            Orientation="Horizontal"
            HorizontalAlignment="Center"
            Margin="0,25,0,0">

            <Button
                Width="120"
                Height="40"
                Margin="8"
                Content="Refresh"
                Click="Refresh_Click"/>

            <Button
                Width="120"
                Height="40"
                Margin="8"
                Content="Settings"
                Click="Settings_Click"/>

        </StackPanel>

    </Grid>

</Window>