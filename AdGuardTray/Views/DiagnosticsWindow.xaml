<Window x:Class="AdGuardTray.Views.DiagnosticsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Diagnostics"
        Height="650"
        Width="900"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource Brush.WindowBackground}">

    <Grid Margin="20">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock
            Text="Diagnostics"
            FontSize="28"
            FontWeight="Bold"
            Margin="0,0,0,20"/>

        <WrapPanel
            Grid.Row="1"
            Margin="0,0,0,15">

            <Button
                x:Name="RouterInfoButton"
                Width="140"
                Height="35"
                Margin="0,0,10,10"
                Content="Router Info"
                Click="RouterInfoButton_Click"/>

            <Button
                x:Name="AdGuardStatusButton"
                Width="140"
                Height="35"
                Margin="0,0,10,10"
                Content="AdGuard Status"
                Click="AdGuardStatusButton_Click"/>

            <Button
                x:Name="LogsButton"
                Width="140"
                Height="35"
                Margin="0,0,10,10"
                Content="AdGuard Logs"
                Click="LogsButton_Click"/>

            <Button
                x:Name="RestartButton"
                Width="140"
                Height="35"
                Margin="0,0,10,10"
                Content="Restart AdGuard"
                Click="RestartButton_Click"/>

            <Button
                x:Name="RefreshButton"
                Width="140"
                Height="35"
                Margin="0,0,10,10"
                Content="Refresh"
                Click="RefreshButton_Click"/>

        </WrapPanel>

        <TextBox
            x:Name="OutputBox"
            Grid.Row="2"
            FontFamily="Consolas"
            FontSize="13"
            IsReadOnly="True"
            AcceptsReturn="True"
            AcceptsTab="True"
            TextWrapping="NoWrap"
            VerticalScrollBarVisibility="Auto"
            HorizontalScrollBarVisibility="Auto"/>

    </Grid>

</Window>