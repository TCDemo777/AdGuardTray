<UserControl x:Class="AdGuardTray.Views.AboutView"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <ScrollViewer VerticalScrollBarVisibility="Auto">
  <StackPanel MaxWidth="900" HorizontalAlignment="Left">
   <TextBlock FontSize="28" FontWeight="Bold" Text="About AdGuardTray"/>
   <TextBlock Margin="0,6,0,22" FontSize="14" Foreground="#5B6472" Text="A Windows desktop management console for GL.iNet routers and AdGuard Home."/>
   <Border Padding="24" Background="White" CornerRadius="12" BorderBrush="#DDE3EA" BorderThickness="1">
    <StackPanel>
     <TextBlock FontSize="24" FontWeight="Bold" Text="AdGuardTray"/>
     <TextBlock Margin="0,5,0,0" Foreground="#5B6472" Text="Version 1.0"/>
     <TextBlock Margin="0,18,0,0" FontSize="15" LineHeight="23" TextWrapping="Wrap" Text="AdGuardTray brings router health, AdGuard Home protection controls, analytics, client activity, DNS query logs and configuration tools into one native Windows application."/>
    </StackPanel>
   </Border>
   <Grid Margin="0,14,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="14"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
    <Border Grid.Column="0" Padding="22" Background="White" CornerRadius="12" BorderBrush="#DDE3EA" BorderThickness="1"><StackPanel><TextBlock FontSize="18" FontWeight="Bold" Text="What it does"/><TextBlock Margin="0,12,0,0" LineHeight="22" TextWrapping="Wrap" Text="• Monitors router, internet and AdGuard Home status&#x0a;• Manages protection, filtering and blocked services&#x0a;• Displays DNS analytics, clients and live query logs&#x0a;• Manages custom filtering rules and DNS rewrites"/></StackPanel></Border>
    <Border Grid.Column="2" Padding="22" Background="White" CornerRadius="12" BorderBrush="#DDE3EA" BorderThickness="1"><StackPanel><TextBlock FontSize="18" FontWeight="Bold" Text="Privacy and security"/><TextBlock Margin="0,12,0,0" LineHeight="22" TextWrapping="Wrap" Text="Router credentials remain on this computer. Saved passwords are protected with Windows DPAPI, and the application communicates directly with the router configured in Settings."/></StackPanel></Border>
   </Grid>
   <Border Margin="0,14,0,0" Padding="22" Background="#F8FAFC" CornerRadius="12" BorderBrush="#DDE3EA" BorderThickness="1"><StackPanel><TextBlock FontSize="18" FontWeight="Bold" Text="Acknowledgements"/><TextBlock Margin="0,10,0,0" LineHeight="22" TextWrapping="Wrap" Text="Built with WPF, .NET and CommunityToolkit.Mvvm. AdGuard Home is a product of AdGuard Software Ltd. GL.iNet is a trademark of GL Technologies. AdGuardTray is an independent project and is not affiliated with or endorsed by either company."/></StackPanel></Border>
  </StackPanel>
 </ScrollViewer>
</UserControl>