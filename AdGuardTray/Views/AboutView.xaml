<UserControl x:Class="AdGuardTray.Views.AboutView"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <ScrollViewer VerticalScrollBarVisibility="Auto"
                 HorizontalContentAlignment="Stretch">
  <Grid>
   <Grid.ColumnDefinitions>
    <ColumnDefinition Width="*"/>
   </Grid.ColumnDefinitions>
   <StackPanel HorizontalAlignment="Stretch">
   <TextBlock FontSize="28" FontWeight="Bold" Text="About AdGuardTray"/>
   <TextBlock Margin="0,6,0,22" FontSize="14" Foreground="#5B6472"
              Text="A native Windows console for GL.iNet routers and AdGuard Home."/>

   <Border Padding="24" Background="White" CornerRadius="12" BorderBrush="#DDE3EA" BorderThickness="1">
    <Grid>
     <Grid.ColumnDefinitions><ColumnDefinition Width="150"/><ColumnDefinition Width="24"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
     <Image Width="140" Height="140" Stretch="Uniform" Source="/Assets/AdGuardTrayLogo.png"/>
     <StackPanel Grid.Column="2"
                 VerticalAlignment="Center"
                 HorizontalAlignment="Stretch"
                 TextBlock.TextAlignment="Left">
      <TextBlock FontSize="26" FontWeight="Bold" Text="AdGuardTray"/>
      <TextBlock Margin="0,5,0,0" Foreground="#5B6472" Text="Version 1.0"/>
      <TextBlock Margin="0,14,0,0" FontSize="15" LineHeight="23" TextWrapping="Wrap"
                 Text="Router health, AdGuard Home protection, analytics, clients, live DNS logs and network administration in one focused desktop application."/>
      <TextBlock Margin="0,14,0,0" FontSize="15" FontWeight="SemiBold"
                 Text="Created by Tristan Caldwell"/>
      <TextBlock Margin="0,6,0,0">
       <Hyperlink NavigateUri="https://github.com/TCDemo777"
                  RequestNavigate="GitHubLink_RequestNavigate">github.com/TCDemo777</Hyperlink>
      </TextBlock>
     </StackPanel>
    </Grid>
   </Border>

   <Grid Margin="0,14,0,0">
    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="14"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
    <Border Grid.Column="0" Padding="22" Background="White" CornerRadius="12" BorderBrush="#DDE3EA" BorderThickness="1">
     <StackPanel HorizontalAlignment="Stretch"
                 TextBlock.TextAlignment="Left">
      <TextBlock FontSize="18" FontWeight="Bold" Text="Features"/>
      <TextBlock Margin="0,12,0,0" LineHeight="22" TextWrapping="Wrap"
                 Text="• Live router, internet and AdGuard health&#x0a;• Protection controls, profiles and timed pauses&#x0a;• Blocked services, custom rules and DNS rewrites&#x0a;• Client activity, analytics and live query logs&#x0a;• CSV and JSON log export"/>
     </StackPanel>
    </Border>
    <Border Grid.Column="2" Padding="22" Background="White" CornerRadius="12" BorderBrush="#DDE3EA" BorderThickness="1">
     <StackPanel HorizontalAlignment="Stretch"
                 TextBlock.TextAlignment="Left">
      <TextBlock FontSize="18" FontWeight="Bold" Text="Privacy and security"/>
      <TextBlock Margin="0,12,0,0" LineHeight="22" TextWrapping="Wrap"
                 Text="AdGuardTray connects directly to the router configured in Settings. Saved passwords are protected with Windows Data Protection and remain tied to the current Windows user."/>
     </StackPanel>
    </Border>
   </Grid>

   <Border Margin="0,14,0,0" Padding="22" Background="#F8FAFC" CornerRadius="12" BorderBrush="#DDE3EA" BorderThickness="1">
    <StackPanel HorizontalAlignment="Stretch"
                TextBlock.TextAlignment="Left">
     <TextBlock FontSize="18" FontWeight="Bold" Text="Acknowledgements"/>
     <TextBlock Margin="0,10,0,0" LineHeight="22" TextWrapping="Wrap"
                Text="Built with WPF, .NET and CommunityToolkit.Mvvm. AdGuard Home is a product of AdGuard Software Ltd. GL.iNet is a trademark of GL Technologies. AdGuardTray is an independent project and is not affiliated with or endorsed by either company."/>
    </StackPanel>
   </Border>
   </StackPanel>
  </Grid>
 </ScrollViewer>
</UserControl>