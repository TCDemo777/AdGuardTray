<UserControl x:Class="AdGuardTray.Views.AboutView"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <ScrollViewer VerticalScrollBarVisibility="Auto"
               HorizontalScrollBarVisibility="Disabled"
               HorizontalContentAlignment="Stretch">
  <Grid HorizontalAlignment="Stretch">
   <Grid.RowDefinitions>
    <RowDefinition Height="Auto"/>
    <RowDefinition Height="14"/>
    <RowDefinition Height="Auto"/>
    <RowDefinition Height="14"/>
    <RowDefinition Height="Auto"/>
    <RowDefinition Height="14"/>
    <RowDefinition Height="Auto"/>
   </Grid.RowDefinitions>

   <StackPanel>
    <TextBlock FontSize="28"
               FontWeight="Bold"
               Text="About AdGuardTray"/>
    <TextBlock Margin="0,6,0,0"
               FontSize="14"
               Foreground="#5B6472"
               Text="A native Windows console for GL.iNet routers and AdGuard Home."/>
   </StackPanel>

   <Border Grid.Row="2"
           Padding="22"
           Background="White"
           CornerRadius="12"
           BorderBrush="#DDE3EA"
           BorderThickness="1">
    <Grid>
     <Grid.ColumnDefinitions>
      <ColumnDefinition Width="96"/>
      <ColumnDefinition Width="18"/>
      <ColumnDefinition Width="*"/>
     </Grid.ColumnDefinitions>

     <Image Width="88"
            Height="88"
            HorizontalAlignment="Left"
            VerticalAlignment="Top"
            Stretch="Uniform"
            Source="/Assets/AdGuardTrayLogo.png"/>

     <StackPanel Grid.Column="2"
                 HorizontalAlignment="Stretch"
                 VerticalAlignment="Top"
                 TextBlock.TextAlignment="Left">
      <TextBlock FontSize="26"
                 FontWeight="Bold"
                 HorizontalAlignment="Left"
                 Text="AdGuardTray"/>
      <TextBlock Margin="0,4,0,0"
                 HorizontalAlignment="Left"
                 Foreground="#5B6472"
                 Text="Version 1.0"/>
      <TextBlock Margin="0,12,0,0"
                 HorizontalAlignment="Stretch"
                 FontSize="15"
                 LineHeight="22"
                 TextAlignment="Left"
                 TextWrapping="Wrap"
                 Text="Router health, AdGuard Home protection, analytics, clients, live DNS logs and network administration in one focused desktop application."/>
      <TextBlock Margin="0,12,0,0"
                 HorizontalAlignment="Left"
                 FontSize="15"
                 FontWeight="SemiBold"
                 Text="Created by Tristan Caldwell"/>
      <TextBlock Margin="0,5,0,0"
                 HorizontalAlignment="Left">
       <Hyperlink NavigateUri="https://github.com/TCDemo777"
                  RequestNavigate="GitHubLink_RequestNavigate">github.com/TCDemo777</Hyperlink>
      </TextBlock>
     </StackPanel>
    
   <Border Grid.Row="6"
           Margin="0,14,0,0"
           Padding="20"
           Background="White"
           CornerRadius="12"
           BorderBrush="#DDE3EA"
           BorderThickness="1">
    <StackPanel>
      <TextBlock FontSize="18" FontWeight="Bold" Text="Release Notes"/>
      <TextBlock Margin="0,8,0,0" Foreground="#667085"
                 TextWrapping="Wrap"
                 Text="A full CHANGELOG.md is now included with the application source."/>
      <TextBlock Margin="0,10,0,0" FontWeight="SemiBold" Text="Current Version (1.0 RC)"/>
      <TextBlock Margin="0,6,0,0" TextWrapping="Wrap"
                 Text="• Global Search&#x0a;• Analytics Dashboard&#x0a;• Live DNS Logs&#x0a;• Client Intelligence&#x0a;• Network Monitoring&#x0a;• CSV / JSON Export&#x0a;• UI Polish"/>
      <TextBlock Margin="0,12,0,0" FontWeight="SemiBold" Text="Previous Milestones"/>
      <TextBlock Margin="0,6,0,0" TextWrapping="Wrap"
                 Text="0.9 – Protection, Clients, Settings redesign&#x0a;0.8 – Dashboard, statistics and charts&#x0a;0.7 – SSH connectivity and router integration&#x0a;Prototype – Initial GL.iNet and AdGuard Home support"/>
    </StackPanel>
   </Border>

 </Grid>
   </Border>

   <Grid Grid.Row="4">
    <Grid.ColumnDefinitions>
     <ColumnDefinition Width="*"/>
     <ColumnDefinition Width="14"/>
     <ColumnDefinition Width="*"/>
    </Grid.ColumnDefinitions>

    <Border Padding="20"
            Background="White"
            CornerRadius="12"
            BorderBrush="#DDE3EA"
            BorderThickness="1">
     <StackPanel HorizontalAlignment="Stretch"
                 TextBlock.TextAlignment="Left">
      <TextBlock FontSize="18"
                 FontWeight="Bold"
                 HorizontalAlignment="Left"
                 Text="Features"/>
      <TextBlock Margin="0,10,0,0"
                 HorizontalAlignment="Stretch"
                 LineHeight="21"
                 TextAlignment="Left"
                 TextWrapping="Wrap"
                 Text="• Live router, internet and AdGuard health&#x0a;• Protection controls and timed pauses&#x0a;• Blocked services, DNS rewrites and custom rules&#x0a;• Client intelligence and favourites&#x0a;• Live DNS logs, global search and exports"/>
     </StackPanel>
    </Border>

    <Border Grid.Column="2"
            Padding="20"
            Background="White"
            CornerRadius="12"
            BorderBrush="#DDE3EA"
            BorderThickness="1">
     <StackPanel HorizontalAlignment="Stretch"
                 TextBlock.TextAlignment="Left">
      <TextBlock FontSize="18"
                 FontWeight="Bold"
                 HorizontalAlignment="Left"
                 Text="Privacy and security"/>
      <TextBlock Margin="0,10,0,0"
                 HorizontalAlignment="Stretch"
                 LineHeight="21"
                 TextAlignment="Left"
                 TextWrapping="Wrap"
                 Text="AdGuardTray connects directly to the router configured in Settings. Saved passwords use Windows Data Protection and remain tied to the current Windows user. Search and manufacturer detection run locally."/>
     </StackPanel>
    </Border>
   </Grid>

   <Border Grid.Row="6"
           Padding="20"
           Background="#F8FAFC"
           CornerRadius="12"
           BorderBrush="#DDE3EA"
           BorderThickness="1">
    <StackPanel HorizontalAlignment="Stretch"
                TextBlock.TextAlignment="Left">
     <TextBlock FontSize="18"
                FontWeight="Bold"
                HorizontalAlignment="Left"
                Text="Acknowledgements"/>
     <TextBlock Margin="0,9,0,0"
                HorizontalAlignment="Stretch"
                LineHeight="21"
                TextAlignment="Left"
                TextWrapping="Wrap"
                Text="Built with WPF, .NET and CommunityToolkit.Mvvm. AdGuard Home is a product of AdGuard Software Ltd. GL.iNet is a trademark of GL Technologies. AdGuardTray is an independent project and is not affiliated with or endorsed by either company."/>
    </StackPanel>
   </Border>
  </Grid>
 </ScrollViewer>
</UserControl>
