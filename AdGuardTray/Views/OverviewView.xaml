<UserControl x:Class="AdGuardTray.Views.OverviewView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Padding" Value="14"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="BorderBrush" Value="#DDE3EA"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>
        <Style x:Key="DetailLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="#667085"/>
            <Setter Property="Margin" Value="0,6,0,1"/>
        </Style>
        <Style x:Key="DetailValue" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="10"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="10"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock FontSize="24"
                       FontWeight="Bold"
                       Text="Overview"/>
            <TextBlock Margin="0,4,0,0"
                       FontSize="14"
                       Foreground="#667085"
                       Text="Router, AdGuard Home and internet health at a glance"/>
        </StackPanel>

        <UniformGrid Grid.Row="2"
                     Columns="5">
            <Border Margin="0,0,5,0" Padding="10" Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock FontSize="11" Foreground="#667085" Text="ROUTER"/>
                    <TextBlock Margin="0,3,0,0"
                               FontWeight="SemiBold"
                               Foreground="{Binding RouterStatusColour}"
                               Text="{Binding RouterStatusText}"/>
                </StackPanel>
            </Border>
            <Border Margin="2.5,0" Padding="10" Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock FontSize="11" Foreground="#667085" Text="ADGUARD"/>
                    <TextBlock Margin="0,3,0,0"
                               FontWeight="SemiBold"
                               Foreground="{Binding AdGuardStatusColour}"
                               Text="{Binding AdGuardStatusText}"/>
                </StackPanel>
            </Border>
            <Border Margin="2.5,0" Padding="10" Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock FontSize="11" Foreground="#667085" Text="INTERNET"/>
                    <TextBlock Margin="0,3,0,0"
                               FontWeight="SemiBold"
                               Foreground="{Binding InternetStatusColour}"
                               Text="{Binding InternetStatusText}"/>
                </StackPanel>
            </Border>
            <Border Margin="2.5,0" Padding="10" Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock FontSize="11" Foreground="#667085" Text="CPU"/>
                    <TextBlock Margin="0,3,0,0"
                               FontWeight="SemiBold"
                               Foreground="{Binding CpuHealthColour}"
                               Text="{Binding CpuHealthText}"/>
                </StackPanel>
            </Border>
            <Border Margin="5,0,0,0" Padding="10" Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock FontSize="11" Foreground="#667085" Text="MEMORY"/>
                    <TextBlock Margin="0,3,0,0"
                               FontWeight="SemiBold"
                               Foreground="{Binding MemoryHealthColour}"
                               Text="{Binding MemoryHealthText}"/>
                </StackPanel>
            </Border>
        </UniformGrid>

        <Grid Grid.Row="4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="10"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="10"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Style="{StaticResource Card}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="8"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <DockPanel>
                        <TextBlock FontSize="17"
                                   FontWeight="Bold"
                                   Text="Router"/>
                        <TextBlock DockPanel.Dock="Right"
                                   FontWeight="SemiBold"
                                   Foreground="{Binding RouterStatusColour}"
                                   Text="{Binding RouterStatusText}"/>
                    </DockPanel>
                    <UniformGrid Grid.Row="2" Rows="6">
                        <StackPanel>
                            <TextBlock Style="{StaticResource DetailLabel}" Text="Model"/>
                            <TextBlock Style="{StaticResource DetailValue}" Text="{Binding RouterModel}"/>
                        </StackPanel>
                        <StackPanel>
                            <TextBlock Style="{StaticResource DetailLabel}" Text="Firmware"/>
                            <TextBlock Style="{StaticResource DetailValue}" Text="{Binding FirmwareVersion}"/>
                        </StackPanel>
                        <StackPanel>
                            <TextBlock Style="{StaticResource DetailLabel}" Text="Hostname"/>
                            <TextBlock Style="{StaticResource DetailValue}" Text="{Binding Hostname}"/>
                        </StackPanel>
                        <StackPanel>
                            <TextBlock Style="{StaticResource DetailLabel}" Text="Uptime"/>
                            <TextBlock Style="{StaticResource DetailValue}" Text="{Binding Uptime}"/>
                        </StackPanel>
                        <StackPanel>
                            <TextBlock Style="{StaticResource DetailLabel}" Text="CPU usage"/>
                            <ProgressBar Height="10" Margin="0,3,0,2"
                                         Minimum="0" Maximum="100"
                                         Value="{Binding CpuPercentage}"/>
                            <TextBlock Style="{StaticResource DetailValue}" Text="{Binding CpuUsage}"/>
                        </StackPanel>
                        <StackPanel>
                            <TextBlock Style="{StaticResource DetailLabel}" Text="Memory usage"/>
                            <ProgressBar Height="10" Margin="0,3,0,2"
                                         Minimum="0" Maximum="100"
                                         Value="{Binding MemoryPercentage}"/>
                            <TextBlock Style="{StaticResource DetailValue}" Text="{Binding MemoryUsage}"/>
                        </StackPanel>
                    </UniformGrid>
                </Grid>
            </Border>

            <Border Grid.Column="2" Style="{StaticResource Card}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="8"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <DockPanel>
                        <TextBlock FontSize="17"
                                   FontWeight="Bold"
                                   Text="AdGuard Home"/>
                        <TextBlock DockPanel.Dock="Right"
                                   FontWeight="SemiBold"
                                   Foreground="{Binding AdGuardStatusColour}"
                                   Text="{Binding AdGuardStatusText}"/>
                    </DockPanel>
                    <UniformGrid Grid.Row="2" Rows="7">
                        <StackPanel>
                            <TextBlock Style="{StaticResource DetailLabel}" Text="Protection"/>
                            <TextBlock Style="{StaticResource DetailValue}"
                                       Foreground="{Binding AdGuardProtectionStatusColour}"
                                       Text="{Binding AdGuardProtectionStatusText}"/>
                        </StackPanel>
                        <StackPanel>
                            <TextBlock Style="{StaticResource DetailLabel}" Text="Version"/>
                            <TextBlock Style="{StaticResource DetailValue}" Text="{Binding AdGuardVersion}"/>
                        </StackPanel>
                        <StackPanel>
                            <TextBlock Style="{StaticResource DetailLabel}" Text="Service"/>
                            <TextBlock Style="{StaticResource DetailValue}" Text="{Binding AdGuardService}"/>
                        </StackPanel>
                        <StackPanel>
                            <TextBlock Style="{StaticResource DetailLabel}" Text="Process"/>
                            <TextBlock Style="{StaticResource DetailValue}" Text="{Binding AdGuardProcess}"/>
                        </StackPanel>
                        <StackPanel>
                            <TextBlock Style="{StaticResource DetailLabel}" Text="Queries"/>
                            <TextBlock Style="{StaticResource DetailValue}" Text="{Binding AdGuardQueries}"/>
                        </StackPanel>
                        <StackPanel>
                            <TextBlock Style="{StaticResource DetailLabel}" Text="Blocked"/>
                            <TextBlock Style="{StaticResource DetailValue}"
                                       Foreground="#C62828"
                                       Text="{Binding AdGuardBlocked}"/>
                        </StackPanel>
                        <StackPanel>
                            <TextBlock Style="{StaticResource DetailLabel}" Text="Blocking rate"/>
                            <TextBlock Style="{StaticResource DetailValue}" Text="{Binding AdGuardBlockRate}"/>
                        </StackPanel>
                    </UniformGrid>
                </Grid>
            </Border>

            <Border Grid.Column="4" Style="{StaticResource Card}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="8"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <DockPanel>
                        <TextBlock FontSize="17"
                                   FontWeight="Bold"
                                   Text="Internet"/>
                        <TextBlock DockPanel.Dock="Right"
                                   FontWeight="SemiBold"
                                   Foreground="{Binding InternetStatusColour}"
                                   Text="{Binding InternetStatusText}"/>
                    </DockPanel>
                    <UniformGrid Grid.Row="2" Rows="7">
                        <StackPanel>
                            <TextBlock Style="{StaticResource DetailLabel}" Text="WAN address"/>
                            <TextBlock Style="{StaticResource DetailValue}" Text="{Binding WanIp}"/>
                        </StackPanel>
                        <StackPanel>
                            <TextBlock Style="{StaticResource DetailLabel}" Text="Gateway"/>
                            <TextBlock Style="{StaticResource DetailValue}" Text="{Binding Gateway}"/>
                        </StackPanel>
                        <StackPanel>
                            <TextBlock Style="{StaticResource DetailLabel}" Text="External DNS"/>
                            <TextBlock Style="{StaticResource DetailValue}" Text="{Binding ExternalDns}"/>
                        </StackPanel>
                        <StackPanel>
                            <TextBlock Style="{StaticResource DetailLabel}" Text="Advertised DNS"/>
                            <TextBlock Style="{StaticResource DetailValue}" Text="{Binding AdvertisedDns}"/>
                        </StackPanel>
                        <StackPanel>
                            <TextBlock Style="{StaticResource DetailLabel}" Text="Latency"/>
                            <TextBlock Style="{StaticResource DetailValue}" Text="{Binding Latency}"/>
                        </StackPanel>
                        <StackPanel>
                            <TextBlock Style="{StaticResource DetailLabel}" Text="Storage"/>
                            <ProgressBar Height="10" Margin="0,3,0,2"
                                         Minimum="0" Maximum="100"
                                         Value="{Binding StoragePercentage}"/>
                            <TextBlock Style="{StaticResource DetailValue}" Text="{Binding StorageUsage}"/>
                        </StackPanel>
                        <StackPanel>
                            <TextBlock Style="{StaticResource DetailLabel}" Text="Available storage"/>
                            <TextBlock Style="{StaticResource DetailValue}" Text="{Binding StorageAvailable}"/>
                        </StackPanel>
                    </UniformGrid>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
