<UserControl x:Class="AdGuardTray.Views.OverviewView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="16"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Page heading -->

        <StackPanel Grid.Row="0">

            <TextBlock
                FontSize="24"
                FontWeight="Bold"
                Text="Overview"/>

            <TextBlock
                Margin="0,5,0,0"
                FontSize="14"
                Foreground="#666666"
                Text="Current router, AdGuard Home and internet status"/>

        </StackPanel>

        <!-- Overview cards -->

        <UniformGrid
            Grid.Row="2"
            Columns="3">

            <!-- Router -->

            <Border
                Margin="6"
                Padding="16"
                Background="White"
                CornerRadius="10"
                BorderBrush="#DDDDDD"
                BorderThickness="1">

                <StackPanel>

                    <TextBlock
                        FontSize="18"
                        FontWeight="Bold"
                        Text="Router"/>

                    <Separator Margin="0,8"/>

                    <TextBlock
                        FontWeight="SemiBold"
                        Text="{Binding RouterStatusText}"/>

                    <TextBlock
                        Margin="0,10,0,0"
                        Text="Model"/>

                    <TextBlock
                        FontWeight="SemiBold"
                        Text="{Binding RouterModel}"/>

                    <TextBlock
                        Margin="0,8,0,0"
                        Text="Firmware"/>

                    <TextBlock
                        FontWeight="SemiBold"
                        Text="{Binding FirmwareVersion}"/>

                    <TextBlock
                        Margin="0,8,0,0"
                        Text="Hostname"/>

                    <TextBlock
                        FontWeight="SemiBold"
                        Text="{Binding Hostname}"/>

                    <TextBlock
                        Margin="0,8,0,0"
                        Text="Since Boot"/>

                    <TextBlock
                        FontWeight="SemiBold"
                        Text="{Binding Uptime}"/>

                    <TextBlock
                        Margin="0,8,0,0"
                        Text="CPU Usage"/>

                    <ProgressBar
                        Height="14"
                        Margin="0,5,0,0"
                        Minimum="0"
                        Maximum="100"
                        Value="{Binding CpuPercentage}"/>

                    <TextBlock
                        Margin="0,3,0,0"
                        FontWeight="SemiBold"
                        Text="{Binding CpuUsage}"/>

                    <TextBlock
                        Margin="0,12,0,0"
                        Text="Memory Usage"/>

                    <ProgressBar
                        Height="14"
                        Margin="0,5,0,0"
                        Minimum="0"
                        Maximum="100"
                        Value="{Binding MemoryPercentage}"/>

                    <TextBlock
                        Margin="0,3,0,0"
                        FontWeight="SemiBold"
                        Text="{Binding MemoryUsage}"/>

                </StackPanel>

            </Border>

            <!-- AdGuard Home -->

            <Border
                Margin="6"
                Padding="16"
                Background="White"
                CornerRadius="10"
                BorderBrush="#DDDDDD"
                BorderThickness="1">

                <StackPanel>

                    <TextBlock
                        FontSize="18"
                        FontWeight="Bold"
                        Text="AdGuard Home"/>

                    <Separator Margin="0,8"/>

                    <TextBlock
                        FontWeight="SemiBold"
                        Text="{Binding AdGuardStatusText}"/>

                    <TextBlock
                        Margin="0,10,0,0"
                        Text="Version"/>

                    <TextBlock
                        FontWeight="SemiBold"
                        Text="{Binding AdGuardVersion}"/>

                    <TextBlock
                        Margin="0,8,0,0"
                        Text="Service"/>

                    <TextBlock
                        FontWeight="SemiBold"
                        Text="{Binding AdGuardService}"/>

                    <TextBlock
                        Margin="0,8,0,0"
                        Text="Process"/>

                    <TextBlock
                        FontWeight="SemiBold"
                        Text="{Binding AdGuardProcess}"/>

                    <TextBlock
                        Margin="0,8,0,0"
                        Text="Queries Today"/>

                    <TextBlock
                        FontWeight="SemiBold"
                        Text="{Binding AdGuardQueries}"/>

                    <TextBlock
                        Margin="0,8,0,0"
                        Text="Blocked"/>

                    <TextBlock
                        FontWeight="SemiBold"
                        Text="{Binding AdGuardBlocked}"/>

                    <TextBlock
                        Margin="0,8,0,0"
                        Text="Block Rate"/>

                    <TextBlock
                        FontWeight="SemiBold"
                        Text="{Binding AdGuardBlockRate}"/>

                </StackPanel>

            </Border>

            <!-- Internet -->

            <Border
                Margin="6"
                Padding="16"
                Background="White"
                CornerRadius="10"
                BorderBrush="#DDDDDD"
                BorderThickness="1">

                <StackPanel>

                    <TextBlock
                        FontSize="18"
                        FontWeight="Bold"
                        Text="Internet"/>

                    <Separator Margin="0,8"/>

                    <TextBlock
                        FontWeight="SemiBold"
                        Text="{Binding InternetStatusText}"/>

                    <TextBlock
                        Margin="0,10,0,0"
                        Text="WAN IP"/>

                    <TextBlock
                        FontWeight="SemiBold"
                        Text="{Binding WanIp}"/>

                    <TextBlock
                        Margin="0,8,0,0"
                        Text="Gateway"/>

                    <TextBlock
                        FontWeight="SemiBold"
                        Text="{Binding Gateway}"/>

                    <TextBlock
                        Margin="0,8,0,0"
                        Text="External DNS"/>

                    <TextBlock
                        FontWeight="SemiBold"
                        Text="{Binding ExternalDns}"/>

                    <TextBlock
                        Margin="0,8,0,0"
                        Text="Advertised DNS"/>

                    <TextBlock
                        FontWeight="SemiBold"
                        Text="{Binding AdvertisedDns}"/>

                    <TextBlock
                        Margin="0,8,0,0"
                        Text="Latency"/>

                    <TextBlock
                        FontWeight="SemiBold"
                        Text="{Binding Latency}"/>

                </StackPanel>

            </Border>

        </UniformGrid>

    </Grid>

</UserControl>