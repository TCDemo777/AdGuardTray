<UserControl x:Class="AdGuardTray.Views.OverviewView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="12"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="12"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <TextBlock FontSize="24"
                       FontWeight="Bold"
                       Text="Overview"/>

            <TextBlock Margin="0,5,0,0"
                       FontSize="14"
                       Foreground="#666666"
                       Text="Current router, AdGuard Home and internet status"/>
        </StackPanel>

        <UniformGrid Grid.Row="2" Columns="5">
            <Border Margin="0,0,6,0" Padding="11" Background="White"
                    CornerRadius="9" BorderBrush="#DDE3EA" BorderThickness="1">
                <StackPanel>
                    <TextBlock FontSize="12" Foreground="#667085" Text="ROUTER"/>
                    <TextBlock Margin="0,4,0,0" FontWeight="SemiBold"
                               Foreground="{Binding RouterStatusColour}"
                               Text="{Binding RouterStatusText}"/>
                </StackPanel>
            </Border>
            <Border Margin="3,0" Padding="11" Background="White"
                    CornerRadius="9" BorderBrush="#DDE3EA" BorderThickness="1">
                <StackPanel>
                    <TextBlock FontSize="12" Foreground="#667085" Text="ADGUARD"/>
                    <TextBlock Margin="0,4,0,0" FontWeight="SemiBold"
                               Foreground="{Binding AdGuardStatusColour}"
                               Text="{Binding AdGuardStatusText}"/>
                </StackPanel>
            </Border>
            <Border Margin="3,0" Padding="11" Background="White"
                    CornerRadius="9" BorderBrush="#DDE3EA" BorderThickness="1">
                <StackPanel>
                    <TextBlock FontSize="12" Foreground="#667085" Text="INTERNET"/>
                    <TextBlock Margin="0,4,0,0" FontWeight="SemiBold"
                               Foreground="{Binding InternetStatusColour}"
                               Text="{Binding InternetStatusText}"/>
                </StackPanel>
            </Border>
            <Border Margin="3,0" Padding="11" Background="White"
                    CornerRadius="9" BorderBrush="#DDE3EA" BorderThickness="1">
                <StackPanel>
                    <TextBlock FontSize="12" Foreground="#667085" Text="CPU"/>
                    <TextBlock Margin="0,4,0,0" FontWeight="SemiBold"
                               Foreground="{Binding CpuHealthColour}"
                               Text="{Binding CpuHealthText}"/>
                </StackPanel>
            </Border>
            <Border Margin="6,0,0,0" Padding="11" Background="White"
                    CornerRadius="9" BorderBrush="#DDE3EA" BorderThickness="1">
                <StackPanel>
                    <TextBlock FontSize="12" Foreground="#667085" Text="MEMORY"/>
                    <TextBlock Margin="0,4,0,0" FontWeight="SemiBold"
                               Foreground="{Binding MemoryHealthColour}"
                               Text="{Binding MemoryHealthText}"/>
                </StackPanel>
            </Border>
        </UniformGrid>

        <ScrollViewer Grid.Row="4"
                      VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <UniformGrid Columns="3">
                    <Border Margin="6"
                            Padding="14"
                            Background="White"
                            CornerRadius="10"
                            BorderBrush="#DDDDDD"
                            BorderThickness="1">
                        <StackPanel>
                            <TextBlock FontSize="18"
                                       FontWeight="Bold"
                                       Text="Router"/>
                            <Separator Margin="0,8"/>
                            <Border Margin="0,2,0,2"
                                    Padding="10,5"
                                    HorizontalAlignment="Left"
                                    Background="#F6F8FA"
                                    CornerRadius="12">
                                <TextBlock FontWeight="SemiBold"
                                           Foreground="{Binding RouterStatusColour}"
                                           Text="{Binding RouterStatusText}"/>
                            </Border>
                            <TextBlock Margin="0,10,0,0" Text="Model"/>
                            <TextBlock FontWeight="SemiBold" Text="{Binding RouterModel}"/>
                            <TextBlock Margin="0,8,0,0" Text="Firmware"/>
                            <TextBlock FontWeight="SemiBold" Text="{Binding FirmwareVersion}"/>
                            <TextBlock Margin="0,8,0,0" Text="Hostname"/>
                            <TextBlock FontWeight="SemiBold" Text="{Binding Hostname}"/>
                            <TextBlock Margin="0,8,0,0" Text="Since Boot"/>
                            <TextBlock FontWeight="SemiBold" Text="{Binding Uptime}"/>
                            <TextBlock Margin="0,8,0,0" Text="CPU Usage"/>
                            <ProgressBar Height="14"
                                         Margin="0,5,0,0"
                                         Minimum="0"
                                         Maximum="100"
                                         Value="{Binding CpuPercentage}"/>
                            <TextBlock Margin="0,3,0,0"
                                       FontWeight="SemiBold"
                                       Text="{Binding CpuUsage}"/>
                            <TextBlock Margin="0,12,0,0" Text="Memory Usage"/>
                            <ProgressBar Height="14"
                                         Margin="0,5,0,0"
                                         Minimum="0"
                                         Maximum="100"
                                         Value="{Binding MemoryPercentage}"/>
                            <TextBlock Margin="0,3,0,0"
                                       FontWeight="SemiBold"
                                       Text="{Binding MemoryUsage}"/>
                        </StackPanel>
                    </Border>

                    <Border Margin="6"
                            Padding="14"
                            Background="White"
                            CornerRadius="10"
                            BorderBrush="#DDDDDD"
                            BorderThickness="1">
                        <StackPanel>
                            <TextBlock FontSize="18"
                                       FontWeight="Bold"
                                       Text="AdGuard Home"/>
                            <Separator Margin="0,8"/>
                            <Border Margin="0,2,0,2"
                                    Padding="10,5"
                                    HorizontalAlignment="Left"
                                    Background="#F6F8FA"
                                    CornerRadius="12">
                                <TextBlock FontWeight="SemiBold"
                                           Foreground="{Binding AdGuardStatusColour}"
                                           Text="{Binding AdGuardStatusText}"/>
                            </Border>
                            <TextBlock Margin="0,10,0,0" Text="Protection"/>
                            <Border Margin="0,2,0,2"
                                    Padding="10,5"
                                    HorizontalAlignment="Left"
                                    Background="#F6F8FA"
                                    CornerRadius="12">
                                <TextBlock FontWeight="SemiBold"
                                           Foreground="{Binding AdGuardProtectionStatusColour}"
                                           Text="{Binding AdGuardProtectionStatusText}"/>
                            </Border>
                            <TextBlock Margin="0,4,0,0"
                                       Foreground="#687386"
                                       Text="{Binding AdGuardProtectionRemaining}"/>
                            <TextBlock Margin="0,6,0,0" Text="Version"/>
                            <TextBlock FontWeight="SemiBold" Text="{Binding AdGuardVersion}"/>
                            <TextBlock Margin="0,8,0,0" Text="Service"/>
                            <TextBlock FontWeight="SemiBold" Text="{Binding AdGuardService}"/>
                            <TextBlock Margin="0,8,0,0" Text="Process"/>
                            <TextBlock FontWeight="SemiBold" Text="{Binding AdGuardProcess}"/>
                            <TextBlock Margin="0,8,0,0" Text="Queries Today"/>
                            <TextBlock FontWeight="SemiBold" Text="{Binding AdGuardQueries}"/>
                            <TextBlock Margin="0,8,0,0" Text="Blocked"/>
                            <TextBlock FontWeight="SemiBold" Text="{Binding AdGuardBlocked}"/>
                            <TextBlock Margin="0,8,0,0" Text="Block Rate"/>
                            <TextBlock FontWeight="SemiBold" Text="{Binding AdGuardBlockRate}"/>
                        </StackPanel>
                    </Border>

                    <Border Margin="6"
                            Padding="14"
                            Background="White"
                            CornerRadius="10"
                            BorderBrush="#DDDDDD"
                            BorderThickness="1">
                        <StackPanel>
                            <TextBlock FontSize="18"
                                       FontWeight="Bold"
                                       Text="Internet"/>
                            <Separator Margin="0,8"/>
                            <Border Margin="0,2,0,2"
                                    Padding="10,5"
                                    HorizontalAlignment="Left"
                                    Background="#F6F8FA"
                                    CornerRadius="12">
                                <TextBlock FontWeight="SemiBold"
                                           Foreground="{Binding InternetStatusColour}"
                                           Text="{Binding InternetStatusText}"/>
                            </Border>
                            <TextBlock Margin="0,10,0,0" Text="WAN IP"/>
                            <TextBlock FontWeight="SemiBold" Text="{Binding WanIp}"/>
                            <TextBlock Margin="0,8,0,0" Text="Gateway"/>
                            <TextBlock FontWeight="SemiBold" Text="{Binding Gateway}"/>
                            <TextBlock Margin="0,8,0,0" Text="External DNS"/>
                            <TextBlock FontWeight="SemiBold" Text="{Binding ExternalDns}"/>
                            <TextBlock Margin="0,8,0,0" Text="Advertised DNS"/>
                            <TextBlock FontWeight="SemiBold" Text="{Binding AdvertisedDns}"/>
                            <TextBlock Margin="0,8,0,0" Text="Latency"/>
                            <TextBlock FontWeight="SemiBold" Text="{Binding Latency}"/>
                        </StackPanel>
                    </Border>
                </UniformGrid>


            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
