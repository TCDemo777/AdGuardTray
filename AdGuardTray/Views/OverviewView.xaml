<UserControl
    x:Class="AdGuardTray.Views.OverviewView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:AdGuardTray.Controls">

    <UserControl.Resources>
        <Style x:Key="Overview.DetailLabel" TargetType="TextBlock" BasedOn="{StaticResource Text.Secondary}">
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style x:Key="Overview.DetailValue" TargetType="TextBlock" BasedOn="{StaticResource Text.Body}">
            <Setter Property="HorizontalAlignment" Value="Right" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="TextAlignment" Value="Right" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>

        <Style x:Key="Overview.DetailRow" TargetType="Grid">
            <Setter Property="Margin" Value="0,0,0,12" />
        </Style>

        <Style x:Key="Overview.ProgressBar" TargetType="ProgressBar" BasedOn="{StaticResource Leaderboard.Track}">
            <Setter Property="Height" Value="8" />
            <Setter Property="Margin" Value="0,7,0,0" />
        </Style>

        <Style x:Key="Overview.StatusBadge" TargetType="Border">
            <Setter Property="Padding" Value="10,5" />
            <Setter Property="Background" Value="{StaticResource Brush.SurfaceMuted}" />
            <Setter Property="BorderBrush" Value="{StaticResource Brush.Border}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style x:Key="Overview.CardHeading" TargetType="TextBlock" BasedOn="{StaticResource Text.SectionTitle}">
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="0,0,6,24">

            <!-- Page heading -->
            <Grid Margin="0,0,0,18">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel>
                    <TextBlock
                        Style="{StaticResource Text.PageTitle}"
                        Text="Overview" />
                    <TextBlock
                        Margin="0,5,0,0"
                        Style="{StaticResource Text.Secondary}"
                        Text="Router, AdGuard Home and internet health at a glance" />
                </StackPanel>

                <StackPanel
                    Grid.Column="1"
                    Margin="24,0,0,0"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center">
                    <TextBlock
                        HorizontalAlignment="Right"
                        Style="{StaticResource Text.CardCaption}"
                        Text="LAST REFRESH" />
                    <TextBlock
                        Margin="0,3,0,0"
                        HorizontalAlignment="Right"
                        Style="{StaticResource Text.Secondary}"
                        Text="{Binding LastRefresh}" />
                </StackPanel>
            </Grid>

            <!-- Health summary -->
            <TextBlock
                Margin="0,0,0,12"
                Style="{StaticResource Text.SectionTitle}"
                Text="System health" />

            <Grid Margin="0,0,0,14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="8" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="8" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="8" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="8" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <controls:StatisticCard
                    Grid.Column="0"
                    Height="146"
                    AccentBrush="{Binding RouterStatusColour}"
                    FooterText="{Binding RouterModel}"
                    IconBackground="{DynamicResource Brush.PrimarySubtle}"
                    IconGlyph="&#xE968;"
                    Subtitle="Router connection"
                    Title="ROUTER"
                    Value="{Binding RouterStatusText}" />

                <controls:StatisticCard
                    Grid.Column="2"
                    Height="146"
                    AccentBrush="{Binding AdGuardStatusColour}"
                    FooterText="{Binding AdGuardVersion}"
                    IconBackground="{DynamicResource Brush.SuccessSubtle}"
                    IconGlyph="&#xE72E;"
                    Subtitle="DNS filtering"
                    Title="ADGUARD"
                    Value="{Binding AdGuardStatusText}" />

                <controls:StatisticCard
                    Grid.Column="4"
                    Height="146"
                    AccentBrush="{Binding InternetStatusColour}"
                    FooterText="{Binding Latency}"
                    IconBackground="{DynamicResource Brush.PrimarySubtle}"
                    IconGlyph="&#xE774;"
                    Subtitle="WAN connectivity"
                    Title="INTERNET"
                    Value="{Binding InternetStatusText}" />

                <controls:StatisticCard
                    Grid.Column="6"
                    Height="146"
                    AccentBrush="{Binding CpuHealthColour}"
                    FooterText="{Binding CpuUsage}"
                    IconBackground="{DynamicResource Brush.WarningSubtle}"
                    IconGlyph="&#xE950;"
                    Subtitle="Processor load"
                    Title="CPU"
                    Value="{Binding CpuHealthText}" />

                <controls:StatisticCard
                    Grid.Column="8"
                    Height="146"
                    AccentBrush="{Binding MemoryHealthColour}"
                    FooterText="{Binding MemoryUsage}"
                    IconBackground="{DynamicResource Brush.PrimarySubtle}"
                    IconGlyph="&#xE7F8;"
                    Subtitle="Memory usage"
                    Title="MEMORY"
                    Value="{Binding MemoryHealthText}" />
            </Grid>

            <!-- Rule-based insights -->
            <Border Margin="0,0,0,18" Style="{StaticResource Card}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="14" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <StackPanel Orientation="Horizontal">
                        <Border
                            Width="38"
                            Height="38"
                            Margin="0,0,12,0"
                            Background="{DynamicResource Brush.PrimarySubtle}"
                            CornerRadius="10">
                            <TextBlock
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                FontSize="18"
                                Foreground="{DynamicResource Brush.Primary}"
                                Text="&#xE946;" />
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Style="{StaticResource Overview.CardHeading}" Text="Insights" />
                            <TextBlock Style="{StaticResource Text.Secondary}"
                                       Text="Current observations from RouterPilot's health rules" />
                        </StackPanel>
                    </StackPanel>

                    <TextBlock Grid.Row="2" Text="Everything looks healthy.">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource Text.Secondary}">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasInsights}" Value="False">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>

                    <ItemsControl Grid.Row="2" ItemsSource="{Binding Insights}">
                        <ItemsControl.Style>
                            <Style TargetType="ItemsControl">
                                <Setter Property="Visibility" Value="Visible" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasInsights}" Value="False">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ItemsControl.Style>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="5" />
                                        <ColumnDefinition Width="12" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Border CornerRadius="3">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="{DynamicResource Brush.Primary}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Severity}" Value="Warning">
                                                        <Setter Property="Background" Value="{DynamicResource Brush.Warning}" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Severity}" Value="Critical">
                                                        <Setter Property="Background" Value="{DynamicResource Brush.Danger}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                    </Border>
                                    <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                        <TextBlock Style="{StaticResource Text.Body}"
                                                   FontWeight="SemiBold"
                                                   Text="{Binding Title}" />
                                        <TextBlock Margin="0,3,0,0"
                                                   Style="{StaticResource Text.Secondary}"
                                                   Text="{Binding Description}" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="3"
                                                Margin="16,0,0,0"
                                                HorizontalAlignment="Right"
                                                VerticalAlignment="Center">
                                        <TextBlock HorizontalAlignment="Right"
                                                   Style="{StaticResource Text.Muted}"
                                                   Text="{Binding Category}" />
                                        <Button Margin="0,6,0,0"
                                                MinWidth="108"
                                                Padding="12,6"
                                                Command="{Binding DataContext.ExecuteInsightActionCommand,
                                                    RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                CommandParameter="{Binding}"
                                                Content="{Binding ActionLabel}">
                                            <Button.Style>
                                                <Style TargetType="Button" BasedOn="{StaticResource Button.Secondary}">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding CanExecuteAction}" Value="False">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                        </Button>
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Grid>
            </Border>

            <!-- Weekly history summary -->
            <Border Margin="0,0,0,18" Style="{StaticResource Card}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="16" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="14" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal">
                            <Border
                                Width="38"
                                Height="38"
                                Margin="0,0,12,0"
                                Background="{DynamicResource Brush.PrimarySubtle}"
                                CornerRadius="10">
                                <TextBlock
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                    FontSize="18"
                                    Foreground="{DynamicResource Brush.Primary}"
                                    Text="&#xE787;" />
                            </Border>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock
                                    Style="{StaticResource Overview.CardHeading}"
                                    Text="Weekly Summary" />
                                <TextBlock
                                    Style="{StaticResource Text.Secondary}"
                                    Text="A seven-day view of network and router activity" />
                            </StackPanel>
                        </StackPanel>
                        <TextBlock
                            Grid.Column="1"
                            VerticalAlignment="Center"
                            Style="{StaticResource Text.Secondary}"
                            Text="{Binding WeeklySummary.PeriodDisplay}" />
                    </Grid>

                    <TextBlock
                        Grid.Row="2"
                        HorizontalAlignment="Center"
                        Margin="0,18"
                        Text="RouterPilot is still collecting enough history to create a weekly summary.">
                        <TextBlock.Style>
                            <Style
                                TargetType="TextBlock"
                                BasedOn="{StaticResource Text.EmptyStateMessage}">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasWeeklySummaryData}" Value="False">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>

                    <Grid Grid.Row="2">
                        <Grid.Style>
                            <Style TargetType="Grid">
                                <Setter Property="Visibility" Value="Visible" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasWeeklySummaryData}" Value="False">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Grid.Style>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <StackPanel>
                            <TextBlock Style="{StaticResource Text.CardCaption}" Text="AVERAGE DOWNLOAD" />
                            <TextBlock Margin="0,5,0,0" FontSize="17" FontWeight="SemiBold"
                                       Text="{Binding WeeklySummary.AverageDownloadDisplay}" />
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Style="{StaticResource Text.CardCaption}" Text="PEAK DOWNLOAD" />
                            <TextBlock Margin="0,5,0,0" FontSize="17" FontWeight="SemiBold"
                                       Text="{Binding WeeklySummary.PeakDownloadDisplay}" />
                        </StackPanel>
                        <StackPanel Grid.Column="4">
                            <TextBlock Style="{StaticResource Text.CardCaption}" Text="AVERAGE CPU" />
                            <TextBlock Margin="0,5,0,0" FontSize="17" FontWeight="SemiBold"
                                       Text="{Binding WeeklySummary.AverageCpuDisplay}" />
                        </StackPanel>
                        <StackPanel Grid.Column="6">
                            <TextBlock Style="{StaticResource Text.CardCaption}" Text="PEAK MEMORY" />
                            <TextBlock Margin="0,5,0,0" FontSize="17" FontWeight="SemiBold"
                                       Text="{Binding WeeklySummary.PeakMemoryDisplay}" />
                        </StackPanel>
                        <StackPanel Grid.Column="8">
                            <TextBlock Style="{StaticResource Text.CardCaption}" Text="NEW DEVICES" />
                            <TextBlock Margin="0,5,0,0" FontSize="17" FontWeight="SemiBold"
                                       Text="{Binding WeeklySummary.NewDevicesCount, StringFormat={}{0:N0}}" />
                        </StackPanel>
                    </Grid>

                    <ItemsControl
                        Grid.Row="4"
                        ItemsSource="{Binding WeeklySummaryHighlights}">
                        <ItemsControl.Style>
                            <Style TargetType="ItemsControl">
                                <Setter Property="Visibility" Value="Visible" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasWeeklySummaryData}" Value="False">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ItemsControl.Style>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,0,0,9">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="4" />
                                        <ColumnDefinition Width="10" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Border CornerRadius="2">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="{DynamicResource Brush.Primary}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Severity}" Value="Warning">
                                                        <Setter Property="Background" Value="{DynamicResource Brush.Warning}" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Severity}" Value="Critical">
                                                        <Setter Property="Background" Value="{DynamicResource Brush.Danger}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                    </Border>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock FontWeight="SemiBold" Text="{Binding Title}" />
                                        <TextBlock Margin="0,2,0,0"
                                                   Style="{StaticResource Text.Secondary}"
                                                   Text="{Binding Description}" />
                                    </StackPanel>
                                    <TextBlock Grid.Column="3"
                                               Margin="16,0,0,0"
                                               Style="{StaticResource Text.Muted}"
                                               Text="{Binding Category}" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Grid>
            </Border>

            <!-- Main details -->
            <TextBlock
                Margin="0,4,0,12"
                Style="{StaticResource Text.SectionTitle}"
                Text="System details" />

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="16" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Border
                    Grid.Row="0"
                    Grid.Column="0"
                    MinHeight="350"
                    Margin="0,0,8,16"
                    Style="{StaticResource Card}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="20" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Orientation="Horizontal">
                                <Border
                                    Width="38"
                                    Height="38"
                                    Margin="0,0,12,0"
                                    Background="{DynamicResource Brush.PrimarySubtle}"
                                    CornerRadius="10">
                                    <TextBlock
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                        FontSize="18"
                                        Foreground="{StaticResource Brush.Primary}"
                                        Text="&#xE968;" />
                                </Border>
                                <TextBlock
                                    Style="{StaticResource Overview.CardHeading}"
                                    Text="Router" />
                            </StackPanel>

                            <Border
                                Grid.Column="1"
                                Style="{StaticResource Overview.StatusBadge}">
                                <TextBlock
                                    FontSize="11"
                                    FontWeight="SemiBold"
                                    Foreground="{Binding RouterStatusColour}"
                                    Text="{Binding RouterStatusText}" />
                            </Border>
                        </Grid>

                        <StackPanel Grid.Row="2">
                            <Grid Style="{StaticResource Overview.DetailRow}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Style="{StaticResource Overview.DetailLabel}" Text="Model" />
                                <TextBlock Grid.Column="1" Style="{StaticResource Overview.DetailValue}" Text="{Binding RouterModel}" />
                            </Grid>

                            <Grid Style="{StaticResource Overview.DetailRow}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Style="{StaticResource Overview.DetailLabel}" Text="Firmware" />
                                <TextBlock Grid.Column="1" Style="{StaticResource Overview.DetailValue}" Text="{Binding FirmwareVersion}" />
                            </Grid>

                            <Grid Style="{StaticResource Overview.DetailRow}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Style="{StaticResource Overview.DetailLabel}" Text="Hostname" />
                                <TextBlock Grid.Column="1" Style="{StaticResource Overview.DetailValue}" Text="{Binding Hostname}" />
                            </Grid>

                            <Grid Style="{StaticResource Overview.DetailRow}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Style="{StaticResource Overview.DetailLabel}" Text="Uptime" />
                                <TextBlock Grid.Column="1" Style="{StaticResource Overview.DetailValue}" Text="{Binding Uptime}" />
                            </Grid>

                            <Grid Style="{StaticResource Overview.DetailRow}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Style="{StaticResource Overview.DetailLabel}" Text="Temperature" />
                                <TextBlock Grid.Column="1" Style="{StaticResource Overview.DetailValue}" Text="{Binding Temperature}" />
                            </Grid>

                            <Grid Style="{StaticResource Overview.DetailRow}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Style="{StaticResource Overview.DetailLabel}" Text="Load average" />
                                <TextBlock Grid.Column="1" Style="{StaticResource Overview.DetailValue}" Text="{Binding LoadAverage}" />
                            </Grid>

                            <Separator />

                            <StackPanel Margin="0,2,0,14">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Style="{StaticResource Overview.DetailLabel}" Text="CPU usage" />
                                    <TextBlock Grid.Column="1" Style="{StaticResource Overview.DetailValue}" Text="{Binding CpuUsage}" />
                                </Grid>
                                <ProgressBar
                                    Style="{StaticResource Overview.ProgressBar}"
                                    Value="{Binding CpuPercentage}" />
                            </StackPanel>

                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Style="{StaticResource Overview.DetailLabel}" Text="Memory usage" />
                                    <TextBlock Grid.Column="1" Style="{StaticResource Overview.DetailValue}" Text="{Binding MemoryUsage}" />
                                </Grid>
                                <ProgressBar
                                    Style="{StaticResource Overview.ProgressBar}"
                                    Value="{Binding MemoryPercentage}" />

                                <Grid Margin="0,9,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Style="{StaticResource Text.Muted}" Text="Used" />
                                    <TextBlock
                                        Grid.Column="1"
                                        Margin="8,0,18,0"
                                        Style="{StaticResource Overview.DetailValue}"
                                        Text="{Binding MemoryUsed}" />
                                    <TextBlock
                                        Grid.Column="2"
                                        Style="{StaticResource Text.Muted}"
                                        Text="{Binding MemoryCache, StringFormat=Cache: {0}}" />
                                </Grid>
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                </Border>

                <Border
                    Grid.Row="0"
                    Grid.Column="2"
                    MinHeight="350"
                    Margin="8,0,0,16"
                    Style="{StaticResource Card}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="20" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Orientation="Horizontal">
                                <Border
                                    Width="38"
                                    Height="38"
                                    Margin="0,0,12,0"
                                    Background="{DynamicResource Brush.SuccessSubtle}"
                                    CornerRadius="10">
                                    <TextBlock
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                        FontSize="18"
                                        Foreground="{StaticResource Brush.Success}"
                                        Text="&#xE72E;" />
                                </Border>
                                <TextBlock
                                    Style="{StaticResource Overview.CardHeading}"
                                    Text="AdGuard Home" />
                            </StackPanel>

                            <Border
                                Grid.Column="1"
                                Style="{StaticResource Overview.StatusBadge}">
                                <TextBlock
                                    FontSize="11"
                                    FontWeight="SemiBold"
                                    Foreground="{Binding AdGuardStatusColour}"
                                    Text="{Binding AdGuardStatusText}" />
                            </Border>
                        </Grid>

                        <StackPanel Grid.Row="2">
                            <Grid Style="{StaticResource Overview.DetailRow}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Style="{StaticResource Overview.DetailLabel}" Text="Protection" />
                                <TextBlock
                                    Grid.Column="1"
                                    Style="{StaticResource Overview.DetailValue}"
                                    Foreground="{Binding AdGuardProtectionStatusColour}"
                                    Text="{Binding AdGuardProtectionStatusText}" />
                            </Grid>

                            <Grid Style="{StaticResource Overview.DetailRow}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Style="{StaticResource Overview.DetailLabel}" Text="Version" />
                                <TextBlock
                                    Grid.Column="1"
                                    Style="{StaticResource Overview.DetailValue}"
                                    Text="{Binding AdGuardVersion}"
                                    ToolTip="{Binding AdGuardVersion}" />
                            </Grid>

                            <Grid Style="{StaticResource Overview.DetailRow}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Style="{StaticResource Overview.DetailLabel}" Text="Service" />
                                <TextBlock Grid.Column="1" Style="{StaticResource Overview.DetailValue}" Text="{Binding AdGuardService}" />
                            </Grid>

                            <Grid Style="{StaticResource Overview.DetailRow}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Style="{StaticResource Overview.DetailLabel}" Text="Process" />
                                <TextBlock
                                    Grid.Column="1"
                                    Style="{StaticResource Overview.DetailValue}"
                                    Text="{Binding AdGuardProcess}"
                                    ToolTip="{Binding AdGuardProcess}" />
                            </Grid>

                            <Separator />

                            <Grid Style="{StaticResource Overview.DetailRow}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Style="{StaticResource Overview.DetailLabel}" Text="Queries" />
                                <TextBlock Grid.Column="1" Style="{StaticResource Overview.DetailValue}" Text="{Binding AdGuardQueries}" />
                            </Grid>

                            <Grid Style="{StaticResource Overview.DetailRow}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Style="{StaticResource Overview.DetailLabel}" Text="Blocked" />
                                <TextBlock
                                    Grid.Column="1"
                                    Style="{StaticResource Overview.DetailValue}"
                                    Foreground="{StaticResource Brush.Danger}"
                                    Text="{Binding AdGuardBlocked}" />
                            </Grid>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Style="{StaticResource Overview.DetailLabel}" Text="Blocking rate" />
                                <TextBlock Grid.Column="1" Style="{StaticResource Overview.DetailValue}" Text="{Binding AdGuardBlockRate}" />
                            </Grid>
                        </StackPanel>
                    </Grid>
                </Border>

                <Border
                    Grid.Row="2"
                    Grid.Column="0"
                    Grid.ColumnSpan="3"
                    MinHeight="350"
                    Margin="0"
                    Style="{StaticResource Card}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="20" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Orientation="Horizontal">
                                <Border
                                    Width="38"
                                    Height="38"
                                    Margin="0,0,12,0"
                                    Background="{DynamicResource Brush.PrimarySubtle}"
                                    CornerRadius="10">
                                    <TextBlock
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                        FontSize="18"
                                        Foreground="{StaticResource Brush.Primary}"
                                        Text="&#xE774;" />
                                </Border>
                                <TextBlock
                                    Style="{StaticResource Overview.CardHeading}"
                                    Text="Internet" />
                            </StackPanel>

                            <Border
                                Grid.Column="1"
                                Style="{StaticResource Overview.StatusBadge}">
                                <TextBlock
                                    FontSize="11"
                                    FontWeight="SemiBold"
                                    Foreground="{Binding InternetStatusColour}"
                                    Text="{Binding InternetStatusText}" />
                            </Border>
                        </Grid>

                        <StackPanel Grid.Row="2">
                            <Grid Style="{StaticResource Overview.DetailRow}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Style="{StaticResource Overview.DetailLabel}" Text="WAN address" />
                                <TextBlock Grid.Column="1" Style="{StaticResource Overview.DetailValue}" Text="{Binding WanIp}" />
                            </Grid>

                            <Grid Style="{StaticResource Overview.DetailRow}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Style="{StaticResource Overview.DetailLabel}" Text="Gateway" />
                                <TextBlock Grid.Column="1" Style="{StaticResource Overview.DetailValue}" Text="{Binding Gateway}" />
                            </Grid>

                            <Grid Style="{StaticResource Overview.DetailRow}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Style="{StaticResource Overview.DetailLabel}" Text="External DNS" />
                                <TextBlock
                                    Grid.Column="1"
                                    Style="{StaticResource Overview.DetailValue}"
                                    Text="{Binding ExternalDns}"
                                    ToolTip="{Binding ExternalDns}" />
                            </Grid>

                            <Grid Style="{StaticResource Overview.DetailRow}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Style="{StaticResource Overview.DetailLabel}" Text="Advertised DNS" />
                                <TextBlock Grid.Column="1" Style="{StaticResource Overview.DetailValue}" Text="{Binding AdvertisedDns}" />
                            </Grid>

                            <Grid Style="{StaticResource Overview.DetailRow}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Style="{StaticResource Overview.DetailLabel}" Text="Latency" />
                                <TextBlock Grid.Column="1" Style="{StaticResource Overview.DetailValue}" Text="{Binding Latency}" />
                            </Grid>

                            <Separator />

                            <StackPanel Margin="0,2,0,14">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Style="{StaticResource Overview.DetailLabel}" Text="Storage" />
                                    <TextBlock Grid.Column="1" Style="{StaticResource Overview.DetailValue}" Text="{Binding StorageUsage}" />
                                </Grid>
                                <ProgressBar
                                    Style="{StaticResource Overview.ProgressBar}"
                                    Value="{Binding StoragePercentage}" />
                            </StackPanel>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Style="{StaticResource Overview.DetailLabel}" Text="Available storage" />
                                <TextBlock Grid.Column="1" Style="{StaticResource Overview.DetailValue}" Text="{Binding StorageAvailable}" />
                            </Grid>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</UserControl>
