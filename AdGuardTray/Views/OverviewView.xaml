<UserControl x:Class="AdGuardTray.Views.OverviewView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <UserControl.Resources>
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Padding" Value="14"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="BorderBrush" Value="#DDE3EA"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>

        <Style x:Key="HealthCard" TargetType="Border" BasedOn="{StaticResource Card}">
            <Setter Property="Padding" Value="10,9"/>
        </Style>

        <Style x:Key="CardTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="17"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#101828"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style x:Key="StatusBadge" TargetType="Border">
            <Setter Property="Padding" Value="8,3"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Background" Value="#F2F4F7"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="HorizontalAlignment" Value="Right"/>
        </Style>

        <Style x:Key="DetailLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="#667085"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,10,0"/>
        </Style>

        <Style x:Key="DetailValue" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#101828"/>
            <Setter Property="TextAlignment" Value="Right"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style x:Key="DetailRow" TargetType="Grid">
            <Setter Property="Margin" Value="0,0,0,9"/>
        </Style>

        <Style x:Key="CompactProgressBar" TargetType="ProgressBar">
            <Setter Property="Height" Value="7"/>
            <Setter Property="Minimum" Value="0"/>
            <Setter Property="Maximum" Value="100"/>
            <Setter Property="Margin" Value="0,5,0,3"/>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="10"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="10"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock FontSize="24"
                       FontWeight="Bold"
                       Foreground="#101828"
                       Text="Overview"/>
            <TextBlock Margin="0,4,0,0"
                       FontSize="14"
                       Foreground="#667085"
                       Text="Router, AdGuard Home and internet health at a glance"/>
        </StackPanel>

        <UniformGrid Grid.Row="2" Columns="5">
            <Border Margin="0,0,5,0" Style="{StaticResource HealthCard}">
                <StackPanel>
                    <TextBlock FontSize="11" Foreground="#667085" Text="ROUTER"/>
                    <TextBlock Margin="0,3,0,0"
                               FontWeight="SemiBold"
                               Foreground="{Binding RouterStatusColour}"
                               Text="{Binding RouterStatusText}"/>
                </StackPanel>
            </Border>

            <Border Margin="2.5,0" Style="{StaticResource HealthCard}">
                <StackPanel>
                    <TextBlock FontSize="11" Foreground="#667085" Text="ADGUARD"/>
                    <TextBlock Margin="0,3,0,0"
                               FontWeight="SemiBold"
                               Foreground="{Binding AdGuardStatusColour}"
                               Text="{Binding AdGuardStatusText}"/>
                </StackPanel>
            </Border>

            <Border Margin="2.5,0" Style="{StaticResource HealthCard}">
                <StackPanel>
                    <TextBlock FontSize="11" Foreground="#667085" Text="INTERNET"/>
                    <TextBlock Margin="0,3,0,0"
                               FontWeight="SemiBold"
                               Foreground="{Binding InternetStatusColour}"
                               Text="{Binding InternetStatusText}"/>
                </StackPanel>
            </Border>

            <Border Margin="2.5,0" Style="{StaticResource HealthCard}">
                <StackPanel>
                    <TextBlock FontSize="11" Foreground="#667085" Text="CPU"/>
                    <TextBlock Margin="0,3,0,0"
                               FontWeight="SemiBold"
                               Foreground="{Binding CpuHealthColour}"
                               Text="{Binding CpuHealthText}"/>
                </StackPanel>
            </Border>

            <Border Margin="5,0,0,0" Style="{StaticResource HealthCard}">
                <StackPanel>
                    <TextBlock FontSize="11" Foreground="#667085" Text="MEMORY"/>
                    <TextBlock Margin="0,3,0,0"
                               FontWeight="SemiBold"
                               Foreground="{Binding MemoryHealthColour}"
                               Text="{Binding MemoryHealthText}"/>
                </StackPanel>
            </Border>
        </UniformGrid>

        <Grid Grid.Row="4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="10"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="10"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Router -->
            <Border Style="{StaticResource Card}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="14"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Style="{StaticResource CardTitle}" Text="Router"/>

                        <Border Grid.Column="1" Style="{StaticResource StatusBadge}">
                            <TextBlock FontSize="11"
                                       FontWeight="SemiBold"
                                       Foreground="{Binding RouterStatusColour}"
                                       Text="{Binding RouterStatusText}"/>
                        </Border>
                    </Grid>

                    <StackPanel Grid.Row="2">
                        <Grid Style="{StaticResource DetailRow}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Style="{StaticResource DetailLabel}" Text="Model"/>
                            <TextBlock Grid.Column="1" Style="{StaticResource DetailValue}" Text="{Binding RouterModel}"/>
                        </Grid>

                        <Grid Style="{StaticResource DetailRow}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Style="{StaticResource DetailLabel}" Text="Firmware"/>
                            <TextBlock Grid.Column="1" Style="{StaticResource DetailValue}" Text="{Binding FirmwareVersion}"/>
                        </Grid>

                        <Grid Style="{StaticResource DetailRow}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Style="{StaticResource DetailLabel}" Text="Hostname"/>
                            <TextBlock Grid.Column="1" Style="{StaticResource DetailValue}" Text="{Binding Hostname}"/>
                        </Grid>

                        <Grid Style="{StaticResource DetailRow}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Style="{StaticResource DetailLabel}" Text="Uptime"/>
                            <TextBlock Grid.Column="1" Style="{StaticResource DetailValue}" Text="{Binding Uptime}"/>
                        </Grid>

                        <StackPanel Margin="0,4,0,10">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Style="{StaticResource DetailLabel}" Text="CPU usage"/>
                                <TextBlock Grid.Column="1" Style="{StaticResource DetailValue}" Text="{Binding CpuUsage}"/>
                            </Grid>
                            <ProgressBar Style="{StaticResource CompactProgressBar}"
                                         Value="{Binding CpuPercentage}"/>
                        </StackPanel>

                        <StackPanel Margin="0,0,0,0">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Style="{StaticResource DetailLabel}" Text="Memory usage"/>
                                <TextBlock Grid.Column="1" Style="{StaticResource DetailValue}" Text="{Binding MemoryUsage}"/>
                            </Grid>
                            <ProgressBar Style="{StaticResource CompactProgressBar}"
                                         Value="{Binding MemoryPercentage}"/>
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- AdGuard Home -->
            <Border Grid.Column="2" Style="{StaticResource Card}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="14"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Style="{StaticResource CardTitle}" Text="AdGuard Home"/>

                        <Border Grid.Column="1" Style="{StaticResource StatusBadge}">
                            <TextBlock FontSize="11"
                                       FontWeight="SemiBold"
                                       Foreground="{Binding AdGuardStatusColour}"
                                       Text="{Binding AdGuardStatusText}"/>
                        </Border>
                    </Grid>

                    <StackPanel Grid.Row="2">
                        <Grid Style="{StaticResource DetailRow}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Style="{StaticResource DetailLabel}" Text="Protection"/>
                            <TextBlock Grid.Column="1"
                                       Style="{StaticResource DetailValue}"
                                       Foreground="{Binding AdGuardProtectionStatusColour}"
                                       Text="{Binding AdGuardProtectionStatusText}"/>
                        </Grid>

                        <Grid Style="{StaticResource DetailRow}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Style="{StaticResource DetailLabel}" Text="Version"/>
                            <TextBlock Grid.Column="1"
                                       Style="{StaticResource DetailValue}"
                                       ToolTip="{Binding AdGuardVersion}"
                                       Text="{Binding AdGuardVersion}"/>
                        </Grid>

                        <Grid Style="{StaticResource DetailRow}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Style="{StaticResource DetailLabel}" Text="Service"/>
                            <TextBlock Grid.Column="1" Style="{StaticResource DetailValue}" Text="{Binding AdGuardService}"/>
                        </Grid>

                        <Grid Style="{StaticResource DetailRow}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Style="{StaticResource DetailLabel}" Text="Process"/>
                            <TextBlock Grid.Column="1"
                                       Style="{StaticResource DetailValue}"
                                       ToolTip="{Binding AdGuardProcess}"
                                       Text="{Binding AdGuardProcess}"/>
                        </Grid>

                        <Grid Style="{StaticResource DetailRow}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Style="{StaticResource DetailLabel}" Text="Queries"/>
                            <TextBlock Grid.Column="1" Style="{StaticResource DetailValue}" Text="{Binding AdGuardQueries}"/>
                        </Grid>

                        <Grid Style="{StaticResource DetailRow}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Style="{StaticResource DetailLabel}" Text="Blocked"/>
                            <TextBlock Grid.Column="1"
                                       Style="{StaticResource DetailValue}"
                                       Foreground="#C62828"
                                       Text="{Binding AdGuardBlocked}"/>
                        </Grid>

                        <Grid Style="{StaticResource DetailRow}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Style="{StaticResource DetailLabel}" Text="Blocking rate"/>
                            <TextBlock Grid.Column="1" Style="{StaticResource DetailValue}" Text="{Binding AdGuardBlockRate}"/>
                        </Grid>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Internet -->
            <Border Grid.Column="4" Style="{StaticResource Card}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="14"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Style="{StaticResource CardTitle}" Text="Internet"/>

                        <Border Grid.Column="1" Style="{StaticResource StatusBadge}">
                            <TextBlock FontSize="11"
                                       FontWeight="SemiBold"
                                       Foreground="{Binding InternetStatusColour}"
                                       Text="{Binding InternetStatusText}"/>
                        </Border>
                    </Grid>

                    <StackPanel Grid.Row="2">
                        <Grid Style="{StaticResource DetailRow}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Style="{StaticResource DetailLabel}" Text="WAN address"/>
                            <TextBlock Grid.Column="1" Style="{StaticResource DetailValue}" Text="{Binding WanIp}"/>
                        </Grid>

                        <Grid Style="{StaticResource DetailRow}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Style="{StaticResource DetailLabel}" Text="Gateway"/>
                            <TextBlock Grid.Column="1" Style="{StaticResource DetailValue}" Text="{Binding Gateway}"/>
                        </Grid>

                        <Grid Style="{StaticResource DetailRow}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Style="{StaticResource DetailLabel}" Text="External DNS"/>
                            <TextBlock Grid.Column="1"
                                       Style="{StaticResource DetailValue}"
                                       ToolTip="{Binding ExternalDns}"
                                       Text="{Binding ExternalDns}"/>
                        </Grid>

                        <Grid Style="{StaticResource DetailRow}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Style="{StaticResource DetailLabel}" Text="Advertised DNS"/>
                            <TextBlock Grid.Column="1" Style="{StaticResource DetailValue}" Text="{Binding AdvertisedDns}"/>
                        </Grid>

                        <Grid Style="{StaticResource DetailRow}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Style="{StaticResource DetailLabel}" Text="Latency"/>
                            <TextBlock Grid.Column="1" Style="{StaticResource DetailValue}" Text="{Binding Latency}"/>
                        </Grid>

                        <StackPanel Margin="0,4,0,10">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Style="{StaticResource DetailLabel}" Text="Storage"/>
                                <TextBlock Grid.Column="1" Style="{StaticResource DetailValue}" Text="{Binding StorageUsage}"/>
                            </Grid>
                            <ProgressBar Style="{StaticResource CompactProgressBar}"
                                         Value="{Binding StoragePercentage}"/>
                        </StackPanel>

                        <Grid Style="{StaticResource DetailRow}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Style="{StaticResource DetailLabel}" Text="Available storage"/>
                            <TextBlock Grid.Column="1" Style="{StaticResource DetailValue}" Text="{Binding StorageAvailable}"/>
                        </Grid>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
