<Window x:Class="AdGuardTray.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AdGuard Tray Settings"
        Height="360"
        Width="450"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <!-- 0: Router URL Label -->
            <RowDefinition Height="Auto"/>
            <!-- 1: Router URL Input -->
            <RowDefinition Height="Auto"/>
            <!-- 2: Username Label -->
            <RowDefinition Height="Auto"/>
            <!-- 3: Username Input -->
            <RowDefinition Height="Auto"/>
            <!-- 4: Password Label -->
            <RowDefinition Height="Auto"/>
            <!-- 5: Password Input -->
            <RowDefinition Height="*"/>
            <!-- 6: Spacer to push buttons down -->
            <RowDefinition Height="Auto"/>
            <!-- 7: Action Buttons -->
        </Grid.RowDefinitions>

        <!-- Router URL -->
        <TextBlock Grid.Row="0" Text="Router URL"/>
        <TextBox Grid.Row="1"
                 Margin="0,5,0,15"
                 Name="UrlTextBox"
                 Text="{Binding RouterUrl, Mode=TwoWay}"/>

        <!-- Username -->
        <TextBlock Grid.Row="2" Text="Username"/>
        <TextBox Grid.Row="3"
                 Margin="0,5,0,15"
                 Name="UsernameTextBox"
                 Text="{Binding Username, Mode=TwoWay}"/>

        <!-- Password -->
        <TextBlock Grid.Row="4" Text="Password"/>
        <PasswordBox Grid.Row="5"
                     Margin="0,5,0,15"
                     Name="PasswordBox"/>

        <!-- Action Buttons -->
        <StackPanel Grid.Row="7"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right">

            <Button Width="120"
                    Margin="0,0,10,0"
                    Content="Test Connection"
                    Click="TestConnection_Click"/>

            <Button Width="80"
                    Margin="0,0,10,0"
                    Content="Save"
                    Click="Save_Click"/>

            <Button Width="80"
                    Content="Cancel"
                    IsCancel="True"/>
        </StackPanel>

    </Grid>
</Window>