<Window x:Class="AdGuardTray.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AdGuard Tray Settings"
        Height="500"
        Width="450"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen">

    <Grid Margin="20">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock
            Text="Router IP"
            FontWeight="Bold"/>

        <TextBox
            x:Name="RouterIpBox"
            Grid.Row="1"
            Margin="0,5,0,15"
            Height="28"/>

        <TextBlock
            Grid.Row="2"
            Text="Username"
            FontWeight="Bold"/>

        <TextBox
            x:Name="UsernameBox"
            Grid.Row="3"
            Margin="0,5,0,15"
            Height="28"/>

        <TextBlock
            Grid.Row="4"
            Text="Password"
            FontWeight="Bold"/>

        <PasswordBox
            x:Name="PasswordBox"
            Grid.Row="5"
            Margin="0,5,0,15"
            Height="28"/>


        <StackPanel Grid.Row="6">

            <CheckBox
                x:Name="RememberPasswordCheck"
                Margin="0,0,0,10"
                Content="Remember password"
                IsChecked="True"/>

            <CheckBox
                x:Name="StartWithWindowsCheck"
                Margin="0,0,0,15"
                Content="Start with Windows"/>


            <Button
                x:Name="TestAdGuardButton"
                Width="220"
                Height="32"
                HorizontalAlignment="Left"
                Margin="0,0,0,10"
                Content="Test AdGuard Connection"
                Click="TestAdGuardButton_Click"/>


            <Button
                x:Name="GetStatusButton"
                Width="220"
                Height="32"
                HorizontalAlignment="Left"
                Margin="0,0,0,15"
                Content="Get AdGuard Status"
                Click="GetStatusButton_Click"/>


            <TextBlock
                x:Name="StatusText"
                Text="Status: Not tested"
                FontWeight="Bold"/>

        </StackPanel>


        <StackPanel
            Grid.Row="7"
            Orientation="Horizontal"
            HorizontalAlignment="Right">

            <Button
                x:Name="TestButton"
                Width="120"
                Height="32"
                Margin="0,0,10,0"
                Content="Test Connection"/>

            <Button
                x:Name="SaveButton"
                Width="80"
                Height="32"
                Margin="0,0,10,0"
                Content="Save"/>

            <Button
                Width="80"
                Height="32"
                Content="Cancel"
                Click="Cancel_Click"/>

        </StackPanel>

    </Grid>

</Window>