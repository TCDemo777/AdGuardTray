<UserControl x:Class="AdGuardTray.Views.AnalyticsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:lvc="clr-namespace:LiveChartsCore.SkiaSharpView.WPF;assembly=LiveChartsCore.SkiaSharpView.WPF">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="14"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="14"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock FontSize="24"
                       FontWeight="Bold"
                       Text="Analytics"/>
            <TextBlock Margin="0,5,0,0"
                       FontSize="14"
                       Foreground="#667085"
                       Text="AdGuard Home query trends, clients and domains"/>
        </StackPanel>

        <UniformGrid Grid.Row="2" Columns="3">
            <Border Margin="0,0,8,0"
                    MinHeight="112"
                    Padding="16,13"
                    Background="White"
                    CornerRadius="10"
                    BorderBrush="#DDE3EA"
                    BorderThickness="1">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <TextBlock FontSize="13"
                               FontWeight="SemiBold"
                               Foreground="#475467"
                               Text="TOTAL DNS QUERIES"/>
                    <TextBlock Grid.Row="1"
                               Margin="0,5,0,3"
                               VerticalAlignment="Center"
                               FontSize="25"
                               FontWeight="SemiBold"
                               TextTrimming="CharacterEllipsis"
                               Text="{Binding AdGuardQueries}"/>
                    <TextBlock Grid.Row="2"
                               FontSize="12"
                               Foreground="#667085"
                               Text="Requests processed by AdGuard Home"/>
                </Grid>
            </Border>

            <Border Margin="4,0"
                    MinHeight="112"
                    Padding="16,13"
                    Background="White"
                    CornerRadius="10"
                    BorderBrush="#DDE3EA"
                    BorderThickness="1">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <TextBlock FontSize="13"
                               FontWeight="SemiBold"
                               Foreground="#475467"
                               Text="BLOCKED DNS QUERIES"/>
                    <TextBlock Grid.Row="1"
                               Margin="0,5,0,3"
                               VerticalAlignment="Center"
                               FontSize="25"
                               FontWeight="SemiBold"
                               Foreground="#C62828"
                               TextTrimming="CharacterEllipsis"
                               Text="{Binding AdGuardBlocked}"/>
                    <TextBlock Grid.Row="2"
                               FontSize="12"
                               Foreground="#667085"
                               Text="Requests stopped by protection rules"/>
                </Grid>
            </Border>

            <Border Margin="8,0,0,0"
                    MinHeight="112"
                    Padding="16,13"
                    Background="White"
                    CornerRadius="10"
                    BorderBrush="#DDE3EA"
                    BorderThickness="1">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <TextBlock FontSize="13"
                               FontWeight="SemiBold"
                               Foreground="#475467"
                               Text="OVERALL BLOCKING RATE"/>
                    <TextBlock Grid.Row="1"
                               Margin="0,5,0,3"
                               VerticalAlignment="Center"
                               FontSize="25"
                               FontWeight="SemiBold"
                               TextTrimming="CharacterEllipsis"
                               Text="{Binding AdGuardBlockRate}"/>
                    <TextBlock Grid.Row="2"
                               FontSize="12"
                               Foreground="#667085"
                               Text="Share of DNS traffic that was blocked"/>
                </Grid>
            </Border>
        </UniformGrid>

        <Grid Grid.Row="4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.35*"/>
                <ColumnDefinition Width="14"/>
                <ColumnDefinition Width="1.05*"/>
            </Grid.ColumnDefinitions>

            <Border Padding="16"
                    Background="White"
                    BorderBrush="#DDE3EA"
                    BorderThickness="1"
                    CornerRadius="10">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="12"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBlock FontSize="18"
                               FontWeight="Bold"
                               Text="DNS Query History"/>
                    <lvc:CartesianChart Grid.Row="2"
                                        MinHeight="250"
                                        Series="{Binding QueryHistorySeries}"/>
                </Grid>
            </Border>

            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="12"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="12"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Border Padding="14"
                        Background="White"
                        CornerRadius="10"
                        BorderBrush="#DDE3EA"
                        BorderThickness="1">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="8"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <TextBlock FontSize="17"
                                   FontWeight="Bold"
                                   Text="Top Clients"/>
                        <Grid Grid.Row="2">
                            <TextBlock HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       Foreground="#667085"
                                       Text="No client ranking data yet">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding TopClients.Count}" Value="0">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        <ListBox Padding="0"
                                 BorderThickness="0"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                                 ItemsSource="{Binding TopClients}">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,2"
                                          Height="30">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="12"/>
                                            <ColumnDefinition Width="72"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock VerticalAlignment="Center"
                                                   TextTrimming="CharacterEllipsis"
                                                   ToolTip="{Binding Name}"
                                                   Text="{Binding Name}"/>
                                        <Border Grid.Column="2"
                                                MinWidth="52"
                                                Padding="8,3"
                                                HorizontalAlignment="Right"
                                                VerticalAlignment="Center"
                                                Background="#F2F4F7"
                                                CornerRadius="9">
                                            <TextBlock HorizontalAlignment="Center"
                                                       FontWeight="SemiBold"
                                                       Text="{Binding Count,
                                                                      StringFormat={}{0:N0}}"/>
                                        </Border>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        </Grid>
                    </Grid>
                </Border>

                <Border Grid.Row="2"
                        Padding="14"
                        Background="White"
                        CornerRadius="10"
                        BorderBrush="#DDE3EA"
                        BorderThickness="1">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="8"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <TextBlock FontSize="17"
                                   FontWeight="Bold"
                                   Text="Top Requested Domains"/>
                        <Grid Grid.Row="2">
                            <TextBlock HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       Foreground="#667085"
                                       Text="No requested-domain data yet">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding TopQueriedDomains.Count}" Value="0">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        <ListBox Padding="0"
                                 BorderThickness="0"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                                 ItemsSource="{Binding TopQueriedDomains}">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,2"
                                          Height="30">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="12"/>
                                            <ColumnDefinition Width="72"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock VerticalAlignment="Center"
                                                   TextTrimming="CharacterEllipsis"
                                                   ToolTip="{Binding Name}"
                                                   Text="{Binding Name}"/>
                                        <Border Grid.Column="2"
                                                MinWidth="52"
                                                Padding="8,3"
                                                HorizontalAlignment="Right"
                                                VerticalAlignment="Center"
                                                Background="#F2F4F7"
                                                CornerRadius="9">
                                            <TextBlock HorizontalAlignment="Center"
                                                       FontWeight="SemiBold"
                                                       Text="{Binding Count,
                                                                      StringFormat={}{0:N0}}"/>
                                        </Border>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        </Grid>
                    </Grid>
                </Border>

                <Border Grid.Row="4"
                        Padding="14"
                        Background="White"
                        CornerRadius="10"
                        BorderBrush="#DDE3EA"
                        BorderThickness="1">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="8"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <TextBlock FontSize="17"
                                   FontWeight="Bold"
                                   Text="Top Blocked Domains"/>
                        <Grid Grid.Row="2">
                            <TextBlock HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       Foreground="#667085"
                                       Text="No blocked-domain data yet">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding TopBlockedDomains.Count}" Value="0">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        <ListBox Padding="0"
                                 BorderThickness="0"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                                 ItemsSource="{Binding TopBlockedDomains}">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,2"
                                          Height="30">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="12"/>
                                            <ColumnDefinition Width="72"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock VerticalAlignment="Center"
                                                   TextTrimming="CharacterEllipsis"
                                                   ToolTip="{Binding Name}"
                                                   Text="{Binding Name}"/>
                                        <Border Grid.Column="2"
                                                MinWidth="52"
                                                Padding="8,3"
                                                HorizontalAlignment="Right"
                                                VerticalAlignment="Center"
                                                Background="#FDECEC"
                                                CornerRadius="9">
                                            <TextBlock HorizontalAlignment="Center"
                                                       FontWeight="SemiBold"
                                                       Foreground="#C62828"
                                                       Text="{Binding Count,
                                                                      StringFormat={}{0:N0}}"/>
                                        </Border>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        </Grid>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
