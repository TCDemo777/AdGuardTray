<UserControl x:Class="AdGuardTray.Views.AnalyticsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:lvc="clr-namespace:LiveChartsCore.SkiaSharpView.WPF;assembly=LiveChartsCore.SkiaSharpView.WPF">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="14"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="14"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock FontSize="24"
                       FontWeight="Bold"
                       Text="Analytics"/>
            <TextBlock Margin="0,5,0,0"
                       FontSize="14"
                       Foreground="#667085"
                       Text="AdGuard Home query trends, clients and domains"/>
        </StackPanel>

        <UniformGrid Grid.Row="2"
                     Columns="3">
            <Border Margin="0,0,8,0"
                    Padding="16"
                    Background="White"
                    CornerRadius="10"
                    BorderBrush="#DDE3EA"
                    BorderThickness="1">
                <StackPanel>
                    <TextBlock Foreground="#667085"
                               Text="Total queries"/>
                    <TextBlock Margin="0,6,0,0"
                               FontSize="24"
                               FontWeight="Bold"
                               Text="{Binding AdGuardQueries}"/>
                </StackPanel>
            </Border>
            <Border Margin="4,0"
                    Padding="16"
                    Background="White"
                    CornerRadius="10"
                    BorderBrush="#DDE3EA"
                    BorderThickness="1">
                <StackPanel>
                    <TextBlock Foreground="#667085"
                               Text="Blocked queries"/>
                    <TextBlock Margin="0,6,0,0"
                               FontSize="24"
                               FontWeight="Bold"
                               Foreground="#C62828"
                               Text="{Binding AdGuardBlocked}"/>
                </StackPanel>
            </Border>
            <Border Margin="8,0,0,0"
                    Padding="16"
                    Background="White"
                    CornerRadius="10"
                    BorderBrush="#DDE3EA"
                    BorderThickness="1">
                <StackPanel>
                    <TextBlock Foreground="#667085"
                               Text="Blocking rate"/>
                    <TextBlock Margin="0,6,0,0"
                               FontSize="24"
                               FontWeight="Bold"
                               Text="{Binding AdGuardBlockRate}"/>
                </StackPanel>
            </Border>
        </UniformGrid>

        <Grid Grid.Row="4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.45*"/>
                <ColumnDefinition Width="14"/>
                <ColumnDefinition Width="1*"/>
            </Grid.ColumnDefinitions>

            <Border Padding="16"
                    Background="White"
                    BorderBrush="#DDE3EA"
                    BorderThickness="1"
                    CornerRadius="10">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="12"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBlock FontSize="18"
                               FontWeight="Bold"
                               Text="DNS Query History"/>
                    <lvc:CartesianChart Grid.Row="2"
                                        MinHeight="300"
                                        Series="{Binding QueryHistorySeries}"/>
                </Grid>
            </Border>

            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="12"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="12"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Border Padding="14"
                        Background="White"
                        CornerRadius="10"
                        BorderBrush="#DDE3EA"
                        BorderThickness="1">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="8"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <TextBlock FontSize="17"
                                   FontWeight="Bold"
                                   Text="Top Clients"/>
                        <Grid Grid.Row="2">
                            <TextBlock HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       Foreground="#667085"
                                       Text="No client ranking data yet">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding TopClients.Count}" Value="0">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        <ListBox BorderThickness="0"
                                 ItemsSource="{Binding TopClients}">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <DockPanel Margin="0,3">
                                        <TextBlock DockPanel.Dock="Right"
                                                   FontWeight="Bold"
                                                   Text="{Binding Count}"/>
                                        <TextBlock TextTrimming="CharacterEllipsis"
                                                   Text="{Binding Name}"/>
                                    </DockPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        </Grid>
                    </Grid>
                </Border>

                <Border Grid.Row="2"
                        Padding="14"
                        Background="White"
                        CornerRadius="10"
                        BorderBrush="#DDE3EA"
                        BorderThickness="1">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="8"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <TextBlock FontSize="17"
                                   FontWeight="Bold"
                                   Text="Top Requested Domains"/>
                        <Grid Grid.Row="2">
                            <TextBlock HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       Foreground="#667085"
                                       Text="No requested-domain data yet">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding TopQueriedDomains.Count}" Value="0">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        <ListBox BorderThickness="0"
                                 ItemsSource="{Binding TopQueriedDomains}">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <DockPanel Margin="0,3">
                                        <TextBlock DockPanel.Dock="Right"
                                                   FontWeight="Bold"
                                                   Text="{Binding Count}"/>
                                        <TextBlock TextTrimming="CharacterEllipsis"
                                                   Text="{Binding Name}"/>
                                    </DockPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        </Grid>
                    </Grid>
                </Border>

                <Border Grid.Row="4"
                        Padding="14"
                        Background="White"
                        CornerRadius="10"
                        BorderBrush="#DDE3EA"
                        BorderThickness="1">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="8"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <TextBlock FontSize="17"
                                   FontWeight="Bold"
                                   Text="Top Blocked Domains"/>
                        <Grid Grid.Row="2">
                            <TextBlock HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       Foreground="#667085"
                                       Text="No blocked-domain data yet">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding TopBlockedDomains.Count}" Value="0">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        <ListBox BorderThickness="0"
                                 ItemsSource="{Binding TopBlockedDomains}">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <DockPanel Margin="0,3">
                                        <TextBlock DockPanel.Dock="Right"
                                                   FontWeight="Bold"
                                                   Foreground="#C62828"
                                                   Text="{Binding Count}"/>
                                        <TextBlock TextTrimming="CharacterEllipsis"
                                                   Text="{Binding Name}"/>
                                    </DockPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        </Grid>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
