<UserControl x:Class="AdGuardTray.Views.AnalyticsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:lvc="clr-namespace:LiveChartsCore.SkiaSharpView.WPF;assembly=LiveChartsCore.SkiaSharpView.WPF">
    <UserControl.Resources>
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Padding" Value="18"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="BorderBrush" Value="#DDE3EA"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>

        <Style x:Key="RankingList" TargetType="ListBox">
            <Setter Property="Padding" Value="0"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
            <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Disabled"/>
        </Style>

        <Style x:Key="RankingItem" TargetType="ListBoxItem">
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled"
                  CanContentScroll="True">
        <Grid Margin="0,0,10,12">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="14"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="14"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="14"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="14"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <StackPanel>
                <TextBlock FontSize="24" FontWeight="Bold" Text="Analytics"/>
                <TextBlock Margin="0,5,0,0"
                           FontSize="14"
                           Foreground="#667085"
                           Text="AdGuard Home query trends, clients and domain activity"/>
            </StackPanel>

            <UniformGrid Grid.Row="2" Columns="3">
                <Border Margin="0,0,8,0" MinHeight="105" Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock FontSize="12" FontWeight="SemiBold" Foreground="#475467" Text="TOTAL DNS QUERIES"/>
                        <TextBlock Margin="0,7,0,3" FontSize="26" FontWeight="SemiBold" Text="{Binding AdGuardQueries}"/>
                        <TextBlock FontSize="12" Foreground="#667085" Text="All requests processed by AdGuard Home"/>
                    </StackPanel>
                </Border>
                <Border Margin="4,0" MinHeight="105" Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock FontSize="12" FontWeight="SemiBold" Foreground="#475467" Text="BLOCKED DNS QUERIES"/>
                        <TextBlock Margin="0,7,0,3" FontSize="26" FontWeight="SemiBold" Foreground="#C62828" Text="{Binding AdGuardBlocked}"/>
                        <TextBlock FontSize="12" Foreground="#667085" Text="Requests stopped by protection rules"/>
                    </StackPanel>
                </Border>
                <Border Margin="8,0,0,0" MinHeight="105" Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock FontSize="12" FontWeight="SemiBold" Foreground="#475467" Text="OVERALL BLOCKING RATE"/>
                        <TextBlock Margin="0,7,0,3" FontSize="26" FontWeight="SemiBold" Text="{Binding AdGuardBlockRate}"/>
                        <TextBlock FontSize="12" Foreground="#667085" Text="Percentage of DNS traffic blocked"/>
                    </StackPanel>
                </Border>
            </UniformGrid>

            <Border Grid.Row="4" MinHeight="300" Style="{StaticResource Card}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="10"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock FontSize="18" FontWeight="Bold" Text="DNS Query History"/>
                            <TextBlock Margin="0,3,0,0" FontSize="12" Foreground="#667085"
                                       Text="Recent request volume reported by AdGuard Home"/>
                        </StackPanel>
                        <Border Grid.Column="1" Padding="9,4" Background="#F2F4F7" CornerRadius="10" VerticalAlignment="Center">
                            <TextBlock FontSize="11" FontWeight="SemiBold" Foreground="#475467" Text="LIVE STATISTICS"/>
                        </Border>
                    </Grid>
                    <lvc:CartesianChart Grid.Row="2" MinHeight="215" Series="{Binding QueryHistorySeries}"/>
                </Grid>
            </Border>

            <Grid Grid.Row="6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="14"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border Style="{StaticResource Card}" MinHeight="410">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="12"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <StackPanel>
                            <DockPanel LastChildFill="True">
                                <Border DockPanel.Dock="Right" Padding="8,3" Background="#EEF4FF" CornerRadius="9">
                                    <TextBlock FontSize="11" FontWeight="SemiBold" Foreground="#175CD3" Text="TOP 5"/>
                                </Border>
                                <TextBlock FontSize="18" FontWeight="Bold" Text="Top clients"/>
                            </DockPanel>
                            <TextBlock Margin="0,3,0,0" FontSize="12" Foreground="#667085"
                                       Text="Devices generating the most DNS requests"/>
                        </StackPanel>

                        <Grid Grid.Row="2">
                            <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#667085" Text="No client ranking data yet">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding TopClients.Count}" Value="0">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>

                            <ListBox Style="{StaticResource RankingList}"
                                     ItemContainerStyle="{StaticResource RankingItem}"
                                     ItemsSource="{Binding TopClients}">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,0,0,13" ToolTip="{Binding Name}">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="7"/>
                                                <RowDefinition Height="12"/>
                                            </Grid.RowDefinitions>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="32"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <Border Width="24" Height="24" Background="#E8EEF5" CornerRadius="12" VerticalAlignment="Center">
                                                    <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="11" FontWeight="Bold" Foreground="#175CD3" Text="{Binding Rank}"/>
                                                </Border>
                                                <StackPanel Grid.Column="1" Margin="0,0,10,0">
                                                    <TextBlock FontWeight="SemiBold" TextTrimming="CharacterEllipsis" Text="{Binding DisplayName}"/>
                                                    <TextBlock Margin="0,1,0,0" FontSize="11" Foreground="#667085" TextTrimming="CharacterEllipsis" Text="{Binding Address}"/>
                                                </StackPanel>
                                                <TextBlock Grid.Column="2" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="#175CD3" Text="{Binding Count, StringFormat={}{0:N0}}"/>
                                            </Grid>
                                            <Grid Grid.Row="2">
                                                <Border Background="#EAF0F8" CornerRadius="6"/>
                                                <ProgressBar Height="12"
                                                             Maximum="100"
                                                             Value="{Binding RelativePercent}"
                                                             Foreground="#3F7DD9"
                                                             Background="Transparent"
                                                             BorderThickness="0"/>
                                            </Grid>
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Grid>
                    </Grid>
                </Border>

                <Border Grid.Column="2" Style="{StaticResource Card}" MinHeight="410">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="12"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <StackPanel>
                            <DockPanel LastChildFill="True">
                                <Border DockPanel.Dock="Right" Padding="8,3" Background="#FDECEC" CornerRadius="9">
                                    <TextBlock FontSize="11" FontWeight="SemiBold" Foreground="#C62828" Text="TOP 5"/>
                                </Border>
                                <TextBlock FontSize="18" FontWeight="Bold" Text="Top blocked domains"/>
                            </DockPanel>
                            <TextBlock Margin="0,3,0,0" FontSize="12" Foreground="#667085"
                                       Text="Domains stopped most often by protection rules"/>
                        </StackPanel>

                        <Grid Grid.Row="2">
                            <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#667085" Text="No blocked-domain data yet">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding TopBlockedDomains.Count}" Value="0">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>

                            <ListBox Style="{StaticResource RankingList}"
                                     ItemContainerStyle="{StaticResource RankingItem}"
                                     ItemsSource="{Binding TopBlockedDomains}">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,0,0,13" ToolTip="{Binding Name}">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="7"/>
                                                <RowDefinition Height="12"/>
                                            </Grid.RowDefinitions>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="32"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <Border Width="24" Height="24" Background="#FDECEC" CornerRadius="12" VerticalAlignment="Center">
                                                    <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="11" FontWeight="Bold" Foreground="#C62828" Text="{Binding Rank}"/>
                                                </Border>
                                                <TextBlock Grid.Column="1" Margin="0,0,10,0" VerticalAlignment="Center" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" Text="{Binding Name}"/>
                                                <TextBlock Grid.Column="2" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="#C62828" Text="{Binding Count, StringFormat={}{0:N0}}"/>
                                            </Grid>
                                            <Grid Grid.Row="2">
                                                <Border Background="#FBEAEA" CornerRadius="6"/>
                                                <ProgressBar Height="12"
                                                             Maximum="100"
                                                             Value="{Binding RelativePercent}"
                                                             Foreground="#E13227"
                                                             Background="Transparent"
                                                             BorderThickness="0"/>
                                            </Grid>
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Grid>
                    </Grid>
                </Border>
            </Grid>

            <Border Grid.Row="8" Style="{StaticResource Card}" MinHeight="300">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="12"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <StackPanel>
                        <DockPanel LastChildFill="True">
                            <Border DockPanel.Dock="Right" Padding="8,3" Background="#ECFDF3" CornerRadius="9">
                                <TextBlock FontSize="11" FontWeight="SemiBold" Foreground="#16803C" Text="TOP 5"/>
                            </Border>
                            <TextBlock FontSize="18" FontWeight="Bold" Text="Top requested domains"/>
                        </DockPanel>
                        <TextBlock Margin="0,3,0,0" FontSize="12" Foreground="#667085"
                                   Text="Most frequently requested destinations"/>
                    </StackPanel>

                    <Grid Grid.Row="2">
                        <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#667085" Text="No requested-domain data yet">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding TopQueriedDomains.Count}" Value="0">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>

                        <ListBox Style="{StaticResource RankingList}"
                                 ItemContainerStyle="{StaticResource RankingItem}"
                                 ItemsSource="{Binding TopQueriedDomains}">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,0,0,12" ToolTip="{Binding Name}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="38"/>
                                            <ColumnDefinition Width="260"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="72"/>
                                        </Grid.ColumnDefinitions>
                                        <Border Width="26" Height="26" Background="#E7F6EC" CornerRadius="13" VerticalAlignment="Center">
                                            <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="11" FontWeight="Bold" Foreground="#16803C" Text="{Binding Rank}"/>
                                        </Border>
                                        <TextBlock Grid.Column="1" Margin="0,0,14,0" VerticalAlignment="Center" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" Text="{Binding Name}"/>
                                        <Grid Grid.Column="2" Margin="0,0,14,0" VerticalAlignment="Center" Height="12">
                                            <Border Background="#E7F6EC" CornerRadius="6"/>
                                            <ProgressBar Height="12"
                                                         Maximum="100"
                                                         Value="{Binding RelativePercent}"
                                                         Foreground="#2F9E5B"
                                                         Background="Transparent"
                                                         BorderThickness="0"/>
                                        </Grid>
                                        <TextBlock Grid.Column="3" VerticalAlignment="Center" HorizontalAlignment="Right" FontWeight="SemiBold" Foreground="#16803C" Text="{Binding Count, StringFormat={}{0:N0}}"/>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Grid>
                </Grid>
            </Border>
        </Grid>
    </ScrollViewer>
</UserControl>
