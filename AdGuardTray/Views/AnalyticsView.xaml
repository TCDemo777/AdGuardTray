<UserControl x:Class="AdGuardTray.Views.AnalyticsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid>

        <StackPanel>

            <TextBlock
                FontSize="24"
                FontWeight="Bold"
                Text="Analytics"/>

            <TextBlock
                Margin="0,5,0,20"
                FontSize="14"
                Foreground="#666666"
                Text="Historical statistics and graphs"/>

            <Border
                Padding="30"
                Background="White"
                BorderBrush="#DDDDDD"
                BorderThickness="1"
                CornerRadius="10">

                <StackPanel HorizontalAlignment="Center">

                    <TextBlock
                        FontSize="22"
                        FontWeight="SemiBold"
                        Text="Analytics"/>

                    <TextBlock
                        Margin="0,10,0,0"
                        FontSize="15"
                        Foreground="Gray"
                        Text="DNS charts and historical statistics will appear here."/>

                </StackPanel>

            </Border>

        </StackPanel>

    </Grid>

</UserControl>